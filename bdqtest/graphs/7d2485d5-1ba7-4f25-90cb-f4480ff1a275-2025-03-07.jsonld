      {
        "@value": "Specification for: VALIDATION_DECIMALLATITUDE_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:decimalLatitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:NotEmpty\""
      },
      {
        "@value": "dwc:decimalLatitude=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:Empty\""
      }
    ],
