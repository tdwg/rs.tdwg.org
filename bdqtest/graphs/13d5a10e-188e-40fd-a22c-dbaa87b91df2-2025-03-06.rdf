  <rdf:Description rdf:about="urn:uuid:8c10d361-5bf7-4c9d-8464-c813cdf7dda3">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:dataGeneralizations</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:dataGeneralizations</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/dataGeneralizations"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/13d5a10e-188e-40fd-a22c-dbaa87b91df2-2025-03-06">
    <dcterms:description>Is there a value in dwc:dataGeneralizations?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/13d5a10e-188e-40fd-a22c-dbaa87b91df2"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-06</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.15468/doc-5jp4-5g10"/>
    <dcterms:references rdf:resource="https://doi.org/10.15468/doc-gg7h-s853"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Issue"/>
    <rdfs:label>ISSUE_DATAGENERALIZATIONS_NOTEMPTY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/72</skos:historyNote>
    <skos:note>This is not specific to spatial data, any value in the dwc:dataGeneralizations field will cause this flag to be raised, but the primary Use Case is expected to be that dwc:dataGeneralizations demonstrates obfuscated locations.</skos:note>
    <skos:prefLabel>Issue dwc:dataGeneralizations Not Empty for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:8c10d361-5bf7-4c9d-8464-c813cdf7dda3"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/NotEmpty"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Resolution"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://doi.org/10.15468/doc-gg7h-s853">
    <dcterms:bibliographicCitation>Chapman AD and Wieczorek JR (2020) Georeferencing Best Practices. Copenhagen: GBIF Secretariat. https://doi.org/10.15468/doc-gg7h-s853</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:62aa9551-8412-4ee9-a58d-dd6baea1dc35">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/IssuePolicy"/>
    <rdfs:label>IssuePolicy: (1) issues  in UseCase bdquc:SDM-Trees</rdfs:label>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/SDM-Trees"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/13d5a10e-188e-40fd-a22c-dbaa87b91df2-2025-03-06"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:5daad04c-fd7c-4972-ac3a-66f149170bf3">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/IssueMethod"/>
    <rdfs:label>IssueMethod: ISSUE_DATAGENERALIZATIONS_NOTEMPTY with Specification Specification for: ISSUE_DATAGENERALIZATIONS_NOTEMPTY</rdfs:label>
    <skos:historyNote>Source: ALA</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/d742991440f2f5fc6ffc75dfe3b6d2ab5b6826b2/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L138</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)</skos:note>
    <skos:note>TG2 Issue NAME SPACE TIME CODED Test Resolution CORE</skos:note>
    <skos:prefLabel>IssueMethod: ISSUE_DATAGENERALIZATIONS_NOTEMPTY with Specification Specification for: ISSUE_DATAGENERALIZATIONS_NOTEMPTY</skos:prefLabel>
    <bdqffdq:forIssue rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/13d5a10e-188e-40fd-a22c-dbaa87b91df2-2025-03-06"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:90618419-452d-4f35-b39a-7c342ca0791b"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:90618419-452d-4f35-b39a-7c342ca0791b">
    <dcterms:description>POTENTIAL_ISSUE if dwc:dataGeneralizations is bdqval:NotEmpty; otherwise NOT_ISSUE</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: ISSUE_DATAGENERALIZATIONS_NOTEMPTY</rdfs:label>
    <skos:example>dwc:dataGeneralizations="": Response.status=RUN_HAS_RESULT, Response.result=NOT_ISSUE, Response.comment="dwc:dataGeneralizations is bdqval:Empty"</skos:example>
    <skos:example>dwc:dataGeneralizations="placed on quarter degree grid": Response.status=RUN_HAS_RESULT, Response.result=POTENTIAL_ISSUE, Response.comment="dwc:dataGeneralizations is bdqval:NotEmpty"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>POTENTIAL_ISSUE if dwc:dataGeneralizations is bdqval:NotEmpty; otherwise NOT_ISSUE</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="https://doi.org/10.15468/doc-5jp4-5g10">
