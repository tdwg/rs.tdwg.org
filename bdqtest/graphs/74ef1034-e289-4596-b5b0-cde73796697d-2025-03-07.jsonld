  {
    "@id": "https://rs.tdwg.org/bdqval/terms/sourceAuthority",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Parameter"
    ]
  },
  {
    "@id": "urn:uuid:ba1fa532-9612-4944-bfd1-8bd39ab47758",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_DEGREEOFESTABLISHMENT_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:degreeOfEstablishment=\"capt.\": Response.status=AMENDED, Response.result=dwc:degreeOfEstablishment=\"captive\", Response.comment=\"dwc:degreeOfEstablishment contains an interpretable value in the bdqval:sourceAuthority\""
      },
      {
        "@value": "dwc:degreeOfEstablishment=\"tree\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:degreeOfEstablishment does not contain an interpretable value in the bdqval:sourceAuthority\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:ff9e9459-d1a5-43a6-ada9-8be41772b711"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED"
      }
    ]
  },
