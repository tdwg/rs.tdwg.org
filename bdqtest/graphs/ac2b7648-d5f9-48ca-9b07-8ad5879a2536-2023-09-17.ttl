<urn:uuid:5aabe3d4-d2c0-415c-8972-c834b543971a> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_BASISOFRECORD_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:basisOfRecord is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:basisOfRecord=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:basisOfRecord is bdqval:Empty\"",
        "dwc:basisOfRecord=\"PreservedSpecimen\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:basisOfRecord is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:basisOfRecord is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

