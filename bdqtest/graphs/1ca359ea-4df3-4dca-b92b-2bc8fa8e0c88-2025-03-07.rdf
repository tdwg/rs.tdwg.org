  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/1ca359ea-4df3-4dca-b92b-2bc8fa8e0c88-2025-03-07">
    <dcterms:description>Measure if all VALIDATION_TYPESTATUS_STANDARD in a record set are COMPLIANT.</dcterms:description>
