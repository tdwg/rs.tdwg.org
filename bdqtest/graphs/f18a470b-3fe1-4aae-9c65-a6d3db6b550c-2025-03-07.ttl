<https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Natural Earth (2022) Admin 1 – States, provinces. v5.1.1 2022-05-12. https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/" .

<urn:uuid:4dd617df-a984-419f-b7b5-098b2023c4ab> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COORDINATESSTATEPROVINCE_CONSISTENT" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the values of dwc:decimalLatitude or dwc:decimalLongitude are bdqval:Empty or invalid, or dwc:stateProvince is bdqval:Empty or not found in the bdqval:sourceAuthority; COMPLIANT if the geographic coordinates fall on or within the boundary in the bdqval:sourceAuthority for the given dwc:stateProvince (after coordinate reference system transformations, if any, have been accounted for), or within the distance given by bdqval:spatialBufferInMeters outside that boundary; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"10m-admin-1 boundaries\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/]},bdqval:spatialBufferInMeters default = \"3000\"" ;
    skos:example "dwc:stateProvince=\"Córdoba\", dwc:decimalLatitude=\"-41.0525925872862\", dwc:decimalLongitude=\"-71.5310546742521\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"Input fields contain interpretable values but coordinates don't match dwc:stateProvince with buffer\"",
        "dwc:stateProvince=\"Tasmania\", dwc:decimalLatitude=\"-42.85\", dwc:decimalLongitude=\"146.75\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"Input fields contain interpretable values\"" ;
    bdqffdq:hasArgument <urn:uuid:b7c56646-56f1-4094-b2be-8546c7e18102>,
        <urn:uuid:cceaf335-6cd3-44a0-9562-6fe8e7743854> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"10m-admin-1 boundaries\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/]},bdqval:spatialBufferInMeters default = \"3000\"" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the values of dwc:decimalLatitude or dwc:decimalLongitude are bdqval:Empty or invalid, or dwc:stateProvince is bdqval:Empty or not found in the bdqval:sourceAuthority; COMPLIANT if the geographic coordinates fall on or within the boundary in the bdqval:sourceAuthority for the given dwc:stateProvince (after coordinate reference system transformations, if any, have been accounted for), or within the distance given by bdqval:spatialBufferInMeters outside that boundary; otherwise NOT_COMPLIANT." .

<urn:uuid:b7c56646-56f1-4094-b2be-8546c7e18102> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"10m-admin-1 boundaries\"" ;
    bdqffdq:hasArgumentValue "10m-admin-1 boundaries" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:cceaf335-6cd3-44a0-9562-6fe8e7743854> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:spatialBufferInMeters:\"3000\"" ;
    bdqffdq:hasArgumentValue "3000" ;
    bdqffdq:hasParameter bdqval:spatialBufferInMeters .

<urn:uuid:de507979-dc94-4cb9-9c87-9d33972f4a4e> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:stateProvince, dwc:decimalLatitude, dwc:decimalLongitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:stateProvince, dwc:decimalLatitude, dwc:decimalLongitude" ;
    bdqffdq:composedOf dwc:decimalLatitude,
        dwc:decimalLongitude,
        dwc:stateProvince .

<https://rs.tdwg.org/bdqtest/terms/version/f18a470b-3fe1-4aae-9c65-a6d3db6b550c-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COORDINATESSTATEPROVINCE_CONSISTENT" ;
    dcterms:description "Do the geographic coordinates fall on or within the boundary from the bdqval:sourceAuthority for the given dwc:stateProvince or within the distance given by bdqval:spatialBufferInMeters outside that boundary?" ;
    dcterms:isVersionOf bdqtest:f18a470b-3fe1-4aae-9c65-a6d3db6b550c ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <http://www.fao.org/3/a0118e/a0118e00.htm#Contents>,
        <https://developers.google.com/maps/documentation/javascript/examples/geocoding-reverse>,
        <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://github.com/nvkelso/natural-earth-vector/releases/tag/v5.1.2>,
        <https://technicalgeography.org/pdf/sp_i_2010/12_introducing_natural_earth_data__naturaleart.pdf>,
        <https://www.arcgis.com/home/item.html?id=f0ceb8af000a4ffbae75d742538c548b>,
        <https://www.geonames.org/>,
        <https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/56" ;
    skos:note "The geographic determination service is expected to return a list of names of first-level administrative divisions for geometries that the geographic point falls on or within, including a 3 km buffer around the administrative geometry. A match on any of those names should constitute a consistency, and dwc:countryCode should not be needed to make this determination, that is, this Test does not attempt to disambiguate potential duplicate first-level administrative division names. The level of buffering may be related to the scale of the underlying GIS layer being used. At a global scale, typical map scales used for borders and coastal areas are either 1:3M or 1:1M (Dooley 2005, Chapter 4). Horizontal accuracy at those scales is around 1.5-2.5km and 0.5-0.85 km respectively (Chapman & Wieczorek 2020)." ;
    skos:prefLabel "Validation Coordinates dwc:stateProvince Consistent for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:de507979-dc94-4cb9-9c87-9d33972f4a4e> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Consistency ;
    bdqffdq:hasDateLastUpdated "2024-08-30"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

