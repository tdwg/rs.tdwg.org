    "http://purl.org/dc/terms/description": [
      {
        "@value": "POTENTIAL_ISSUE if dwc:dataGeneralizations is bdqval:NotEmpty; otherwise NOT_ISSUE"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: ISSUE_DATAGENERALIZATIONS_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:dataGeneralizations=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_ISSUE, Response.comment=\"dwc:dataGeneralizations is bdqval:Empty\""
      },
      {
        "@value": "dwc:dataGeneralizations=\"placed on quarter degree grid\": Response.status=RUN_HAS_RESULT, Response.result=POTENTIAL_ISSUE, Response.comment=\"dwc:dataGeneralizations is bdqval:NotEmpty\""
      }
    ],
