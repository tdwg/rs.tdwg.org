    bdqffdq:includedInPolicy <https://rs.tdwg.org/bdqtest/terms/version/7bdb13a4-8a51-4ee5-be7f-20693fdb183e-2023-09-18> .

<urn:uuid:e95df0f4-b6b6-4e04-ad00-95eef6e8d993> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_TAXONRANK_STANDARD with Specification for: VALIDATION_TAXONRANK_STANDARD" ;
    skos:historyNote "Source: TDWG2018" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L2161",
        "Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris & Dou 2025)",
        "TG2 Validation NAME CODED Test VOCABULARY Conformance Parameterized CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_TAXONRANK_STANDARD with Specification for: VALIDATION_TAXONRANK_STANDARD" ;
