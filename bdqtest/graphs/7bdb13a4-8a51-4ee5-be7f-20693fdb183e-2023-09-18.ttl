    bdqffdq:hasSpecification <urn:uuid:c8964200-630e-47c6-baad-7e334fddbbdb> .

<https://registry.gbif.org/vocabulary/TaxonRank/concepts> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "GBIF Registry (2023) GBIF Vocabulary: Taxonomic Rank. https://registry.gbif.org/vocabulary/TaxonRank/concepts" .

bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Taxon-Management a bdqffdq:UseCase ;
    rdfs:label "bdquc:Taxon-Management" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:72421b97-1e66-4429-88d8-cbe647a4c88e> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:taxonRank" ;
    skos:prefLabel "Information Element ActedUpon dwc:taxonRank" ;
    bdqffdq:composedOf dwc:taxonRank .

<urn:uuid:c8964200-630e-47c6-baad-7e334fddbbdb> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_TAXONRANK_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:taxonRank is bdqval:Empty; COMPLIANT if the value of dwc:taxonRank is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"GBIF TaxonRank Vocabulary\" [https://api.gbif.org/v1/vocabularies/TaxonRank]} {\"dwc:taxonRank vocabulary API\" [https://api.gbif.org/v1/vocabularies/TaxonRank/concepts]}" ;
    skos:example "dwc:taxonRank=\"kingdom\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:taxonRank has an equivalent in the bdqval:sourceAuthority\"",
        "dwc:taxonRank=\"sp.\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:taxonRank does not have an equivalent in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:da536dda-d467-450e-8b0a-6b6903fd1a1b> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF TaxonRank Vocabulary\" [https://api.gbif.org/v1/vocabularies/TaxonRank]} {\"dwc:taxonRank vocabulary API\" [https://api.gbif.org/v1/vocabularies/TaxonRank/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:taxonRank is bdqval:Empty; COMPLIANT if the value of dwc:taxonRank is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<urn:uuid:da536dda-d467-450e-8b0a-6b6903fd1a1b> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF TaxonRank Vocabulary\"" ;
    bdqffdq:hasArgumentValue "GBIF TaxonRank Vocabulary" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<https://rs.tdwg.org/bdqtest/terms/version/7bdb13a4-8a51-4ee5-be7f-20693fdb183e-2023-09-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_TAXONRANK_STANDARD" ;
    dcterms:description "Does the value of dwc:taxonRank occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:7bdb13a4-8a51-4ee5-be7f-20693fdb183e ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    dcterms:references <https://registry.gbif.org/vocabulary/TaxonRank/concepts> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/162" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:taxonRank Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:72421b97-1e66-4429-88d8-cbe647a4c88e> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

