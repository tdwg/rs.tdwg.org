<urn:uuid:9c87ce41-04a3-45e6-83d3-95ec70ae553f> a bdqffdq:ValidationPolicy ;
    rdfs:label "ValidationPolicy: (16) validations  in UseCase bdquc:Taxon-Management" ;
    skos:prefLabel "ValidationPolicy: (16) validations  in UseCase bdquc:Taxon-Management" ;
