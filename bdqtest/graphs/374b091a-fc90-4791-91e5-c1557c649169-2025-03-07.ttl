<urn:uuid:e1286c46-2a95-480d-89e4-f02681372eb7> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DCTYPE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dc:type is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dc:type=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dc:type is bdqval:Empty\"",
        "dc:type=\"?\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dc:type is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dc:type is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

