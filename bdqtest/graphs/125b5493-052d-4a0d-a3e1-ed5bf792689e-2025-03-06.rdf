  <rdf:Description rdf:about="urn:uuid:7072bf93-bffc-4d83-ad51-b351c6e53260">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_KINGDOM_FOUND with Specification for: VALIDATION_KINGDOM_FOUND</rdfs:label>
    <skos:historyNote>Source: GBIF</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L1386</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris &amp; Dou 2025)</skos:note>
    <skos:note>TG2 Validation NAME CODED Test VOCABULARY Conformance Parameterized CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_KINGDOM_FOUND with Specification for: VALIDATION_KINGDOM_FOUND</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/125b5493-052d-4a0d-a3e1-ed5bf792689e-2025-03-06"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:a90e100a-3522-4742-aa73-3b98a35ab826"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:b856f48c-bf6f-4637-b8de-37d379831801">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:kingdom</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:kingdom</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/kingdom"/>
  </rdf:Description>
