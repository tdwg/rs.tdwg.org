      },
      {
        "@value": "TG2 Amendment TIME CODED Test Conformance ISO/DCMI STANDARD CORE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "AmendmentMethod: AMENDMENT_DATEIDENTIFIED_STANDARDIZED with Specification Specification for: AMENDMENT_DATEIDENTIFIED_STANDARDIZED"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/forAmendment": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/39bb2280-1215-447b-9221-fd13bc990641-2024-09-16"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasSpecification": [
      {
        "@id": "urn:uuid:16e40618-e9bd-479a-b1e8-8aee3467109f"
      }
    ]
  },
  {
    "@id": "urn:uuid:16e40618-e9bd-479a-b1e8-8aee3467109f",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; AMENDED if the value of dwc:dateIdentified is not a properly formatted ISO 8601 date but is unambiguous and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_DATEIDENTIFIED_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:dateIdentified=\"2021-28-10\": Response.status=AMENDED, Response.result=dwc:dateIdentified=\"2021-10-28\", Response.comment=\"dwc:dateIdentified assuming dwc:year, dwc:day and dwc:month\""
      },
      {
        "@value": "dwc:dateIdentified=\"21-10-28\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:dateIdentified contains ambiguous values. It could be dd-mm-yy or yy-mm-dd\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; AMENDED if the value of dwc:dateIdentified is not a properly formatted ISO 8601 date but is unambiguous and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED."
      }
    ]
  },
