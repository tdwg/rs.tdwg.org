<urn:uuid:3d9e1339-19d7-47e7-af9e-11905df82b6a> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_OCCURRENCEID_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:occurrenceID is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:occurrenceID=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:occurrenceID is bdqval:Empty\"",
        "dwc:occurrenceID=\"https://www.inaturalist.org/observations/43047701\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:occurrenceID conforms to GUID structure\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:occurrenceID is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

