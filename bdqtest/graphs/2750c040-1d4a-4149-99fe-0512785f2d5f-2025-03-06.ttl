<urn:uuid:b751c2ed-11a5-4bff-9c37-1eccc8138191> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_CLASSIFICATION_CONSISTENT with Specification for: VALIDATION_CLASSIFICATION_CONSISTENT" ;
    skos:historyNote "Source: TG2-Gainesville" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L2563",
        "Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris & Dou 2025)",
        "TG2 Validation NAME CODED Test VOCABULARY Consistency Parameterized CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_CLASSIFICATION_CONSISTENT with Specification for: VALIDATION_CLASSIFICATION_CONSISTENT" ;
