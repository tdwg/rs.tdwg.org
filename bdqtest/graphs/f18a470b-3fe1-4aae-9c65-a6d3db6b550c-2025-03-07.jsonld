    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Do the geographic coordinates fall on or within the boundary from the bdqval:sourceAuthority for the given dwc:stateProvince or within the distance given by bdqval:spatialBufferInMeters outside that boundary?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
