<urn:uuid:4343a7e0-7f0b-434d-99d4-e939ecb16e1f> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COORDINATESCOUNTRYCODE_CONSISTENT" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if one or more of dwc:decimalLatitude, dwc:decimalLongitude, or dwc:countryCode are bdqval:Empty or invalid; COMPLIANT if the geographic coordinates fall on or within the boundary defined by the union of the boundary of the country from dwc:countryCode plus it's Exclusive Economic Zone as found in the bdqval:sourceAuthority, if any, plus an exterior buffer given by bdqval:spatialBufferInMeters; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]},bdqval:spatialBufferInMeters default = \"3000\"" ;
    skos:example "dwc:countryCode=\"AR\", dwc:decimalLatitude=\"-41.0525925872862\", dwc:decimalLongitude=\"-71.5310546742521\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"Coordinates match dwc:countryCode\"",
        "dwc:countryCode=\"CL\", dwc:decimalLatitude=\"-41.0525925872862\", dwc:decimalLongitude=\"-71.5310546742521\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"Coordinates are in Argentina, not Chile\"",
        "dwc:countryCode=\"ZX\", dwc:decimalLatitude=\"-41.0525925872862\", dwc:decimalLongitude=\"-71.5310546742521\": Response.status=INTERNAL_PREREQUISITES_NOT_MET, Response.comment=\"Input field contains invalid values - ZX is not a valid ISO 3166-1-alpha-2 country code\"" ;
    bdqffdq:hasArgument <urn:uuid:8a3f5702-a4e5-4b21-acb6-a4eae9a1ae09>,
        <urn:uuid:972320cd-3ba3-4076-a8eb-f797095509cd> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]},bdqval:spatialBufferInMeters default = \"3000\"" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if one or more of dwc:decimalLatitude, dwc:decimalLongitude, or dwc:countryCode are bdqval:Empty or invalid; COMPLIANT if the geographic coordinates fall on or within the boundary defined by the union of the boundary of the country from dwc:countryCode plus it's Exclusive Economic Zone as found in the bdqval:sourceAuthority, if any, plus an exterior buffer given by bdqval:spatialBufferInMeters; otherwise NOT_COMPLIANT" .

<urn:uuid:6f6a46c6-9979-41a2-83c2-fd196e89c8c1> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:countryCode, dwc:decimalLatitude, dwc:decimalLongitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:countryCode, dwc:decimalLatitude, dwc:decimalLongitude" ;
    bdqffdq:composedOf dwc:countryCode,
        dwc:decimalLatitude,
        dwc:decimalLongitude .

<urn:uuid:8a3f5702-a4e5-4b21-acb6-a4eae9a1ae09> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"10m-admin-1 boundaries UNION with Exclusive Economic Zones\"" ;
    bdqffdq:hasArgumentValue "10m-admin-1 boundaries UNION with Exclusive Economic Zones" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:972320cd-3ba3-4076-a8eb-f797095509cd> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:spatialBufferInMeters:\"3000\"" ;
    bdqffdq:hasArgumentValue "3000" ;
    bdqffdq:hasParameter bdqval:spatialBufferInMeters .

<https://rs.tdwg.org/bdqtest/terms/version/adb27d29-9f0d-4d52-b760-a77ba57a69c9-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COORDINATESCOUNTRYCODE_CONSISTENT" ;
    dcterms:description "Do the geographic coordinates fall on or within the boundaries of the territory given in dwc:countryCode or its Exclusive Economic Zone?" ;
    dcterms:isVersionOf bdqtest:adb27d29-9f0d-4d52-b760-a77ba57a69c9 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <http://www.fao.org/3/a0118e/a0118e00.htm#Contents>,
        <https://doi.org/10.14284/628>,
        <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2>,
        <https://github.com/nvkelso/natural-earth-vector/releases/tag/v5.1.2>,
        <https://technicalgeography.org/pdf/sp_i_2010/12_introducing_natural_earth_data__naturaleart.pdf>,
        <https://www.iso.org/iso-3166-country-codes.html>,
        <https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/50" ;
    skos:note "dwc:coordinatePrecision and dwc:coordinateUncertaintyInMeters (if present) imply a potential displacement of the provided coordinates. These two terms can be considered spatial buffers. Likewise, country polygons cannot be 100% accurate at all scales (Dooley 2005), so a spatial buffer of the country boundaries is justified. When dwc:countryCode=XZ (for High Seas), the coordinate should fall into a marine region out side of the EEZ of any country. Taking the spatial buffers into account does however greatly complicate both the logic and the implementation of such Tests. The same applies to potential conversion of the Spatial Reference System (SRS) of dwc:decimalLatitude and dwc:decimalLongitude to the SRS used in the bdqval:sourceAuthority." ;
    skos:prefLabel "Validation Coordinates dwc:countryCode Consistent for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:6f6a46c6-9979-41a2-83c2-fd196e89c8c1> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Consistency ;
    bdqffdq:hasDateLastUpdated "2024-08-30"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

