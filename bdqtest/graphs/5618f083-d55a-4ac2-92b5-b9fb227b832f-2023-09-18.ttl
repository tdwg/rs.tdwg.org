<urn:uuid:449f44fe-0fef-42ff-a446-d693653b55d4> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_EVENT_CONSISTENT with Specification for: VALIDATION_EVENT_CONSISTENT" ;
