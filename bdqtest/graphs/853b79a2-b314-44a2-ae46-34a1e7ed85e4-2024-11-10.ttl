<urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:countryCode" ;
    skos:prefLabel "Information Element ActedUpon dwc:countryCode" ;
    bdqffdq:composedOf dwc:countryCode .

<urn:uuid:d153d4bd-b39d-43b0-b00a-395ff3e2ca62> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COUNTRYCODE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:countryCode is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:countryCode=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:countryCode is bdqval:Empty\"",
        "dwc:countryCode=\"Australia\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:countryCode is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:countryCode is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/853b79a2-b314-44a2-ae46-34a1e7ed85e4-2024-11-10> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COUNTRYCODE_NOTEMPTY" ;
    dcterms:description "Is there a value in dwc:countryCode?" ;
    dcterms:isVersionOf bdqtest:853b79a2-b314-44a2-ae46-34a1e7ed85e4 ;
    dcterms:issued "2024-11-10"^^xsd:date ;
    dcterms:references <https://datahub.io/core/country-list>,
        <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2>,
        <https://www.iso.org/iso-3166-country-codes.html> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/98" ;
    skos:note "Darwin Core recommends that data from the high seas (outside national jurisdictions) use dwc:countryCode = \"XZ\"." ;
    skos:prefLabel "Validation dwc:countryCode Not Empty for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-11-10"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

