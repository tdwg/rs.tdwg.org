<urn:uuid:930eb72e-fe83-48ae-9698-ca46713721a3> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_COUNTRYCODE_NOTEMPTY with Specification for: VALIDATION_COUNTRYCODE_NOTEMPTY" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2308",
