  },
  {
    "@id": "urn:uuid:0dacd2f5-591c-47c1-9d05-2de81675b6cc",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/IssueMethod"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "IssueMethod: ISSUE_ANNOTATION_NOTEMPTY with Specification Specification for: ISSUE_ANNOTATION_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "Source: ALA, Lee Belbin"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "TG2 Issue OTHER Test CORE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "IssueMethod: ISSUE_ANNOTATION_NOTEMPTY with Specification Specification for: ISSUE_ANNOTATION_NOTEMPTY"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/forIssue": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1-2023-09-18"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasSpecification": [
      {
        "@id": "urn:uuid:1999e4e0-ce3a-46e3-b131-24412bd94bd1"
      }
    ]
  },
  {
    "@id": "urn:uuid:1999e4e0-ce3a-46e3-b131-24412bd94bd1",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:annotationSystem is not available; POTENTIAL_ISSUE if an annotation in the bdqval:annotationSystem exists and has an oa:hasTarget referencing the bdqffdq:SingleRecord under evaluation with matching bdqval:annotationAlertIf criteria; otherwise NOT_ISSUE. bdqval:annotationSystem default = \"W3C Web Annotation\" {[https://www.w3.org/annotation/]} {\"oa:Annotation vocabulary\" [https://www.w3.org/TR/annotation-vocab/]},bdqval:annotationAlertIf default = \"oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test.\" {[https://www.w3.org/TR/annotation-vocab/]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: ISSUE_ANNOTATION_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "bdqval:annotationAlertIf=\"?\": Response.status=RUN_HAS_RESULT, Response.result=POTENTIAL_ISSUE, Response.comment=\"bdqval:annotationAlertIf is bdqval:NotEmpty\""
      },
      {
        "@value": "bdqval:annotationAlertIf=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_ISSUE, Response.comment=\"bdqval:annotationAlertIf is bdqval:Empty\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:8c52d108-f9fe-4835-9939-6acc4430c9ee"
      },
      {
        "@id": "urn:uuid:de022674-06c8-48cf-86b6-2cd362e24667"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:annotationSystem default = \"W3C Web Annotation\" {[https://www.w3.org/annotation/]} {\"oa:Annotation vocabulary\" [https://www.w3.org/TR/annotation-vocab/]},bdqval:annotationAlertIf default = \"oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test.\" {[https://www.w3.org/TR/annotation-vocab/]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:annotationSystem is not available; POTENTIAL_ISSUE if an annotation in the bdqval:annotationSystem exists and has an oa:hasTarget referencing the bdqffdq:SingleRecord under evaluation with matching bdqval:annotationAlertIf criteria; otherwise NOT_ISSUE."
      }
    ]
  },
