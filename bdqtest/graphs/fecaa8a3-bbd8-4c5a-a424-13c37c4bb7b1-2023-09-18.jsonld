    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ISSUE_ANNOTATION_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/29"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "While there is a W3C standard on 'web annotation', there is no TDWG recommendation on how this standard could be applied to annotating Darwin Core records. While implementation of this Test is currently problematic, TG2 considers annotations attached to any aspect of a Darwin Core record justifies this Test as a placeholder in the hope of future developments."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Issue Annotation Not Empty for SingleRecord"
      }
    ],
