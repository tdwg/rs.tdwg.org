      {
        "@value": "dcterms:license=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dcterms:license is bdqval:Empty\""
      },
      {
        "@value": "dcterms:license=\"CC0 1.0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dcterms:license is bdqval:NotEmpty\""
      }
    ],
