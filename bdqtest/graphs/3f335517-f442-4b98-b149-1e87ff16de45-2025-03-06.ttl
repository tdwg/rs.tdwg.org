bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:3c2fe7e9-186f-4ceb-8274-8bbcb4a62de4> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_SCIENTIFICNAME_FOUND" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty; COMPLIANT if there is a match of the contents of dwc:scientificName in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"GBIF Backbone Taxonomy\" {[https://doi.org/10.15468/39omei]} {API endpoint [https://api.gbif.org/v1/species?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&name=]}" ;
    skos:example "dwc:scientificName=\"Capulus intort\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName was not found in the bdqval:sourceAuthority\"",
        "dwc:scientificName=\"Eucalyptus camaldulensis\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:scientificName found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:d9dc26f7-6c4e-4647-addc-20197ce50d2b> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF Backbone Taxonomy\" {[https://doi.org/10.15468/39omei]} {API endpoint [https://api.gbif.org/v1/species?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&name=]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty; COMPLIANT if there is a match of the contents of dwc:scientificName in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<urn:uuid:627a0c7f-9c5d-49ba-a3d1-1c8250cf1d0a> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:scientificName" ;
    skos:prefLabel "Information Element ActedUpon dwc:scientificName" ;
    bdqffdq:composedOf dwc:scientificName .

<urn:uuid:d9dc26f7-6c4e-4647-addc-20197ce50d2b> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF Backbone Taxonomy\"" ;
    bdqffdq:hasArgumentValue "GBIF Backbone Taxonomy" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<https://rs.tdwg.org/bdqtest/terms/version/3f335517-f442-4b98-b149-1e87ff16de45-2025-03-06> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_SCIENTIFICNAME_FOUND" ;
    dcterms:description "Is there a match of the contents of dwc:scientificName with the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:3f335517-f442-4b98-b149-1e87ff16de45 ;
    dcterms:issued "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/46" ;
    skos:note "The purpose of this Test is to detect errors in the scientific name but is dependent on the abilities of the parsing of the bdqval:sourceAuthority. For research users of biodiversity data doing quality assurance, VALIDATION_TAXON_UNAMBIGUOUS (4c09f127-737b-4686-82a0-7c8e30841590) handles their needs, but for curators of datasets doing quality control, this Test provides a specific subset of targeted data cleaning, making it a valuable Test to include for the quality control case. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:scientificName Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:627a0c7f-9c5d-49ba-a3d1-1c8250cf1d0a> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-17"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

