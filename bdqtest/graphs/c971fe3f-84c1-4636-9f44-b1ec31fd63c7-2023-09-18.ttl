    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

bdqval:maximumValidElevationInMeters a bdqffdq:Parameter .

bdqval:minimumValidElevationInMeters a bdqffdq:Parameter .

<urn:uuid:1766715d-e588-4361-8b27-1c9cc43662ab> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:maximumValidElevationInMeters:\"8850\"" ;
    bdqffdq:hasArgumentValue "8850" ;
    bdqffdq:hasParameter bdqval:maximumValidElevationInMeters .

<urn:uuid:3ab181c2-a3d8-4317-af4d-f88181e2773a> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:minimumValidElevationInMeters:\"-430\"" ;
    bdqffdq:hasArgumentValue "-430" ;
    bdqffdq:hasParameter bdqval:minimumValidElevationInMeters .

<urn:uuid:d06be5a2-809e-4b7a-9f4b-6ba1e6951d36> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:maximumElevationInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:maximumElevationInMeters" ;
    bdqffdq:composedOf dwc:maximumElevationInMeters .

<urn:uuid:f9471802-a5f7-4f4e-9810-f3f4f43dad1a> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MAXELEVATION_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumElevationInMeters is bdqval:Empty or the value cannot be interpreted as a number; COMPLIANT if the value of dwc:maximumElevationInMeters is within the range of bdqval:minimumValidElevationInMeters to bdqval:maximumValidElevationInMeters inclusive; otherwise NOT_COMPLIANT bdqval:minimumValidElevationInMeters default = \"-430\",bdqval:maximumValidElevationInMeters default = \"8850\"" ;
    skos:example "dwc:maximumElevationInMeters=\"-500\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:maximumElevation is not in range, i.e. is <-430\"",
        "dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:maximumElevation is in is range\"" ;
    bdqffdq:hasArgument <urn:uuid:1766715d-e588-4361-8b27-1c9cc43662ab>,
        <urn:uuid:3ab181c2-a3d8-4317-af4d-f88181e2773a> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:minimumValidElevationInMeters default = \"-430\",bdqval:maximumValidElevationInMeters default = \"8850\"" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumElevationInMeters is bdqval:Empty or the value cannot be interpreted as a number; COMPLIANT if the value of dwc:maximumElevationInMeters is within the range of bdqval:minimumValidElevationInMeters to bdqval:maximumValidElevationInMeters inclusive; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/c971fe3f-84c1-4636-9f44-b1ec31fd63c7-2023-09-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MAXELEVATION_INRANGE" ;
    dcterms:description "Is the value of dwc:maximumElevationInMeters within the Parameter range?" ;
    dcterms:isVersionOf bdqtest:c971fe3f-84c1-4636-9f44-b1ec31fd63c7 ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/Extreme_points_of_Antarctica>,
        <https://en.wikipedia.org/wiki/List_of_elevation_extremes_by_country_> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/112" ;
    skos:note "We have rounded up the Parameter values. We are aware of sub-ice elevations in Antarctica to -3,500m and possible sampling in the atmosphere above the elevation of the top of Mt Everest should fail this Test if captured as elevation rather than as distanceAboveSurfaceInMeters. Elevations below the maximum elevation yet above the local surface will be false positives." ;
    skos:prefLabel "Validation dwc:maximumElevationInMeters In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:d06be5a2-809e-4b7a-9f4b-6ba1e6951d36> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

