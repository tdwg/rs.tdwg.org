<urn:uuid:1a504f7f-21a7-49e1-a0dc-f51146957fa4> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLONGITUDE_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLongitude is bdqval:Empty or the value is not a number; COMPLIANT if the value of dwc:decimalLongitude is between -180 and 180 degrees, inclusive; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:decimalLongitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLongitude is in range\"",
        "dwc:decimalLongitude=\"181.0554\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLongitude >180\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLongitude is bdqval:Empty or the value is not a number; COMPLIANT if the value of dwc:decimalLongitude is between -180 and 180 degrees, inclusive; otherwise NOT_COMPLIANT" .

<urn:uuid:bda769d4-d876-4bd0-8026-89bed5aad0eb> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:decimalLongitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:decimalLongitude" ;
    bdqffdq:composedOf dwc:decimalLongitude .

