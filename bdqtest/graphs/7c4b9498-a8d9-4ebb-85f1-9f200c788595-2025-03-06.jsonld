    "http://purl.org/dc/terms/description": [
      {
        "@value": "COMPLIANT if dwc:scientificName is bdqval:NotEmpty; otherwise NOT_COMPLIANT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_SCIENTIFICNAME_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:scientificName=\"?\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:scientificName is bdqval:NotEmpty\""
      },
      {
        "@value": "dwc:scientificName=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName is bdqval:Empty\""
      }
    ],
