    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_QA_MINELEVATION_INRANGE</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/297</skos:historyNote>
    <skos:note>For Quality Assurance, filter record set until this measure is COMPLETE.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord for QualityAssurance of Validation dwc:minimumElevationInMeters In Range for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:5cdd4160-7979-4e15-be8f-c8e3cc88e472"/>
