bdqval:sourceAuthority a bdqffdq:Parameter .

<https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Dublin Core (2020) Dublin Core Metadata Initiative. License Document. https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/" .

<urn:uuid:7ecc692d-e65f-4ea5-9d54-04421ec96ab4> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Creative Commons\"" ;
    bdqffdq:hasArgumentValue "Creative Commons" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:825f551a-2adf-4509-9f95-5a42601a8e88> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_LICENSE_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; AMENDED value of dcterms:license if it could be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED. bdqval:sourceAuthority default = \"Creative Commons\" {[https://creativecommons.org/]} {Creative Commons licenses [https://creativecommons.org/about/cclicenses/]}" ;
    skos:example "dcterms:license=\"CC0\": Response.status=AMENDED, Response.result=dcterms:license=\"https://creativecommons.org/publicdomain/zero/1.0/legalcode\", Response.comment=\"Input field contains interpretable value\"",
        "dcterms:license=\"X\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dcterms:license contains uninterpretable value \"X\"\"" ;
    bdqffdq:hasArgument <urn:uuid:7ecc692d-e65f-4ea5-9d54-04421ec96ab4> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Creative Commons\" {[https://creativecommons.org/]} {Creative Commons licenses [https://creativecommons.org/about/cclicenses/]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; AMENDED value of dcterms:license if it could be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED." .

<urn:uuid:d3daaab7-b042-4dc7-a92f-77f19988f351> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dcterms:license" ;
    skos:prefLabel "Information Element ActedUpon dcterms:license" ;
    bdqffdq:composedOf dcterms:license .

<https://rs.tdwg.org/bdqtest/terms/version/dcbe5bd2-42a0-4aab-bb4d-8f148c6490f8-2025-03-07> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_LICENSE_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dcterms:license using the bdqval:sourceAuthority." ;
    dcterms:isVersionOf bdqtest:dcbe5bd2-42a0-4aab-bb4d-8f148c6490f8 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://creativecommons.org/licenses/>,
        <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/133" ;
    skos:note "The license at the record level might be derived from the license of the dataset from which the record is retrieved." ;
    skos:prefLabel "Amendment dcterms:license Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:d3daaab7-b042-4dc7-a92f-77f19988f351> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

