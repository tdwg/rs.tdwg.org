    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:taxonRank=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:taxonRank is bdqval:Empty\""
      },
      {
        "@value": "dwc:taxonRank=\"genus\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:taxonRank is bdqval:NotEmpty\""
      }
    ],
