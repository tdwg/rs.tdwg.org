  <rdf:Description rdf:about="urn:uuid:05f8a834-4582-4d50-8ac6-2bd766c3ae28">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Consulted"/>
    <rdfs:label>Information Element Consulted dwc:year, dwc:month, dwc:day</rdfs:label>
    <skos:prefLabel>Information Element Consulted dwc:year, dwc:month, dwc:day</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/day"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/month"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/year"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:eventDate</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:eventDate</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/eventDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:8ca96a50-f1f5-4a4e-853e-755cc5aa82a7">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentMethod"/>
    <rdfs:label>AmendmentMethod: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY with Specification Specification for: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY</rdfs:label>
    <skos:historyNote>Source: TG2-Gainesville</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/event_date_qc/blob/v3.0.5/src/main/java/org/filteredpush/qc/date/DwCEventDQ.java#L1395</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush event_date_qc Library (Morris &amp; Lowery 2025)</skos:note>
    <skos:note>TG2 Amendment TIME CODED Test Completeness CORE</skos:note>
    <skos:prefLabel>AmendmentMethod: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY with Specification Specification for: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY</skos:prefLabel>
    <bdqffdq:forAmendment rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/3892f432-ddd0-4a0a-b713-f2e2ecbd879d-2024-09-15"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:bda7e8a3-3366-43d5-8a8b-e206101dc90d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/3892f432-ddd0-4a0a-b713-f2e2ecbd879d-2024-09-15">
    <dcterms:description>Proposes an amendment to the value of dwc:eventDate from values in dwc:year, dwc:month and dwc:day.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/3892f432-ddd0-4a0a-b713-f2e2ecbd879d"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-15</dcterms:issued>
    <dcterms:references rdf:resource="https://en.wikipedia.org/wiki/ISO_8601"/>
    <dcterms:references rdf:resource="https://www.iso.org/obp/ui/"/>
    <dcterms:references rdf:resource="https://www.loc.gov/standards/datetime/"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Amendment"/>
    <rdfs:label>AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/93</skos:historyNote>
    <skos:note>An attempt to populate dwc:eventDate from dwc:verbatimEventDate and from dwc:startDayOfYear and dwc:endDayOfYear should be made before this Test is run. If dwc:year and dwc:day are present and interpretable, but dwc:month is not supplied or is not interpretable, then just the year should be given as the proposed amendment. This Test assumes that that dwc:year, dwc:month, dwc:day are in a Gregorian calendar, and that only those three pieces of information are needed to produce a dwc:eventDate (explicitly in ISO 8601-1 format, and thus using the Gregorian calendar). When running the Test, the original precision, e.g. dwc:year=1980, dwc:month=1 should be retained, e.g. dwc:eventDate should become 1980-01, not 1980-01-01/1980-01-31.</skos:note>
    <skos:prefLabel>Amendment dwc:eventDate from dwc:year dwc:month dwc:day for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac"/>
    <bdqffdq:hasConsultedInformationElement rdf:resource="urn:uuid:05f8a834-4582-4d50-8ac6-2bd766c3ae28"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Completeness"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-15</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasEnhancement rdf:resource="https://rs.tdwg.org/bdqenh/terms/FilledInFrom"/>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqdim/terms/Completeness">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/DataQualityDimension"/>
    <rdfs:label>Completeness</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:bda7e8a3-3366-43d5-8a8b-e206101dc90d">
    <dcterms:description>INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY</rdfs:label>
    <skos:example>dwc:eventDate="", dwc:year="1420", dwc:month="10", dwc:day="29": Response.status=FILLED_IN, Response.result=dwc:eventDate="1420-10-29", Response.comment="dwc:year, dwc:month and dwc:day are interpretable, even if pre-Linnaeus"</skos:example>
    <skos:example>dwc:eventDate="", dwc:year="2024", dwc:month="2", dwc:day="30": Response.status=NOT_AMENDED, Response.result=, Response.comment="Not a valid date"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:f03dcc89-5e2b-41bc-b1d8-5a319fb18d22">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentPolicy"/>
    <rdfs:label>AmendmentPolicy: (11) amendments  in UseCase bdquc:Spatial-Temporal_Patterns</rdfs:label>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/3892f432-ddd0-4a0a-b713-f2e2ecbd879d-2024-09-15"/>
  </rdf:Description>
