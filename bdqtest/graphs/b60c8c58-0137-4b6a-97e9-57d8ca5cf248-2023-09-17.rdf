  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/b60c8c58-0137-4b6a-97e9-57d8ca5cf248-2023-09-17">
    <dcterms:description>Count the number of VALIDATION_BASISOFRECORD_NOTEMPTY in a record set that are COMPLIANT.</dcterms:description>
