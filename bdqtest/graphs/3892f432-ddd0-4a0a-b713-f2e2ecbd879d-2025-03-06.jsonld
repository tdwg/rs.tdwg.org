      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/3892f432-ddd0-4a0a-b713-f2e2ecbd879d-2025-03-06"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasSpecification": [
      {
        "@id": "urn:uuid:bda7e8a3-3366-43d5-8a8b-e206101dc90d"
      }
    ]
  },
  {
    "@id": "urn:uuid:bda7e8a3-3366-43d5-8a8b-e206101dc90d",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_EVENTDATE_FROM_YEARMONTHDAY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:eventDate=\"\", dwc:year=\"1420\", dwc:month=\"10\", dwc:day=\"29\": Response.status=FILLED_IN, Response.result=dwc:eventDate=\"1420-10-29\", Response.comment=\"dwc:year, dwc:month and dwc:day are interpretable, even if pre-Linnaeus\""
      },
      {
        "@value": "dwc:eventDate=\"\", dwc:year=\"2024\", dwc:month=\"2\", dwc:day=\"30\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"Not a valid date\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL _PREREQUISITES_NOT_MET if dwc:eventDate is not EMPTY or dwc:year is EMPTY or is not interpretable as an integer; FILLED_IN the value of dwc:eventDate if an ISO 8601 date was interpreted from the values in dwc:year, dwc:month and dwc:day; otherwise NOT_AMENDED"
      }
    ]
  },
