    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Taxon-Management"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/f2ce7d55-5b1d-426a-b00e-6d4efe3058ec-2023-09-18"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:6417eb42-b07d-4b42-9a6a-13c592aeb5ea">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:genus</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:genus</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/genus"/>
  </rdf:Description>
