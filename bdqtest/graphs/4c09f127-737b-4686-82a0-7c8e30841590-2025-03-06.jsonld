  {
    "@id": "urn:uuid:7dbf3aca-f028-4eba-a132-db6abbd4ff16",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/ActedUpon"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Information Element ActedUpon dwc:scientificName, dwc:scientificNameID"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Information Element ActedUpon dwc:scientificName, dwc:scientificNameID"
      }
    ],
