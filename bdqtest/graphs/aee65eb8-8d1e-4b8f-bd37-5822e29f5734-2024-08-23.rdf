  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/aee65eb8-8d1e-4b8f-bd37-5822e29f5734-2024-08-23">
    <dcterms:description>Count the number of VALIDATION_YEAR_INRANGE in a record set that are COMPLIANT.</dcterms:description>
