<urn:uuid:30db5994-81fa-4684-ac54-cfc226209d27> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:country" ;
    skos:prefLabel "Information Element ActedUpon dwc:country" ;
    bdqffdq:composedOf dwc:country .

<urn:uuid:34ef6ea2-de06-4d2c-88fe-2c779de8f7db> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COUNTRY_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:country is bdqval:NotEmpty or dwc:countryCode has a value of \"XZ\" and either dwc:country is bdqval:Empty or has a value of \"High seas\"; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:country=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:country is bdqval:Empty\"",
        "dwc:country=\"Eswatini\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:country is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:country is bdqval:NotEmpty or dwc:countryCode has a value of \"XZ\" and either dwc:country is bdqval:Empty or has a value of \"High seas\"; otherwise NOT_COMPLIANT" .

<urn:uuid:d24a7b73-972a-4fdd-a790-91acb5fcf725> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted dwc:countryCode" ;
    skos:prefLabel "Information Element Consulted dwc:countryCode" ;
    bdqffdq:composedOf dwc:countryCode .

<https://rs.tdwg.org/bdqtest/terms/version/6ce2b2b4-6afe-4d13-82a0-390d31ade01c-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COUNTRY_NOTEMPTY" ;
    dcterms:description "Is there a value in dwc:country?" ;
    dcterms:isVersionOf bdqtest:6ce2b2b4-6afe-4d13-82a0-390d31ade01c ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/42" ;
    skos:note "Country is expected to be either bdqval:Empty or, ideally, have a value of \"High seas\" or an agreed equivalent if material comes from the high seas, or from those portions of Antarctica outside of any sovereign nation." ;
    skos:prefLabel "Validation dwc:country Not Empty for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:30db5994-81fa-4684-ac54-cfc226209d27> ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:d24a7b73-972a-4fdd-a790-91acb5fcf725> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-09-27"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

