      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/composedOf": [
      {
        "@id": "http://rs.tdwg.org/dwc/terms/genericName"
      },
      {
        "@id": "http://rs.tdwg.org/dwc/terms/infraspecificEpithet"
      },
      {
        "@id": "http://rs.tdwg.org/dwc/terms/scientificName"
      },
      {
        "@id": "http://rs.tdwg.org/dwc/terms/specificEpithet"
      }
    ]
  },
  {
    "@id": "urn:uuid:d92c5e23-bf6a-483b-86c3-9374e12d01c7",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty, or all of dwc:genericName, dwc:specificEpithet and dwc:infraspecificEpithet are bdqval:Empty; COMPLIANT if the polynomial, as represented in dwc:scientificName, is consistent with bdqval:NotEmpty values of dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet; otherwise NOT_COMPLIANT."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_POLYNOMIAL_CONSISTENT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:scientificName=\"Hakea decurrens ssp. physocarpa\", dwc:genericName=\"\", dwc:specificEpithet=\"decurrens\", dwc:infraspecificEpithet=\"physocarpa\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"Values of all non-empty atomic terms are found in the polynomial\""
      },
      {
        "@value": "dwc:scientificName=\"Hakea decurrens\", dwc:genericName=\"Hakea\", dwc:specificEpithet=\"decurrens\", dwc:infraspecificEpithet=\"physocarpa\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName is inconsistent with atomic parts (dwc:genus, dwc:specificEpithet and dwc:infraspecificEpithet)\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty, or all of dwc:genericName, dwc:specificEpithet and dwc:infraspecificEpithet are bdqval:Empty; COMPLIANT if the polynomial, as represented in dwc:scientificName, is consistent with bdqval:NotEmpty values of dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet; otherwise NOT_COMPLIANT."
      }
    ]
  }
