  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/17f03f1f-f74d-40c0-8071-2927cfc9487b-2023-09-18",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Validation"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Is the polynomial represented in dwc:scientificName consistent with the equivalent values in dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/17f03f1f-f74d-40c0-8071-2927cfc9487b"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-09-18"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://doi.org/10.15468/39omei"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_POLYNOMIAL_CONSISTENT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/101"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "If dwc:specificEpithet is populated then this Test expects that the value dwc:specificEpithet is the name of the second or species epithet of the scientificName. If dwc:genericName is populated, this Test expects that the value of dwc:genus is the first word of the value of dwc:scientificName. If dwc:specificEpithet is populated then this Test expects that the value dwc:specificEpithet is the name of the first or species epithet of the scientificName. If dwc:infraspecificEpithet is populated, then this Test expects that the value of dwc:infraspecificEpithet is the name of the lowest or terminal infraspecific epithet of the scientificName, excluding any rank designation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Validation Polynomial Consistent for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:a06d69d9-50ae-4d95-977c-73e926be4883"
      }
