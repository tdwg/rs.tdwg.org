<urn:uuid:06f9faab-102a-452a-b6e0-4eafd8d7e71d> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_PHYLUM_FOUND with Specification for: VALIDATION_PHYLUM_FOUND" ;
    skos:historyNote "Source: iDigBio" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L130",
        "Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris & Dou 2025)",
        "TG2 Validation NAME CODED Test VOCABULARY Conformance Parameterized CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_PHYLUM_FOUND with Specification for: VALIDATION_PHYLUM_FOUND" ;
