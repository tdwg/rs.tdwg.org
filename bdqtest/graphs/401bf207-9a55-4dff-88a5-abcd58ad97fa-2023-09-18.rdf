    <skos:note>TG2 Validation NAME CODED Test Completeness CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_SCIENTIFICNAMEID_NOTEMPTY with Specification for: VALIDATION_SCIENTIFICNAMEID_NOTEMPTY</skos:prefLabel>
