    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:08a4abb0-8977-4805-a4a1-c1a96b532322> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_SEX_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; AMENDED the value of dwc:sex if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"GBIF Sex Vocabulary\" [https://api.gbif.org/v1/vocabularies/Sex]} {\"dwc:sex vocabulary API\" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}" ;
    skos:example "dwc:sex=\"f\": Response.status=AMENDED, Response.result=dwc:sex=\"Female\", Response.comment=\"dwc:sex found in the bdqval:sourceAuthority\"",
        "dwc:sex=\"x\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:sex not found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:e35dd18a-9c69-4aef-9b70-3d36d7eb6bd4> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF Sex Vocabulary\" [https://api.gbif.org/v1/vocabularies/Sex]} {\"dwc:sex vocabulary API\" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; AMENDED the value of dwc:sex if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<urn:uuid:81029ffa-2df8-4e9e-a7dd-fc67faad9205> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:sex" ;
    skos:prefLabel "Information Element ActedUpon dwc:sex" ;
    bdqffdq:composedOf dwc:sex .

<urn:uuid:e35dd18a-9c69-4aef-9b70-3d36d7eb6bd4> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF Sex Vocabulary\"" ;
    bdqffdq:hasArgumentValue "GBIF Sex Vocabulary" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<https://rs.tdwg.org/bdqtest/terms/version/33c45ae1-e2db-462a-a59e-7169bb01c5d6-2024-03-25> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_SEX_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:sex using the bdqval:sourceAuthority." ;
