bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:09023be7-9359-48a8-873b-3e65d43427ba> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:establishmentMeans" ;
    skos:prefLabel "Information Element ActedUpon dwc:establishmentMeans" ;
    bdqffdq:composedOf dwc:establishmentMeans .

<urn:uuid:0c051c38-621f-4a52-ae92-5077afd46446> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Establishment Means Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Establishment Means Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:f1d3bf9c-5558-41dc-8e33-b17c499be016> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_ESTABLISHMENTMEANS_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; COMPLIANT if the value of dwc:establishmentMeans is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    skos:example "dwc:establishmentMeans=\"cultivated\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:establishmentMeans not found in the bdqval:sourceAuthority\"",
        "dwc:establishmentMeans=\"native\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:establishmentMeans found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:0c051c38-621f-4a52-ae92-5077afd46446> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; COMPLIANT if the value of dwc:establishmentMeans is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<https://rs.tdwg.org/bdqtest/terms/version/4eb48fdf-7299-4d63-9d08-246902e2857f-2024-02-08> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_ESTABLISHMENTMEANS_STANDARD" ;
    dcterms:description "Does the value of dwc:establishmentMeans occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:4eb48fdf-7299-4d63-9d08-246902e2857f ;
    dcterms:issued "2024-02-08"^^xsd:date ;
    dcterms:references <http://rs.tdwg.org/dwc/doc/em/>,
        <https://doi.org/10.3897/biss.3.38084> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/268" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:establishmentMeans Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:09023be7-9359-48a8-873b-3e65d43427ba> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-02-08"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

