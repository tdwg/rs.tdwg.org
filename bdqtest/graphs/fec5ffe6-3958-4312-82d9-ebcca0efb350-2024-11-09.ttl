<urn:uuid:3e076cfa-56ff-4b79-9739-736d062eac5a> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_COUNTRYCODE_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    skos:example "dwc:countryCode=\"Aust.\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:countryCode contains an ambiguous value\"",
        "dwc:countryCode=\"Australia\": Response.status=AMENDED, Response.result=dwc:countryCode=\"AU\", Response.comment=\"dwc:countryCode contains an interpretable value\"" ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:countryCode" ;
    skos:prefLabel "Information Element ActedUpon dwc:countryCode" ;
    bdqffdq:composedOf dwc:countryCode .

<https://rs.tdwg.org/bdqtest/terms/version/fec5ffe6-3958-4312-82d9-ebcca0efb350-2024-11-09> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_COUNTRYCODE_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:countryCode if it can be interpreted as an ISO 3166-1-alpha-2 country code." ;
    dcterms:isVersionOf bdqtest:fec5ffe6-3958-4312-82d9-ebcca0efb350 ;
    dcterms:issued "2024-11-09"^^xsd:date ;
    dcterms:references <https://datahub.io/core/country-list>,
        <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2>,
        <https://www.iso.org/iso-3166-country-codes.html> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/48" ;
    skos:note "This Test supports conformance with the recommendation in the comment on dwc:countryCode: \"Recommended best practice is to use an ISO 3166-1-alpha-2 country code.\" Darwin Core also recommends the use of the XZ for high seas and ZZ for unknown. Three letter codes should be amended to the matching two-letter code." ;
    skos:prefLabel "Amendment dwc:countryCode Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-11-09"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

