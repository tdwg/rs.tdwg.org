  <rdf:Description rdf:about="urn:uuid:3dcd847e-25bf-4ae2-8428-8e74e054d9e6">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MeasurementMethod"/>
    <rdfs:label>MeasurementMethod: MEASURE_AMENDMENTS_PROPOSED with Specification Specification for: MEASURE_AMENDMENTS_PROPOSED</rdfs:label>
    <skos:historyNote>Source: John Wieczorek</skos:historyNote>
    <skos:note>TG2 Measure NAME SPACE TIME OTHER Test CORE</skos:note>
    <skos:prefLabel>MeasurementMethod: MEASURE_AMENDMENTS_PROPOSED with Specification Specification for: MEASURE_AMENDMENTS_PROPOSED</skos:prefLabel>
    <bdqffdq:forMeasure rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/03049fe5-a575-404f-b564-ae63f5a1cf8b-2026-11-12"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:7e365897-cfc0-413e-a613-99c6050edc4b"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/03049fe5-a575-404f-b564-ae63f5a1cf8b-2026-11-12">
    <dcterms:description>A count of the distinct AMENDMENT Tests run on a record that have Response.status=AMENDED or FILLED_IN.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/03049fe5-a575-404f-b564-ae63f5a1cf8b"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</dcterms:issued>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MEASURE_AMENDMENTS_PROPOSED</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/65</skos:historyNote>
    <skos:note>If no AMENDMENT Tests were run on the record, the result is 0.</skos:note>
    <skos:prefLabel>Measure Amendments Proposed for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:fd84c789-375d-4c5a-8b5a-2ecf9d107fa1"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Reliability"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:7e365897-cfc0-413e-a613-99c6050edc4b">
    <dcterms:description>RUN_HAS_RESULT with the result being the number of distinct AMENDMENT Tests run on the record that have Response.status=AMENDED or Response.status=FILLED_IN.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: MEASURE_AMENDMENTS_PROPOSED</rdfs:label>
    <skos:example>[Response.status=RUN_HAS_RESULT, Response.result="17", Response.comment="17 AMENDMENT Tests had Response.status=AMENDED or FILLED_IN."]</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>RUN_HAS_RESULT with the result being the number of distinct AMENDMENT Tests run on the record that have Response.status=AMENDED or Response.status=FILLED_IN.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
