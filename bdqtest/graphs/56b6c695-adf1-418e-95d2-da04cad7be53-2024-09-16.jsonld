    "https://rs.tdwg.org/bdqffdq/terms/hasUseCase": [
      {
        "@id": "https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/includedInPolicy": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/56b6c695-adf1-418e-95d2-da04cad7be53-2024-09-16"
