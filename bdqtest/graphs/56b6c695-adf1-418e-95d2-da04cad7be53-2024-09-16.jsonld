    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "What is the duration of dwc:eventDate in seconds?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/56b6c695-adf1-418e-95d2-da04cad7be53"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-09-16"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://en.wikipedia.org/wiki/ISO_8601"
      },
      {
        "@id": "https://www.iso.org/obp/ui/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MEASURE_EVENTDATE_DURATIONINSECONDS"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/140"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The duration of a day is 86400 seconds. Implementations should treat all days as 86400 seconds, but should include leap days (but not leap seconds) in durations that encompass them. Consumers should treat assertions about event date duration as approximations, see: https://xkcd.com/2867/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Measure dwc:eventDate Duration in Seconds for SingleRecord"
      }
    ],
