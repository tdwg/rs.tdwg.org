    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/62"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The country code determination service should be able to match the name of a country in the original or any language in the source authority. When dwc:countryCode=\"XZ\" to designate \"high seas\", dwc:country should be empty. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
