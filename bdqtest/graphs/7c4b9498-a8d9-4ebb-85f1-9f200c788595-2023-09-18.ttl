<urn:uuid:a9c18563-f63e-42db-98e5-a3e6079086b7> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_SCIENTIFICNAME_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:scientificName is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:scientificName=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName is bdqval:Empty\"",
        "dwc:scientificName=\"?\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:scientificName is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:scientificName is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

