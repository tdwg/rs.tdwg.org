    rdfs:label "Default value for bdqval:annotationAlertIf:\"oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test.\"" ;
    bdqffdq:hasArgumentValue "oa:Annotation with oa:hasTarget having as object any dwciri:term instance that is part of the SingleRecord under Test." ;
    bdqffdq:hasParameter bdqval:annotationAlertIf .

<urn:uuid:e9d0f3c8-848c-409e-9af3-70425650a575> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "W3C (2017) Web Annotation Data Model. https://www.w3.org/TR/annotation-model/" .

<https://rs.tdwg.org/bdqtest/terms/version/fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1-2024-09-17> a bdqffdq:Issue ;
    rdfs:label "ISSUE_ANNOTATION_NOTEMPTY" ;
    dcterms:description "Are there any annotations associated with the record?" ;
    dcterms:isVersionOf bdqtest:fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1 ;
    dcterms:issued "2024-09-17"^^xsd:date ;
    dcterms:references <urn:uuid:3c0146df-5ce2-4f35-a066-5cf14de8c79a>,
        <urn:uuid:71c9c3d1-fb9d-4774-8f31-63bc7a4ef49b>,
        <urn:uuid:e9d0f3c8-848c-409e-9af3-70425650a575> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/29" ;
    skos:note "While there is a W3C standard on 'web annotation', there is no TDWG recommendation on how this standard could be applied to annotating Darwin Core records. While implementation of this Test is currently problematic, TG2 considers annotations attached to any aspect of a Darwin Core record justifies this Test as a placeholder in the hope of future developments." ;
    skos:prefLabel "Issue Annotation Not Empty for SingleRecord" ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:b7a02234-c4d0-40fd-a437-af8330cc700f> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Reliability ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

