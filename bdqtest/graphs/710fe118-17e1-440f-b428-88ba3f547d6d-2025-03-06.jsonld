  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/710fe118-17e1-440f-b428-88ba3f547d6d-2025-03-06",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to values in any of dwc:year, dwc:month, dwc:day, dwc:startDayOfYear or dwc:endDayOfYear from the content of dwc:eventDate."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/710fe118-17e1-440f-b428-88ba3f547d6d"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-03-06"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://en.wikipedia.org/wiki/ISO_8601"
      },
      {
        "@id": "https://www.iso.org/obp/ui/"
      },
      {
        "@id": "https://www.loc.gov/standards/datetime/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_EVENT_FROM_EVENTDATE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/52"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Only fields that are empty will be have changes proposed, and only if dwc:eventDate has a valid ISO 8601-1 date. The dwc:eventDate is the canonical form of the event date (it is the first trusted form). If event date does not contain a range,dwc:startDayOfYear = dwc:endDayOfYear. Time (as compared to date) is not deemed a CORE component. Note, see sequencing Tests section of standards documents, run this amendment after any other amendment that may affect dwc:eventDate"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment dwc:Event from dwc:eventDate for SingleRecord"
      }
    ],
