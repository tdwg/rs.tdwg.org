<http://rs.gbif.org/vocabulary/gbif/type_status> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "GBIF (2021) Darwin Core Vocabulary: Nomenclatural Type Status Vocabulary. http://rs.gbif.org/vocabulary/gbif/type_status" .

bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Alien-Species a bdqffdq:UseCase ;
    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:63b0193f-a8df-4345-8d60-caf667cd62b0> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF TypeStatus Vocabulary\"" ;
    bdqffdq:hasArgumentValue "GBIF TypeStatus Vocabulary" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:63b75539-9290-4ce4-86e3-938bc924e3cd> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:typeStatus" ;
    skos:prefLabel "Information Element ActedUpon dwc:typeStatus" ;
    bdqffdq:composedOf dwc:typeStatus .

<urn:uuid:e4dbf38d-bdd7-4cf7-8c60-5b3bfc6af4ff> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_TYPESTATUS_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:typeStatus is bdqval:Empty; COMPLIANT if the value of the first word in each &#124; delimited portion of dwc:typeStatus is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"GBIF TypeStatus Vocabulary\" {[https://api.gbif.org/v1/vocabularies/TypeStatus]} {dwc:typeStatus vocabulary API [https://api.gbif.org/v1/vocabularies/TypeStatus/concepts]}" ;
    skos:example "dwc:typeStatus=\"Holotype\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:typeStatus found in the bdqval:sourceAuthority\"",
        "dwc:typeStatus=\"cleptotype\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:typeStatus not found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:63b0193f-a8df-4345-8d60-caf667cd62b0> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF TypeStatus Vocabulary\" {[https://api.gbif.org/v1/vocabularies/TypeStatus]} {dwc:typeStatus vocabulary API [https://api.gbif.org/v1/vocabularies/TypeStatus/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:typeStatus is bdqval:Empty; COMPLIANT if the value of the first word in each &#124; delimited portion of dwc:typeStatus is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<https://rs.tdwg.org/bdqtest/terms/version/4833a522-12eb-4fe0-b4cf-7f7a337a6048-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_TYPESTATUS_STANDARD" ;
    dcterms:description "Does the value of dwc:typeStatus occur in bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:4833a522-12eb-4fe0-b4cf-7f7a337a6048 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <http://rs.gbif.org/vocabulary/gbif/type_status> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/285" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:typeStatus Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:63b75539-9290-4ce4-86e3-938bc924e3cd> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-11-11"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

