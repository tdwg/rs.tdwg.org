<urn:uuid:f84d0f30-9c93-43a4-8f75-8c853fc18fb5> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_TYPESTATUS_STANDARD with Specification for: VALIDATION_TYPESTATUS_STANDARD" ;
    skos:historyNote "Source: ALA, GBIF" ;
