<urn:uuid:9d387033-c581-4fb5-9af2-73ec89c99e77> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:decimalLatitude, dwc:decimalLongitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:decimalLatitude, dwc:decimalLongitude" ;
    bdqffdq:composedOf dwc:decimalLatitude,
        dwc:decimalLongitude .

<urn:uuid:b482148e-9ac2-47ad-99b5-462508e9f360> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COORDINATES_NOTZERO" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLatitude is bdqval:Empty or is not interpretable as a number, or dwc:decimalLongitude is bdqval:Empty or is not interpretable as a number; COMPLIANT if either the value of dwc:decimalLatitude is not = 0 or the value of dwc:decimalLongitude is not = 0; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:decimalLatitude=\"0\", dwc:decimalLongitude=\"0\",: Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLatitude and dwc:decimalLongitude are zero\"",
        "dwc:decimalLatitude=\"21.0534\", dwc:decimalLongitude=\"81.0554\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLatitude and dwc:decimalLongitude are not zero\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLatitude is bdqval:Empty or is not interpretable as a number, or dwc:decimalLongitude is bdqval:Empty or is not interpretable as a number; COMPLIANT if either the value of dwc:decimalLatitude is not = 0 or the value of dwc:decimalLongitude is not = 0; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/1bf0e210-6792-4128-b8cc-ab6828aa4871-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COORDINATES_NOTZERO" ;
    dcterms:description "Are the values of either dwc:decimalLatitude or dwc:decimalLongitude numbers that are not equal to 0?" ;
    dcterms:isVersionOf bdqtest:1bf0e210-6792-4128-b8cc-ab6828aa4871 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/87" ;
    skos:note "A record with 0.0 is interpreted as the string \"0\"." ;
    skos:prefLabel "Validation Coordinates Not Zero for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:9d387033-c581-4fb5-9af2-73ec89c99e77> ;
    bdqffdq:hasCriterion bdqcrit:Likely ;
    bdqffdq:hasDataQualityDimension bdqdim:Likeliness ;
    bdqffdq:hasDateLastUpdated "2023-06-20"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

