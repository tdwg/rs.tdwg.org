  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:74716bc2-c82e-49f3-938b-2298094554b4">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:sourceAuthority:"Regex present/absent"</rdfs:label>
