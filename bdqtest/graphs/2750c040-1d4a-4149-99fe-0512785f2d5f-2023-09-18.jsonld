  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/2750c040-1d4a-4149-99fe-0512785f2d5f-2023-09-18",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Validation"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Is the combination of higher classification taxonomic terms consistent using bdqval:sourceAuthority?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/2750c040-1d4a-4149-99fe-0512785f2d5f"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-09-18"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://doi.org/10.15468/39omei"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_CLASSIFICATION_CONSISTENT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/123"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "A fail condition may arise either from the taxon terms being internally inconsistent (not all of the information can be true at the same time), or from the vocabulary being incapable of resolving the combination of classification values. Additional Tests could be devised against a taxonomic authority to report the distinct failure conditions. This Test specifically does not consider the content of dwc:higherClassification. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Validation Classification Consistent for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
