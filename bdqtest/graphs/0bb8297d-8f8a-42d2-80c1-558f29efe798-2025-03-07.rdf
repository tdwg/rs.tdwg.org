  <rdf:Description rdf:about="urn:uuid:af5393af-6a71-4e39-aa70-7609ee10d1d0">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:minimumElevationInMeters</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:minimumElevationInMeters</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/minimumElevationInMeters"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqval/terms/minimumValidElevationInMeters">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Parameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/InRange">
