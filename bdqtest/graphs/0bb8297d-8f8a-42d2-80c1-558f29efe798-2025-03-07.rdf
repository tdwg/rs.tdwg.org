  <rdf:Description rdf:about="urn:uuid:307b78fe-e168-422b-977f-cdb4e1c5e636">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:maximumValidElevationInMeters:"8850"</rdfs:label>
    <bdqffdq:hasArgumentValue>8850</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/maximumValidElevationInMeters"/>
