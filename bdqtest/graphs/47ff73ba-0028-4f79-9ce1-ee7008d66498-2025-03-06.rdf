  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/47ff73ba-0028-4f79-9ce1-ee7008d66498-2025-03-06">
    <dcterms:description>Is the value of dwc:day an integer between 1 and 31 inclusive?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/47ff73ba-0028-4f79-9ce1-ee7008d66498"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-06</dcterms:issued>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_DAY_STANDARD</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/147</skos:historyNote>
    <skos:note>This is part of a group of similar Tests (VALIDATION_DAY_INRANGE (8d787cb5-73e2-4c39-9cd1-67c7361dc02e), VALIDATION_STARTDAYOFYEAR_INRANGE (85803c7e-2a5a-42e1-b8d3-299a44cafc46), VALIDATION_ENDDAYOFYEAR_INRANGE (9a39d88c-7eee-46df-b32a-c109f9f81fb8)).</skos:note>
    <skos:prefLabel>Validation dwc:day Standard for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:d7853c0b-2e3a-4bbf-89c6-89123ca626bf"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/Standard"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:d7853c0b-2e3a-4bbf-89c6-89123ca626bf">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:day</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:day</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/day"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/Standard">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Criterion"/>
    <rdfs:label>Standard</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:c0fce1a1-8879-4175-8a71-ce037655c358">
    <dcterms:description>INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; COMPLIANT if the value of the field dwc:day is an integer between 1 and 31 inclusive; otherwise NOT_COMPLIANT.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_DAY_STANDARD</rdfs:label>
    <skos:example>dwc:day="15": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dwc:day is in range"</skos:example>
    <skos:example>dwc:day="32": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dwc:day is not in range"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; COMPLIANT if the value of the field dwc:day is an integer between 1 and 31 inclusive; otherwise NOT_COMPLIANT.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:d9bfd4f7-e158-43ee-8ac4-1bc51bf33307">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_DAY_STANDARD with Specification for: VALIDATION_DAY_STANDARD</rdfs:label>
    <skos:historyNote>Source: TDWG2018 DQIG Meeting; TG2-Gainesville</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/event_date_qc/blob/v3.0.5/src/main/java/org/filteredpush/qc/date/DwCEventDQ.java#L639</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush event_date_qc Library (Morris &amp; Lowery 2025)</skos:note>
    <skos:note>TG2 Validation TIME CODED Test Conformance CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_DAY_STANDARD with Specification for: VALIDATION_DAY_STANDARD</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/47ff73ba-0028-4f79-9ce1-ee7008d66498-2025-03-06"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:c0fce1a1-8879-4175-8a71-ce037655c358"/>
  </rdf:Description>
