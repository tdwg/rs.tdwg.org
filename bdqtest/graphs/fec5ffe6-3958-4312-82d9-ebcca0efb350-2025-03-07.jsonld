      {
        "@value": "https://github.com/tdwg/bdq/issues/48"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "This Test supports conformance with the recommendation in the comment on dwc:countryCode: \"Recommended best practice is to use an ISO 3166-1-alpha-2 country code.\" Darwin Core also recommends the use of the XZ for high seas and ZZ for unknown. Three letter codes should be amended to the matching two-letter code."
      }
    ],
