<urn:uuid:42f331f4-a5a8-48b4-a08e-57048d1d1a77> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_YEAR_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:year is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:year=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:year is bdqval:Empty\"",
        "dwc:year=\"1949\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:year is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:year is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

