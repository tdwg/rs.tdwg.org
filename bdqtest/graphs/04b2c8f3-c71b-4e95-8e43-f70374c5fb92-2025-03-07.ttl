bdqcrit:InRange a bdqffdq:Criterion ;
    rdfs:label "InRange" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Spatial-Temporal_Patterns a bdqffdq:UseCase ;
    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

bdqval:maximumValidDepthInMeters a bdqffdq:Parameter .

bdqval:minimumValidDepthInMeters a bdqffdq:Parameter .

<urn:uuid:9f12e2c3-17ac-42c0-91f4-c40a02d3f133> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:maximumValidDepthInMeters:\"11000\"" ;
    bdqffdq:hasArgumentValue "11000" ;
    bdqffdq:hasParameter bdqval:maximumValidDepthInMeters .

<urn:uuid:d23e61b3-07b6-4326-bac2-1457b030efef> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:minimumValidDepthInMeters:\"0\"" ;
    bdqffdq:hasArgumentValue "0" ;
    bdqffdq:hasParameter bdqval:minimumValidDepthInMeters .

<urn:uuid:f3e03531-7ee5-4721-aae2-f554389e0544> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MINDEPTH_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters is bdqval:Empty, or the value is not interpretable as number greater than or equal to zero; COMPLIANT if the value of dwc:minimumDepthInMeters is within the range of bdqval:minimumValidDepthInMeters to bdqval:maximumValidDepthInMeters inclusive; otherwise NOT_COMPLIANT bdqval:minimumValidDepthInMeters default=\"0\",bdqval:maximumValidDepthInMeters default=\"11000\"" ;
    skos:example "dwc:minimumDepthInMeters=\"1\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:minimumDepthInMeters is in range\"",
        "dwc:minimumDepthInMeters=\"12000\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:minimumDepthInMeters is not in range\"" ;
    bdqffdq:hasArgument <urn:uuid:9f12e2c3-17ac-42c0-91f4-c40a02d3f133>,
        <urn:uuid:d23e61b3-07b6-4326-bac2-1457b030efef> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:minimumValidDepthInMeters default=\"0\",bdqval:maximumValidDepthInMeters default=\"11000\"" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters is bdqval:Empty, or the value is not interpretable as number greater than or equal to zero; COMPLIANT if the value of dwc:minimumDepthInMeters is within the range of bdqval:minimumValidDepthInMeters to bdqval:maximumValidDepthInMeters inclusive; otherwise NOT_COMPLIANT" .

<urn:uuid:fc3cb031-4e35-4b08-b9b8-b7ca7d5efd27> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:minimumDepthInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:minimumDepthInMeters" ;
    bdqffdq:composedOf dwc:minimumDepthInMeters .

<https://rs.tdwg.org/bdqtest/terms/version/04b2c8f3-c71b-4e95-8e43-f70374c5fb92-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MINDEPTH_INRANGE" ;
    dcterms:description "Is the value of dwc:minimumDepthInMeters within the Parameter range?" ;
    dcterms:isVersionOf bdqtest:04b2c8f3-c71b-4e95-8e43-f70374c5fb92 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/Extreme_points_of_Earth> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/107" ;
    skos:note "The Challenger Deep in the Mariana Trench is the deepest known point in Earth's oceans at 10,994 meters below sea level. We have rounded up bdqval:maximumValidDepthInMeters." ;
    skos:prefLabel "Validation dwc:minimumDepthInMeters In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:fc3cb031-4e35-4b08-b9b8-b7ca7d5efd27> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

