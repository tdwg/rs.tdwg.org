  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/45fb49eb-4a1b-4b49-876f-15d5034dfc73-2026-11-12">
    <dcterms:description>A count of the distinct VALIDATION Tests run on a record that have Response.result=COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/45fb49eb-4a1b-4b49-876f-15d5034dfc73"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</dcterms:issued>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MEASURE_VALIDATIONTESTS_COMPLIANT</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/135</skos:historyNote>
    <skos:note>We have three individual measures for pass (MEASURE_VALIDATIONTESTS_COMPLIANT (45fb49eb-4a1b-4b49-876f-15d5034dfc73)), fail (MEASURE_VALIDATIONTESTS_NOTCOMPLIANT (453844ae-9df4-439f-8e24-c52498eca84a)), and PREREQUISITES_NOT_MET (49a94636-a562-4e6b-803c-665c80628a3d). To get the total number of Tests that were attempted, add all three measures. To get the total number of Tests that ran, add NOT_COMPLIANT (fail) and COMPLIANT (pass). If no VALIDATION Tests were run on the record, the result is 0.</skos:note>
    <skos:prefLabel>Measure Validation Tests Compliant for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Reliability"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:d25368be-5f39-4a47-adf3-9c1293499599">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MeasurementMethod"/>
    <rdfs:label>MeasurementMethod: MEASURE_VALIDATIONTESTS_COMPLIANT with Specification Specification for: MEASURE_VALIDATIONTESTS_COMPLIANT</rdfs:label>
    <skos:historyNote>Source: TG2-Gainesville</skos:historyNote>
    <skos:note>TG2 Measure NAME SPACE OTHER Test CORE</skos:note>
    <skos:prefLabel>MeasurementMethod: MEASURE_VALIDATIONTESTS_COMPLIANT with Specification Specification for: MEASURE_VALIDATIONTESTS_COMPLIANT</skos:prefLabel>
    <bdqffdq:forMeasure rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/45fb49eb-4a1b-4b49-876f-15d5034dfc73-2026-11-12"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:b611e1b1-cbf5-405c-b24d-24e9a649cbf0"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon bdqval:AllValidationTestsRunOnSingleRecord</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon bdqval:AllValidationTestsRunOnSingleRecord</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="https://rs.tdwg.org/bdqval/terms/AllValidationTestsRunOnSingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:b611e1b1-cbf5-405c-b24d-24e9a649cbf0">
    <dcterms:description>RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=COMPLIANT.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: MEASURE_VALIDATIONTESTS_COMPLIANT</rdfs:label>
    <skos:example>[Response.status=RUN_HAS_RESULT, Response.result="7", Response.comment="7 VALIDATION Tests had Response.result=COMPLIANT."]</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=COMPLIANT.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
