bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:74716bc2-c82e-49f3-938b-2298094554b4> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Regex present/absent\"" ;
    bdqffdq:hasArgumentValue "Regex present/absent" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:occurrenceStatus" ;
    skos:prefLabel "Information Element ActedUpon dwc:occurrenceStatus" ;
    bdqffdq:composedOf dwc:occurrenceStatus .

<urn:uuid:fbe854d4-acf3-4c79-a654-81441fed644f> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_OCCURRENCESTATUS_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:Empty; COMPLIANT if the value of dwc:occurrenceStatus is resolved in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    skos:example "dwc:occurrenceStatus=\"presence\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:occurrenceStatus does not match a term in the bdqval:sourceAuthority\"",
        "dwc:occurrenceStatus=\"present\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:occurrenceStatus matches a term in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:74716bc2-c82e-49f3-938b-2298094554b4> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:Empty; COMPLIANT if the value of dwc:occurrenceStatus is resolved in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/7af25f1e-a4e2-4ff4-b161-d1f25a5c3e47-2025-02-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_OCCURRENCESTATUS_STANDARD" ;
    dcterms:description "Does the value of dwc:occurrenceStatus occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:7af25f1e-a4e2-4ff4-b161-d1f25a5c3e47 ;
    dcterms:issued "2025-02-18"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/116" ;
    skos:note "The recommended controlled vocabulary for this term consists of \"present\" and \"absent\", which are the only two appropriate terms for a Darwin Core Occurrence. This is reflected in the dwc:occurrenceStatus vocabulary for this Test. There is currently a mismatch between the (authoritative) lower case values at https://dwc.tdwg.org/terms/#dwc:occurrenceStatus and the vocabulary at GBIF (https://api.gbif.org/v1/vocabularies/OccurrenceStatus/concepts), which capitalized the first character. This Test must return NOT_COMPLIANT if there are case differences, leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:occurrenceStatus Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2025-02-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

