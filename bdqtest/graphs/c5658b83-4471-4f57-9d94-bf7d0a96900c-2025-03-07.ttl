<urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters" ;
    bdqffdq:composedOf dwc:maximumDepthInMeters,
        dwc:minimumDepthInMeters .

<urn:uuid:4db033ea-b0f7-4d01-a5fc-a0459a73a67d> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_MINDEPTHMAXDEPTH_FROM_VERBATIM" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters are bdqval:NotEmpty or dwc:verbatimDepth is bdqval:Empty; FILLED_IN the value of dwc:minimumDepthInMeters and dwc:maximumDepthInMeters if they can be unambiguously interpreted from dwc:verbatimDepth; otherwise NOT_AMENDED." ;
    skos:example " dwc:minimumDepthInMeters=\"\", dwc:maximumDepthInMeters=\"\", dwc:verbatimDepth=\"x\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:verbatimDepth does not contain an interpretable value\"",
        "dwc:minimumDepthInMeters=\"\", dwc:maximumDepthInMeters=\"\", dwc:verbatimDepth=\"10 feet\": Response.status=FILLED_IN, Response.result=dwc:minimumDepthInMeters=\"3.048\", dwc:maximumDepthInMeters=\"3.048\", Response.comment=\"dwc:verbatimDepth contains interpretable values\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters are bdqval:NotEmpty or dwc:verbatimDepth is bdqval:Empty; FILLED_IN the value of dwc:minimumDepthInMeters and dwc:maximumDepthInMeters if they can be unambiguously interpreted from dwc:verbatimDepth; otherwise NOT_AMENDED." .

<urn:uuid:6ce80718-30e4-4458-beb3-6b03d30f66ed> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted dwc:verbatimDepth" ;
    skos:prefLabel "Information Element Consulted dwc:verbatimDepth" ;
    bdqffdq:composedOf dwc:verbatimDepth .

<https://rs.tdwg.org/bdqtest/terms/version/c5658b83-4471-4f57-9d94-bf7d0a96900c-2025-03-07> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_MINDEPTHMAXDEPTH_FROM_VERBATIM" ;
    dcterms:description "Proposes amendments of the values of dwc:minimumDepthInMeters and dwc:maximumDepthInMeters if they can be interpreted from dwc:verbatimDepth." ;
    dcterms:isVersionOf bdqtest:c5658b83-4471-4f57-9d94-bf7d0a96900c ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/55" ;
    skos:note "If dwc:verbatimDepth has a single value rather than a range, the minimum and maximum values should be amended with the same value. When transforming units, the transformation should be reversible, not adjusting the number of significant digits or adjusting the rounding. For example, transform fathoms to meters by multiplying by 1.8288 and retaining added significant digits (verbatim depth of 10 fathoms to minimum and maximum depths in meters of 18.288). Implementations should be capable of interpreting verbatim data in at least meters, fathoms, and feet, in the form of either a single value or a range. The units must be specified in the verbatim data to be interpretable." ;
    skos:prefLabel "Amendment dwc:minimumDepthInMeters dwc:maximumDepthInMeters from dwc:verbatimDepth for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617> ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:6ce80718-30e4-4458-beb3-6b03d30f66ed> ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-08-30"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:FilledInFrom ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

