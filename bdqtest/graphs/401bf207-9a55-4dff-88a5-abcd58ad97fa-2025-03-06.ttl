<urn:uuid:02242018-3e73-4e0a-8d6f-d1db06cf81a3> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_SCIENTIFICNAMEID_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:scientificNameID is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:scientificNameID=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificNameID is bdqval:Empty\"",
        "dwc:scientificNameID=\"8fa58e08-08de-4ac1-b69c-1235340b7001\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:scientificNameID is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:scientificNameID is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

