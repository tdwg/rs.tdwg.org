    <rdfs:label>bdquc:Spatial-Temporal_Patterns</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqval/terms/includeEventDate">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Parameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.iso.org/obp/ui/">
    <dcterms:bibliographicCitation>ISO (2019) ISO 8601-1:2019(en) Date and time — Representations for information interchange — Part 1: Basic rules. https://www.iso.org/obp/ui/</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/InRange">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Criterion"/>
    <rdfs:label>InRange</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:e4f1fc86-c84d-4e92-9cf2-5250f243b371">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:dateIdentified</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:dateIdentified</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/dateIdentified"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:030797c0-0b00-4272-9219-16d701e9da7c">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:latestValidDate:"{current day}"</rdfs:label>
    <bdqffdq:hasArgumentValue>{current day}</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/latestValidDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.loc.gov/standards/datetime/">
    <dcterms:bibliographicCitation>Library of Congress (2019) Extended Date/Time Format (EDTF). https://www.loc.gov/standards/datetime/</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqval/terms/latestValidDate">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Parameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqffdq/terms/SingleRecord">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ResourceType"/>
