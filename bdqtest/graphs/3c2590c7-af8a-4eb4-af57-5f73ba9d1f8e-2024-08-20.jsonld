  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/3c2590c7-af8a-4eb4-af57-5f73ba9d1f8e-2024-08-20",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to the values of dwc:decimalLatitude, dwc:decimalLongitude, and dwc:geodeticDatum from geographic coordinate information in the verbatim coordinates terms."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/3c2590c7-af8a-4eb4-af57-5f73ba9d1f8e"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-08-20"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://doi.org/10.15468/doc-gg7h-s853"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_COORDINATES_FROM_VERBATIM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/32"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Transformations between coordinate reference systems should not be made as a part of this Test. Though coordinate precision of the verbatim coordinates could also be interpreted during the process of amending decimal coordinates from verbatim coordinates, that amendment is recommended to be an independent Test. Note that dwc:verbatimLatitude, dwc:verbatimLongitude and dwc:verbatimCoordinates might all be populated, and they may or not be perfectly consistent with each other. An ideal implementation should check for the consistency of these three fields and not amend them if they are inconsistent."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment Coordinates from Verbatim for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
