    <rdfs:label>Information Element Consulted dwc:verbatimElevation</rdfs:label>
    <skos:prefLabel>Information Element Consulted dwc:verbatimElevation</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/verbatimElevation"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/maximumElevationInMeters"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/minimumElevationInMeters"/>
  </rdf:Description>
