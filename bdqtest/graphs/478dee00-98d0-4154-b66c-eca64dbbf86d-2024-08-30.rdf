  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/478dee00-98d0-4154-b66c-eca64dbbf86d-2024-08-30">
    <dcterms:description>Measure if all VALIDATION_COORDINATESTERRESTRIALMARINE_CONSISTENT in a record set are COMPLIANT.</dcterms:description>
