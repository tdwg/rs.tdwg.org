<rdf:RDF
   xmlns:bdqffdq="https://rs.tdwg.org/bdqffdq/terms/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/d708526b-6561-438e-aa1a-82cd80b06396-2023-09-18">
    <dcterms:description>Is the value of dwc:minimumElevationInMeters a number less than or equal to the value of dwc:maximumElevationInMeters?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/d708526b-6561-438e-aa1a-82cd80b06396"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.15468/doc-gg7h-s853"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/108</skos:historyNote>
    <skos:note></skos:note>
    <skos:prefLabel>Validation dwc:minimumElevationInMeters less than dwcmaximumElevationInMeters for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/Consistent"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/maximumElevationInMeters"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/minimumElevationInMeters"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:a0486e4f-210d-4143-ae5a-f320bebc2cb5">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION with Specification for: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION</rdfs:label>
    <skos:historyNote>Source: @Tasilee</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2497</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris &amp; Lowery 2025b)</skos:note>
    <skos:note>TG2 Validation SPACE CODED Test Conformance CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION with Specification for: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/d708526b-6561-438e-aa1a-82cd80b06396-2023-09-18"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:f799fb5c-37e4-46d7-a07e-87eb071df9c6"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:f799fb5c-37e4-46d7-a07e-87eb071df9c6">
    <dcterms:description>INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION</rdfs:label>
    <skos:example>dwc:minimumElevationInMeters="0", dwc:maximumElevationInMeters="0": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dwc:minimumElevationInMeters is equal to dwc: maximumElevationInMeters"</skos:example>
    <skos:example>dwc:minimumElevationInMeters="1", dwc:maximumElevationInMeters="0": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dwc:minimumElevationInMeters is greater than dwc:maximumElevationInMeters"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:0348eccf-fc7f-49b3-88b6-1d911e98cbbb">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationPolicy"/>
    <rdfs:label>ValidationPolicy: (30) validations  in UseCase bdquc:Spatial-Temporal_Patterns</rdfs:label>
    <skos:prefLabel>ValidationPolicy: (30) validations  in UseCase bdquc:Spatial-Temporal_Patterns</skos:prefLabel>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/d708526b-6561-438e-aa1a-82cd80b06396-2023-09-18"/>
  </rdf:Description>
