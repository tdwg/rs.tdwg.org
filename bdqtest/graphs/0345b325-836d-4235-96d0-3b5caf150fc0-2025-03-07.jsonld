  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/0345b325-836d-4235-96d0-3b5caf150fc0-2025-03-07",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to the value of dwc:geodeticDatum using the bdqval:sourceAuthority."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/0345b325-836d-4235-96d0-3b5caf150fc0"
      }
    ],
