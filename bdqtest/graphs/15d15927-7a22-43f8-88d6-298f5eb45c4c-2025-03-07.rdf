  <rdf:Description rdf:about="https://rs.tdwg.org/bdquc/terms/Alien-Species">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/UseCase"/>
    <rdfs:label>bdquc:Alien-Species</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/15d15927-7a22-43f8-88d6-298f5eb45c4c-2025-03-07">
    <dcterms:description>Proposes an amendment to the value of dwc:establishmentMeans using the bdqval:sourceAuthority.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/15d15927-7a22-43f8-88d6-298f5eb45c4c"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-07</dcterms:issued>
    <dcterms:references rdf:resource="http://rs.tdwg.org/dwc/doc/em/"/>
    <dcterms:references rdf:resource="https://doi.org/10.3897/biss.3.38084"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Amendment"/>
    <rdfs:label>AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/269</skos:historyNote>
    <skos:note></skos:note>
    <skos:prefLabel>Amendment dwc:establishmentMeans Standardized for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:09023be7-9359-48a8-873b-3e65d43427ba"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-08</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasEnhancement rdf:resource="https://rs.tdwg.org/bdqenh/terms/Standardized"/>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:fcd9e46a-a31e-47f5-a18a-bb7ee5d1394a">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentMethod"/>
    <rdfs:label>AmendmentMethod: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED with Specification Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED</rdfs:label>
    <skos:historyNote>Source: TG2</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L1502</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)</skos:note>
    <skos:note>TG2 Amendment OTHER CODED Test VOCABULARY Conformance Parameterized CORE</skos:note>
    <skos:prefLabel>AmendmentMethod: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED with Specification Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED</skos:prefLabel>
    <bdqffdq:forAmendment rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/15d15927-7a22-43f8-88d6-298f5eb45c4c-2025-03-07"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:fa4e531e-f45e-4dea-8c4b-27d364117808"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:sourceAuthority:"Establishment Means Controlled Vocabulary List of Terms"</rdfs:label>
    <bdqffdq:hasArgumentValue>Establishment Means Controlled Vocabulary List of Terms</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/sourceAuthority"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:bf24b955-7497-4d9e-b42e-2706e5bf0d48">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentPolicy"/>
    <rdfs:label>AmendmentPolicy: (10) amendments  in UseCase bdquc:Alien-Species</rdfs:label>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Alien-Species"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/15d15927-7a22-43f8-88d6-298f5eb45c4c-2025-03-07"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:09023be7-9359-48a8-873b-3e65d43427ba">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:establishmentMeans</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:establishmentMeans</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/establishmentMeans"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:fa4e531e-f45e-4dea-8c4b-27d364117808">
    <dcterms:description>EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = "Establishment Means Controlled Vocabulary List of Terms" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED</rdfs:label>
    <skos:example>dwc:establishmentMeans="cultivated": Response.status=NOT_AMENDED, Response.result="", Response.comment="dwc:establishmentMeans is not an interpretable value in the bdqval:sourceAuthority"</skos:example>
    <skos:example>dwc:establishmentMeans="vag.": Response.status=AMENDED, Response.result=dwc:establishmentMeans="vagrant", Response.comment="dwc:establishmentMeans contains an interpretable value in the bdqval:sourceAuthority"</skos:example>
    <bdqffdq:hasArgument rdf:resource="urn:uuid:17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1"/>
    <bdqffdq:hasAuthoritiesDefaults>bdqval:sourceAuthority default = "Establishment Means Controlled Vocabulary List of Terms" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}</bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqdim/terms/Conformance">
