  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/1919f212-b7db-4b6e-9697-41a715001bd6-2025-03-06">
    <dcterms:description>Count the number of VALIDATION_EVENT_CONSISTENT in a record set that are COMPLIANT.</dcterms:description>
