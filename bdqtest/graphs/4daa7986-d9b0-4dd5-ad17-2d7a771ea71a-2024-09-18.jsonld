  {
    "@id": "urn:uuid:41461142-2c1e-4fc1-bc97-f83a7b2a893d",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Argument"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Default value for bdqval:sourceAuthority:\"The Getty Thesaurus of Geographic Names (TGN)\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgumentValue": [
      {
        "@value": "The Getty Thesaurus of Geographic Names (TGN)"
      }
    ],
