<urn:uuid:7e365897-cfc0-413e-a613-99c6050edc4b> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_AMENDMENTS_PROPOSED" ;
    dcterms:description "The number of Tests of output type AMENDMENT that have been run against the record and have proposed changes to the record (Result.status=\"AMENDED\" or \"FILLED_IN\")" ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"17\", Response.comment=\"17 Tests of TYPE AMENDMENT were run and proposed changes to the record.\"]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "The number of Tests of output type AMENDMENT that have been run against the record and have proposed changes to the record (Result.status=\"AMENDED\" or \"FILLED_IN\")" .

