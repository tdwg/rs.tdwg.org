    dcterms:issued "2024-09-18"^^xsd:date ;
    dcterms:references <https://dwc.tdwg.org/pw/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/278" ;
    skos:note "For reference, synonyms for values of dwc:pathway can be found at https://registry.gbif.org/vocabulary/Pathway/concepts." ;
    skos:prefLabel "Amendment dwc:pathway Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:f3141ff8-76fa-4953-9c6c-9300816358cc> ;
