    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:0a7b3629-ecd9-47d2-b672-44ef47e03f7b> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Pathway Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Pathway Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:f3141ff8-76fa-4953-9c6c-9300816358cc> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:pathway" ;
    skos:prefLabel "Information Element ActedUpon dwc:pathway" ;
    bdqffdq:composedOf dwc:pathway .

<urn:uuid:fef3a7f9-edd8-41c9-9704-4798814077e3> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_PATHWAY_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:pathway is bdqval:Empty; AMENDED the value of dwc:pathway if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Pathway Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/pw/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/Pathway/concepts]}" ;
    skos:example "dwc:pathway=\"escapeee\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:pathway not found in the bdqval:sourceAuthority\"",
        "dwc:pathway=\"transportStowaway\": Response.status=AMENDED, Response.result=dwc:pathway=\"transportStowaway\", Response.comment=\"dwc:pathway found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:0a7b3629-ecd9-47d2-b672-44ef47e03f7b> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Pathway Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/pw/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/Pathway/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:pathway is bdqval:Empty; AMENDED the value of dwc:pathway if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<https://rs.tdwg.org/bdqtest/terms/version/f9205977-f145-44f5-8cb9-e3e2e35ce908-2024-09-18> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_PATHWAY_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:pathway using the bdqval:sourceAuthority." ;
