  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/3136236e-04b6-49ea-8b34-a65f25e3aba1-2025-03-07",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Validation"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Does the value of dcterms:license occur in bdqval:sourceAuthority?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/3136236e-04b6-49ea-8b34-a65f25e3aba1"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-03-07"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://creativecommons.org/licenses/"
      },
      {
        "@id": "https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_LICENSE_STANDARD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/38"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The license at the record level might be derived from the license of the dataset from which the record is retrieved. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters. The canonical form of the Creative Commons license IRI has nothing after the version (e.g., https://creativecommons.org/licenses/by/4.0/), but may be followed by deed or legalcode e.g. https://creativecommons.org/licenses/by/4.0/deed and this may be followed by a language code. However, only some two-letter language codes have translations, and some translations are identified by a longer string than the two-letter language code. Errors in the language code, or specifying a language code for which a translation doesn't exist returns a 404 error instead of redirecting to the more general license IRI. As of 2024-02-28 deed.mi doesn't exist yet, but legalcode.mi does."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Validation dcterms:license Standard for SingleRecord"
      }
    ],
