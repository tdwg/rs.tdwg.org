bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:09023be7-9359-48a8-873b-3e65d43427ba> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:establishmentMeans" ;
    skos:prefLabel "Information Element ActedUpon dwc:establishmentMeans" ;
    bdqffdq:composedOf dwc:establishmentMeans .

<urn:uuid:17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Establishment Means Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Establishment Means Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:fa4e531e-f45e-4dea-8c4b-27d364117808> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    skos:example "dwc:establishmentMeans=\"cultivated\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:establishmentMeans is not an interpretable value in the bdqval:sourceAuthority\"",
        "dwc:establishmentMeans=\"vag.\": Response.status=AMENDED, Response.result=dwc:establishmentMeans=\"vagrant\", Response.comment=\"dwc:establishmentMeans contains an interpretable value in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

