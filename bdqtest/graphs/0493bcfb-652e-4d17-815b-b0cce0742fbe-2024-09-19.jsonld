  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/0493bcfb-652e-4d17-815b-b0cce0742fbe-2024-09-19",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Validation"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Is the value of dwc:countryCode a valid ISO 3166-1-alpha-2 country code?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/0493bcfb-652e-4d17-815b-b0cce0742fbe"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-09-19"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://datahub.io/core/country-list"
      },
      {
        "@id": "https://doi.org/10.15468/doc-gg7h-s853"
      },
      {
        "@id": "https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2"
      },
      {
        "@id": "https://www.iso.org/iso-3166-country-codes.html"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_COUNTRYCODE_STANDARD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/20"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Locations outside of a jurisdiction covered by a country code may have a value in the field dwc:countryCode, the ISO user defined codes include XZ used by the UN for installations on the high seas and recommended in Darwin Core to designate the high seas. Also available in the ISO user defined codes is ZZ, used by Darwin Core and GBIF to mark unknown countries. This Test should accept both XZ and ZZ as COMPLIANT country codes. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Validation dwc:countryCode Standard for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423"
      }
    ],
