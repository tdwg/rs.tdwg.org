  {
    "@id": "https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/UseCase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bdquc:Spatial-Temporal_Patterns"
      }
    ]
  },
  {
    "@id": "https://www.iso.org/iso-3166-country-codes.html",
    "@type": [
      "http://purl.org/dc/terms/BibliographicResource"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "ISO (n.dat.) ISO 3166 Country Codes. https://www.iso.org/iso-3166-country-codes.html"
      }
    ]
  },
  {
    "@id": "urn:uuid:01b96157-e4a1-4884-95d7-3bcfc5f3c047",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the dwc:countryCode is bdqval:Empty; COMPLIANT if dwc:countryCode can be unambiguously interpreted as a valid ISO 3166-1-alpha-2 country code in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"ISO 3166 Country Codes\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_COUNTRYCODE_STANDARD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:countryCode=\"GL\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:countryCode is a valid ISO (ISO 3166-1-alpha-2 country codes) value\""
      },
      {
        "@value": "dwc:countryCode=\"GRL\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:countryCode is NOT a valid ISO (ISO 3166-1-alpha-2 country codes) value\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"ISO 3166 Country Codes\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the dwc:countryCode is bdqval:Empty; COMPLIANT if dwc:countryCode can be unambiguously interpreted as a valid ISO 3166-1-alpha-2 country code in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT"
      }
    ]
  },
