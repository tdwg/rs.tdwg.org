<urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters" ;
    bdqffdq:composedOf dwc:maximumElevationInMeters,
        dwc:minimumElevationInMeters .

<urn:uuid:f799fb5c-37e4-46d7-a07e-87eb071df9c6> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT" ;
    skos:example "dwc:minimumElevationInMeters=\"0\", dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:minimumElevationInMeters is equal to dwc: maximumElevationInMeters\"",
        "dwc:minimumElevationInMeters=\"1\", dwc:maximumElevationInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:minimumElevationInMeters is greater than dwc:maximumElevationInMeters\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:maximumlevationInMeters or dwc:minimumElevationInMeters is bdqval:Empty, or if either is not a number; COMPLIANT if the value of dwc:minimumElevationInMeters is a number less than or equal to the value of the number dwc:maximumElevationInMeters, otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/d708526b-6561-438e-aa1a-82cd80b06396-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_MINELEVATION_LESSTHAN_MAXELEVATION" ;
    dcterms:description "Is the value of dwc:minimumElevationInMeters a number less than or equal to the value of dwc:maximumElevationInMeters?" ;
    dcterms:isVersionOf bdqtest:d708526b-6561-438e-aa1a-82cd80b06396 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
