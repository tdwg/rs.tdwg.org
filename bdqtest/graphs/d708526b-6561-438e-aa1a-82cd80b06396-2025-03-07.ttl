    skos:note "" ;
    skos:prefLabel "Validation dwc:minimumElevationInMeters less than dwcmaximumElevationInMeters for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

