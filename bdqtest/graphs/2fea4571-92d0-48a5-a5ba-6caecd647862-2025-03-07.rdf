  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/2fea4571-92d0-48a5-a5ba-6caecd647862-2025-03-07">
    <dcterms:description>Measure if all VALIDATION_OCCURRENCESTATUS_STANDARD in a record set are COMPLIANT.</dcterms:description>
