  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/specification/0782e4e5-010f-4e59-82d7-618a84ead70a">
    <dcterms:description>COMPLETE if every VALIDATION_BASISOFRECORD_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</dcterms:description>
    <dcterms:hasVersion rdf:resource="https://rs.tdwg.org/bdqtest/specification/version/0782e4e5-010f-4e59-82d7-618a84ead70a-2023-09-17"/>
