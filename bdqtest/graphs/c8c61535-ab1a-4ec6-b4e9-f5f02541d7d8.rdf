  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/c8c61535-ab1a-4ec6-b4e9-f5f02541d7d8">
    <dcterms:description>Measure if all VALIDATION_BASISOFRECORD_NOTEMPTY in a record set are COMPLIANT.</dcterms:description>
    <dcterms:hasVersion rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/c8c61535-ab1a-4ec6-b4e9-f5f02541d7d8-2026-11-17"/>
