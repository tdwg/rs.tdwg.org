    <owl:sameAs rdf:resource="urn:uuid:c8c61535-ab1a-4ec6-b4e9-f5f02541d7d8"/>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/295</skos:historyNote>
    <skos:note>For Quality Assurance, filter record set until this measure is COMPLETE.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord for QualityAssurance of Validation dwc:basisOfRecord Not Empty for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="https://rs.tdwg.org/bdqtest/informationelement/b90492ed-90da-4552-8ac0-e18e71db9d86"/>
