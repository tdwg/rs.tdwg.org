    <rdfs:label>Specification for: MULTIRECORD_MEASURE_QA_BASISOFRECORD_NOTEMPTY</rdfs:label>
    <owl:sameAs rdf:resource="urn:uuid:0782e4e5-010f-4e59-82d7-618a84ead70a"/>
    <skos:example></skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLETE if every VALIDATION_BASISOFRECORD_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
