    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/coordinateUncertaintyInMeters"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/Likely">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Criterion"/>
    <rdfs:label>Likely</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:9c0a82d5-4b24-4160-a000-ee9429bef8f7">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:spatialBufferInMeters:"5000"</rdfs:label>
    <bdqffdq:hasArgumentValue>5000</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/spatialBufferInMeters"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqval/terms/sourceAuthority">
