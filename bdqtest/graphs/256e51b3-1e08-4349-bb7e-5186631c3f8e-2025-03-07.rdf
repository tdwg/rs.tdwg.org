    <rdfs:label>Information Element ActedUpon dwc:countryCode, dwc:decimalLatitude, dwc:decimalLongitude</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:countryCode, dwc:decimalLatitude, dwc:decimalLongitude</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/countryCode"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/decimalLatitude"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/decimalLongitude"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:5be9ff68-1232-4f09-a3ef-5d78ccdecf8c">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Consulted"/>
