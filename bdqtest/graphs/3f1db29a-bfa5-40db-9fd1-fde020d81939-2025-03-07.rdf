  <rdf:Description rdf:about="urn:uuid:ed60f87e-7ab7-446a-8565-903dbe6408d2">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_MAXDEPTH_INRANGE with Specification for: VALIDATION_MAXDEPTH_INRANGE</rdfs:label>
    <skos:historyNote>Source: ALA, GBIF</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2726</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris &amp; Lowery 2025b)</skos:note>
    <skos:note>TG2 Validation SPACE CODED Test Conformance Parameterized CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_MAXDEPTH_INRANGE with Specification for: VALIDATION_MAXDEPTH_INRANGE</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/3f1db29a-bfa5-40db-9fd1-fde020d81939-2025-03-07"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:cebc8ba0-ca02-4f1e-830e-ec693bc628e4"/>
  </rdf:Description>
