  {
    "@id": "urn:uuid:fec2103b-5d46-4723-b2ec-8c8119b44aaf",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; COMPLIANT if the value of dwc:degreeOfEstablishment is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_DEGREEOFESTABLISHMENT_STANDARD"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:degreeOfEstablishment=\"cultivated\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:degreeOfEstablishment found in the bdqval:sourceAuthority\""
      },
      {
        "@value": "dwc:degreeOfEstablishment=\"grown in garden\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:degreeOfEstablishment not found in the bdqval:sourceAuthority\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:8aac7359-311a-405f-8117-79bb4873011d"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; COMPLIANT if the value of dwc:degreeOfEstablishment is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT."
      }
    ]
