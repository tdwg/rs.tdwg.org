<urn:uuid:0067fa60-5503-490e-8c94-93fb79cc7da2> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLATITUDE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:decimalLatitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:decimalLatitude=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:Empty\"",
        "dwc:decimalLatitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLatitude is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:decimalLatitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

