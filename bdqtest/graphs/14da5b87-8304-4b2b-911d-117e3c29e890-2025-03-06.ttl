<urn:uuid:c619ec9b-92ec-4047-a8d3-931e3324bf3e> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_TAXONRANK_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:taxonRank is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:taxonRank=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:taxonRank is bdqval:Empty\"",
        "dwc:taxonRank=\"genus\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:taxonRank is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:taxonRank is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

