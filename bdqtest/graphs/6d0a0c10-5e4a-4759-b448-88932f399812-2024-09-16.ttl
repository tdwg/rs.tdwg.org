<urn:uuid:697cf278-3c46-48f4-84ab-385a7cd9db3c> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted dwc:verbatimEventDate" ;
    skos:prefLabel "Information Element Consulted dwc:verbatimEventDate" ;
    bdqffdq:composedOf dwc:verbatimEventDate .

<urn:uuid:b417d971-8b0f-49ab-9431-3364ba8694e2> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_EVENTDATE_FROM_VERBATIM" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:NotEmpty or the value of dwc:verbatimEventDate is bdqval:Empty; FILLED_IN the value of dwc:eventDate if an unambiguous ISO 8601 date is interpreted from dwc:verbatimEventDate; otherwise NOT_AMENDED" ;
    skos:example "dwc:eventDate=\"\", dwc:verbatimEventDate=\"03/04/2020\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:verbatimEventDate is ambiguous - could be either 3rd April or 4th March\"",
        "dwc:eventDate=\"\", dwc:verbatimEventDate=\"Friday 29th Oct. 2021\": Response.status=FILLED_IN, Response.result=dwc:eventDate=\"2021-10-29\", Response.comment=\"dwc:verbatimEventDate contains an interpretable value (assuming some external lookup thesauri)\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:NotEmpty or the value of dwc:verbatimEventDate is bdqval:Empty; FILLED_IN the value of dwc:eventDate if an unambiguous ISO 8601 date is interpreted from dwc:verbatimEventDate; otherwise NOT_AMENDED" .

<urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:eventDate" ;
    skos:prefLabel "Information Element ActedUpon dwc:eventDate" ;
    bdqffdq:composedOf dwc:eventDate .

<https://rs.tdwg.org/bdqtest/terms/version/6d0a0c10-5e4a-4759-b448-88932f399812-2024-09-16> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_EVENTDATE_FROM_VERBATIM" ;
    dcterms:description "Proposes an amendment to the value of dwc:eventDate from the content of dwc:verbatimEventDate." ;
    dcterms:isVersionOf bdqtest:6d0a0c10-5e4a-4759-b448-88932f399812 ;
    dcterms:issued "2024-09-16"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/86" ;
    skos:note "If the proposed eventDate is prior to 1918-02-14, the Response.comment will include a note that the \"verbatimDate was assumed to be in the Gregorian calendar\". When running the Test, the original precision, e.g. year=1980, month=1 should be retained, e.g. dwc:eventDate should become 1980-01, not 1980-01-01/1980-01-31." ;
    skos:prefLabel "Amendment dwc:eventDate from dwc:verbatimEventDate for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:697cf278-3c46-48f4-84ab-385a7cd9db3c> ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:FilledInFrom ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

