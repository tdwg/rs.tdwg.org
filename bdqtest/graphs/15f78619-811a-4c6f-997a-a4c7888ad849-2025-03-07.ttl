<urn:uuid:d3daaab7-b042-4dc7-a92f-77f19988f351> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dcterms:license" ;
    skos:prefLabel "Information Element ActedUpon dcterms:license" ;
    bdqffdq:composedOf dcterms:license .

<urn:uuid:d8b450af-47e6-4f5c-8154-6d6acbe9efa5> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_LICENSE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dcterms:license is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dcterms:license=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dcterms:license is bdqval:Empty\"",
        "dcterms:license=\"CC0 1.0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dcterms:license is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dcterms:license is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

