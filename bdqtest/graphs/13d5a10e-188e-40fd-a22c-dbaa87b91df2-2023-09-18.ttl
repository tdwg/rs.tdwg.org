<urn:uuid:8c10d361-5bf7-4c9d-8464-c813cdf7dda3> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:dataGeneralizations" ;
    skos:prefLabel "Information Element ActedUpon dwc:dataGeneralizations" ;
    bdqffdq:composedOf dwc:dataGeneralizations .

<urn:uuid:90618419-452d-4f35-b39a-7c342ca0791b> a bdqffdq:Specification ;
    rdfs:label "Specification for: ISSUE_DATAGENERALIZATIONS_NOTEMPTY" ;
    dcterms:description "POTENTIAL_ISSUE if dwc:dataGeneralizations is bdqval:NotEmpty; otherwise NOT_ISSUE" ;
    skos:example "dwc:dataGeneralizations=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_ISSUE, Response.comment=\"dwc:dataGeneralizations is bdqval:Empty\"",
        "dwc:dataGeneralizations=\"placed on quarter degree grid\": Response.status=RUN_HAS_RESULT, Response.result=POTENTIAL_ISSUE, Response.comment=\"dwc:dataGeneralizations is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "POTENTIAL_ISSUE if dwc:dataGeneralizations is bdqval:NotEmpty; otherwise NOT_ISSUE" .

<https://rs.tdwg.org/bdqtest/terms/version/13d5a10e-188e-40fd-a22c-dbaa87b91df2-2023-09-18> a bdqffdq:Issue ;
    rdfs:label "ISSUE_DATAGENERALIZATIONS_NOTEMPTY" ;
    dcterms:description "Is there a value in dwc:dataGeneralizations?" ;
    dcterms:isVersionOf bdqtest:13d5a10e-188e-40fd-a22c-dbaa87b91df2 ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-5jp4-5g10>,
        <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/72" ;
    skos:note "This is not specific to spatial data, any value in the dwc:dataGeneralizations field will cause this flag to be raised, but the primary Use Case is expected to be that dwc:dataGeneralizations demonstrates obfuscated locations." ;
    skos:prefLabel "Issue dwc:dataGeneralizations Not Empty for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:8c10d361-5bf7-4c9d-8464-c813cdf7dda3> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Resolution ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

