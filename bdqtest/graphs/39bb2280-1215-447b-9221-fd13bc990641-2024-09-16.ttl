<https://en.wikipedia.org/wiki/ISO_8601> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Wikipedia (2020) ISO 8601. https://en.wikipedia.org/wiki/ISO_8601" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqenh:Standardized a bdqffdq:Enhancement ;
    rdfs:label "Standardized" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Spatial-Temporal_Patterns a bdqffdq:UseCase ;
    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

<https://www.iso.org/obp/ui/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "ISO (2019) ISO 8601-1:2019(en) Date and time — Representations for information interchange — Part 1: Basic rules. https://www.iso.org/obp/ui/" .

<https://www.loc.gov/standards/datetime/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Library of Congress (2019) Extended Date/Time Format (EDTF). https://www.loc.gov/standards/datetime/" .

<urn:uuid:16e40618-e9bd-479a-b1e8-8aee3467109f> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_DATEIDENTIFIED_STANDARDIZED" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; AMENDED if the value of dwc:dateIdentified is not a properly formatted ISO 8601 date but is unambiguous and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED." ;
    skos:example "dwc:dateIdentified=\"2021-28-10\": Response.status=AMENDED, Response.result=dwc:dateIdentified=\"2021-10-28\", Response.comment=\"dwc:dateIdentified assuming dwc:year, dwc:day and dwc:month\"",
        "dwc:dateIdentified=\"21-10-28\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:dateIdentified contains ambiguous values. It could be dd-mm-yy or yy-mm-dd\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; AMENDED if the value of dwc:dateIdentified is not a properly formatted ISO 8601 date but is unambiguous and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED." .

<urn:uuid:e4f1fc86-c84d-4e92-9cf2-5250f243b371> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:dateIdentified" ;
    skos:prefLabel "Information Element ActedUpon dwc:dateIdentified" ;
    bdqffdq:composedOf dwc:dateIdentified .

<https://rs.tdwg.org/bdqtest/terms/version/39bb2280-1215-447b-9221-fd13bc990641-2024-09-16> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_DATEIDENTIFIED_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:dateIdentified to a valid ISO date." ;
    dcterms:isVersionOf bdqtest:39bb2280-1215-447b-9221-fd13bc990641 ;
    dcterms:issued "2024-09-16"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/26" ;
    skos:note "We reference Wikipedia for the ISO standard because the standard documents are not free." ;
    skos:prefLabel "Amendment dwc:dateIdentified Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e4f1fc86-c84d-4e92-9cf2-5250f243b371> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

