  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/f2b4a50a-6b2f-4930-b9df-da87b6a21082-2025-03-07",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment transposing or changing the signs of dwc:decimalLatitude and/or dwc:decimalLongitude to align the location with the dwc:countryCode."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/f2b4a50a-6b2f-4930-b9df-da87b6a21082"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-03-07"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://doi.org/10.15468/doc-gg7h-s853"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_COORDINATES_TRANSPOSED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/54"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "The dwc:geodeticDatum is not necessary for this Test. The maximum positional shift between any geographic coordinate reference system and WGS84 is less than 6 km, so any hemisphere Test that relies on a country code for consistency would not be affected by the potential shift. The prior VALIDATION for this Test is VALIDATION_COORDINATE_COUNTRYCODE_CONSISTENT (adb27d29-9f0d-4d52-b760-a77ba57a69c9)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment Coordinates Transposed for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:9d387033-c581-4fb5-9af2-73ec89c99e77"
      }
    ],
