    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AmendmentMethod: AMENDMENT_COORDINATES_TRANSPOSED with Specification Specification for: AMENDMENT_COORDINATES_TRANSPOSED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "Source: iDigBio, GBIF, BISON, FP, Kurator, ALA"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L3473"
      },
