      },
      {
        "@value": "TG2 Amendment SPACE CODED Test Consistency CORE"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "AmendmentMethod: AMENDMENT_COORDINATES_TRANSPOSED with Specification Specification for: AMENDMENT_COORDINATES_TRANSPOSED"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/forAmendment": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/f2b4a50a-6b2f-4930-b9df-da87b6a21082-2025-03-07"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasSpecification": [
      {
        "@id": "urn:uuid:46caea46-0c94-4efb-9e5f-1b170f2ad54e"
      }
    ]
  },
  {
    "@id": "urn:uuid:46caea46-0c94-4efb-9e5f-1b170f2ad54e",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if any of dwc:decimalLatitude or dwc:decimalLongitude or dwc:countryCode are bdqval:Empty; AMENDED dwc:decimalLatitude and dwc:decimalLongitude if the coordinates were transposed or one or more of the signs of the coordinates were reversed to align the location with dwc:countryCode according to the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_COORDINATES_TRANSPOSED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:decimalLatitude=\"25.46\", dwc:decimalLongitude=\"135.87\", dwc:countryCode=\"AU\": Response.status=AMENDED, Response.result=dwc:decimalLatitude=\"-25.46\", dwc:decimalLongitude=\"135.87\", Response.comment=\"dwc:decimalLatitude sign reversed to fit dwc:countryCode=AU\""
      },
      {
        "@value": "dwc:decimalLatitude=\"25.46\", dwc:decimalLongitude=\"135.87\", dwc:countryCode=\"AX\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:countryCode is uninterpretable\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:95e1332e-eeca-4b41-8698-88ffc33cef3f"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if any of dwc:decimalLatitude or dwc:decimalLongitude or dwc:countryCode are bdqval:Empty; AMENDED dwc:decimalLatitude and dwc:decimalLongitude if the coordinates were transposed or one or more of the signs of the coordinates were reversed to align the location with dwc:countryCode according to the bdqval:sourceAuthority; otherwise NOT_AMENDED"
      }
    ]
  },
