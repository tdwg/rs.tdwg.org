  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/563872eb-f544-45a0-8f91-8098d62768d4-2025-03-07">
    <dcterms:description>Measure if all VALIDATION_DATEIDENTIFIED_STANDARD in a record set are COMPLIANT.</dcterms:description>
