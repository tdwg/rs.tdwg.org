      }
    ]
  },
  {
    "@id": "urn:uuid:aefe88ed-6d3a-4824-8c4a-a75714cb0351",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if no Tests of type VALIDATION were run; Report the number of Tests of output type VALIDATION that did not run because prerequisites for those Tests were not met (Result.status=\"INTERNAL_PREREQUISITES_NOT_MET\" or \"EXTERNAL_PREREQUISITES_NOT_MET\")"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: MEASURE_VALIDATIONTESTS_PREREQUISITESNOTMET"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "[Response.status=RUN_HAS_RESULT, Response.result=\"27\", Response.comment=\"27 VALIDATION Tests had either INTERNAL_PREREQUISITES_NOT_MET\" or \"EXTERNAL_PREREQUISITES_NOT_MET\"]"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if no Tests of type VALIDATION were run; Report the number of Tests of output type VALIDATION that did not run because prerequisites for those Tests were not met (Result.status=\"INTERNAL_PREREQUISITES_NOT_MET\" or \"EXTERNAL_PREREQUISITES_NOT_MET\")"
      }
    ]
  },
