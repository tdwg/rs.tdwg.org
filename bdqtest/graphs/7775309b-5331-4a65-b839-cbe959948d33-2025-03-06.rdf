  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/7775309b-5331-4a65-b839-cbe959948d33-2025-03-06">
    <dcterms:description>Count the number of VALIDATION_ENDDAYOFYEAR_INRANGE in a record set that are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/7775309b-5331-4a65-b839-cbe959948d33"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-06</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.1371/journal.pone.0178731"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_COUNT_COMPLIANT_ENDDAYOFYEAR_INRANGE</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/296</skos:historyNote>
    <skos:note>For Quality Control, compare the Response.result of this measure with the total number of records to assess work needed on the record set.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord Counting Compliance of Validation dwc:endDayOfYear In Range for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:dda8a095-0878-4b93-8a55-9b95f1700dae"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:dda8a095-0878-4b93-8a55-9b95f1700dae">
