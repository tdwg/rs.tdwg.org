  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqffdq/terms/SingleRecord">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ResourceType"/>
    <rdfs:label>SingleRecord</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:c5abcb06-a1d0-4ed5-9513-c04c194293e6">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:degreeOfEstablishment</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:degreeOfEstablishment</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/degreeOfEstablishment"/>
  </rdf:Description>
</rdf:RDF>
