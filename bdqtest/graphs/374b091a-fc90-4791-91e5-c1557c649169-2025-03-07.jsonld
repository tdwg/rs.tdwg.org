    "http://purl.org/dc/terms/description": [
      {
        "@value": "COMPLIANT if dc:type is bdqval:NotEmpty; otherwise NOT_COMPLIANT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_DCTYPE_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dc:type=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dc:type is bdqval:Empty\""
      },
      {
        "@value": "dc:type=\"?\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dc:type is bdqval:NotEmpty\""
      }
    ],
