    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Does the value of dwc:basisOfRecord occur in the bdqval:sourceAuthority?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/42408a00-bf71-4892-a399-4325e2bc1fb8"
