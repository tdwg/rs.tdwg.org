<https://rs.gbif.org/vocabulary/gbif/sex.xml> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "GBIF (2015) Darwin Core Vocabulary: Sex GBIF Vocabulary. https://rs.gbif.org/vocabulary/gbif/sex.xml" .

bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Alien-Species a bdqffdq:UseCase ;
    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:2964d61f-eab0-4a21-9ac6-3f6a7c4fbf86> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF Sex Vocabulary\"" ;
    bdqffdq:hasArgumentValue "GBIF Sex Vocabulary" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:72471db4-226c-454f-bbe8-5c1718e6c834> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_SEX_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; COMPLIANT if the value of dwc:sex is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"GBIF Sex Vocabulary\" [https://api.gbif.org/v1/vocabularies/Sex]} {\"dwc:sex vocabulary API\" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}" ;
    skos:example "dwc:sex=\"Male\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:sex found in the bdqval:sourceAuthority\"",
        "dwc:sex=\"f\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:sex not found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:2964d61f-eab0-4a21-9ac6-3f6a7c4fbf86> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF Sex Vocabulary\" [https://api.gbif.org/v1/vocabularies/Sex]} {\"dwc:sex vocabulary API\" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; COMPLIANT if the value of dwc:sex is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<urn:uuid:81029ffa-2df8-4e9e-a7dd-fc67faad9205> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:sex" ;
    skos:prefLabel "Information Element ActedUpon dwc:sex" ;
    bdqffdq:composedOf dwc:sex .

<https://rs.tdwg.org/bdqtest/terms/version/88d8598b-3318-483d-9475-a5acf9887404-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_SEX_STANDARD" ;
    dcterms:description "Does the value of dwc:sex occur in bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:88d8598b-3318-483d-9475-a5acf9887404 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://rs.gbif.org/vocabulary/gbif/sex.xml> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/283" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters. For reference, a list of synonyms for dwc:sex values can be found at https://registry.gbif.org/vocabulary/Sex/concepts." ;
    skos:prefLabel "Validation dwc:sex Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:81029ffa-2df8-4e9e-a7dd-fc67faad9205> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-02-09"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

