<urn:uuid:a0c48217-97a2-41e2-9540-61939f2628c5> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_SEX_STANDARD with Specification for: VALIDATION_SEX_STANDARD" ;
    skos:historyNote "Source: VertNet" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L2084",
