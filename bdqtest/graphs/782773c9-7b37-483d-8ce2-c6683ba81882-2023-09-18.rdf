  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/782773c9-7b37-483d-8ce2-c6683ba81882-2023-09-18">
    <dcterms:description>Count the number of VALIDATION_TAXON_UNAMBIGUOUS in a record set that are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/782773c9-7b37-483d-8ce2-c6683ba81882"/>
