  <rdf:Description rdf:about="urn:uuid:72ac3c31-cddf-4fcf-bb6d-2d10b6a1a18e">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon bdqval:AggregatedTestResponseOutcomes for bdqtest:VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH.Response</rdfs:label>
    <skos:note>Aggregated Response outcomes produced by VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH across a MultiRecord.</skos:note>
    <skos:prefLabel>Information Element ActedUpon bdqval:AggregatedTestResponseOutcomes for bdqtest:VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH.Response</skos:prefLabel>
