<urn:uuid:fd15e0a4-f49d-4566-b700-a9b46c284e68> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_DEGREEOFESTABLISHMENT_STANDARD with Specification for: VALIDATION_DEGREEOFESTABLISHMENT_STANDARD" ;
