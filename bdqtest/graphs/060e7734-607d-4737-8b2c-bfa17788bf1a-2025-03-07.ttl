<urn:uuid:3a640869-d2ea-4447-8e42-06ddb217066c> a bdqffdq:ValidationPolicy ;
    rdfs:label "ValidationPolicy: (32) validations  in UseCase bdquc:Alien-Species" ;
    skos:prefLabel "ValidationPolicy: (32) validations  in UseCase bdquc:Alien-Species" ;
    bdqffdq:hasUseCase bdquc:Alien-Species ;
