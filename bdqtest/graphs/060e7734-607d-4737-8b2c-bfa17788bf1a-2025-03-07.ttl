<http://dwc.tdwg.org/doe/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Darwin Core Maintenance Group (2021) Degree of Establishment Controlled Vocabulary List of Terms. Biodiversity Information Standards (TDWG). http://dwc.tdwg.org/doe/" .

<https://doi.org/10.3897/biss.3.38084> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Groom et al. (2019) Improving Darwin Core for research and management of alien species. Biodiversity Information Science and Standards 3: e38084. https://doi.org/10.3897/biss.3.38084" .

bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Alien-Species a bdqffdq:UseCase ;
    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:8aac7359-311a-405f-8117-79bb4873011d> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Degree of Establishment Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Degree of Establishment Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:c5abcb06-a1d0-4ed5-9513-c04c194293e6> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:degreeOfEstablishment" ;
    skos:prefLabel "Information Element ActedUpon dwc:degreeOfEstablishment" ;
    bdqffdq:composedOf dwc:degreeOfEstablishment .

<urn:uuid:fec2103b-5d46-4723-b2ec-8c8119b44aaf> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DEGREEOFESTABLISHMENT_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; COMPLIANT if the value of dwc:degreeOfEstablishment is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    skos:example "dwc:degreeOfEstablishment=\"cultivated\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:degreeOfEstablishment found in the bdqval:sourceAuthority\"",
        "dwc:degreeOfEstablishment=\"grown in garden\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:degreeOfEstablishment not found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:8aac7359-311a-405f-8117-79bb4873011d> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; COMPLIANT if the value of dwc:degreeOfEstablishment is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<https://rs.tdwg.org/bdqtest/terms/version/060e7734-607d-4737-8b2c-bfa17788bf1a-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_DEGREEOFESTABLISHMENT_STANDARD" ;
    dcterms:description "Does the value of dwc:degreeOfEstablishment occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:060e7734-607d-4737-8b2c-bfa17788bf1a ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <http://dwc.tdwg.org/doe/>,
        <https://doi.org/10.3897/biss.3.38084> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/275" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:degreeofEstablishment Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:c5abcb06-a1d0-4ed5-9513-c04c194293e6> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-02-09"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

