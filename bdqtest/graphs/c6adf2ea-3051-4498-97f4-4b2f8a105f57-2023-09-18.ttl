<urn:uuid:53bfecf4-0d88-49a2-8f12-672345ef4f50> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:coordinateUncertaintyInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:coordinateUncertaintyInMeters" ;
    bdqffdq:composedOf dwc:coordinateUncertaintyInMeters .

<urn:uuid:f8dfc3fc-6580-4518-b2b4-595c29e9042e> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COORDINATEUNCERTAINTY_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:coordinateUncertaintyInMeters is bdqval:Empty; COMPLIANT if the value of dwc:coordinateUncertaintyInMeters is interpreted as a number between 1 and 20037509 inclusive; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:coordinateUncertaintyInMeters=\"-1\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:coordinateUncertaintyInMeters is out of range\"",
        "dwc:coordinateUncertaintyInMeters=\"1\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:coordinateUncertaintyInMeters is in range\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:coordinateUncertaintyInMeters is bdqval:Empty; COMPLIANT if the value of dwc:coordinateUncertaintyInMeters is interpreted as a number between 1 and 20037509 inclusive; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/c6adf2ea-3051-4498-97f4-4b2f8a105f57-2023-09-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COORDINATEUNCERTAINTY_INRANGE" ;
    dcterms:description "Is the value of dwc:coordinateUncertaintyInMeters a number between 1 and 20,037,509?" ;
    dcterms:isVersionOf bdqtest:c6adf2ea-3051-4498-97f4-4b2f8a105f57 ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/Great-circle_distance> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/109" ;
    skos:note "The upper limit is one half the equatorial circumference of the earth." ;
    skos:prefLabel "Validation dwc:coordinateUncertaintyInMeters In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:53bfecf4-0d88-49a2-8f12-672345ef4f50> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

