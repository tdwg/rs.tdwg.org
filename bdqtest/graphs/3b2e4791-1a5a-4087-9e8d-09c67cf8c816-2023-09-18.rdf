  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/3b2e4791-1a5a-4087-9e8d-09c67cf8c816-2023-09-18">
    <dcterms:description>Measure if all VALIDATION_LOCATION_NOTEMPTY in a record set are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/3b2e4791-1a5a-4087-9e8d-09c67cf8c816"/>
