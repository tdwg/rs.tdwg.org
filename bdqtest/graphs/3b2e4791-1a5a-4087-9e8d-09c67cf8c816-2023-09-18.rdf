  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:977ed65e-416f-46e8-85a3-079c6b735fa8">
    <dcterms:description>COMPLETE if every VALIDATION_LOCATION_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: MULTIRECORD_MEASURE_QA_LOCATION_NOTEMPTY</rdfs:label>
    <skos:example></skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLETE if every VALIDATION_LOCATION_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:e0078022-251d-4c34-9b52-d63f94f601dd">
