  <rdf:Description rdf:about="urn:uuid:fd9bc73a-2b67-4940-ac2a-ad1dda03d0b7">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon bdqval:AggregatedTestResponseOutcomes for bdqtest:VALIDATION_LOCATION_NOTEMPTY.Response</rdfs:label>
    <skos:note>Aggregated Response outcomes produced by VALIDATION_LOCATION_NOTEMPTY across a MultiRecord.</skos:note>
