    <rdfs:label>Conformance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:5a033f48-4b60-4241-b5c3-4a7cb8de33f2">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon bdqval:AggregatedTestResponseOutcomes for bdqtest:VALIDATION_MONTH_STANDARD.Response</rdfs:label>
    <skos:note>Aggregated Response outcomes produced by VALIDATION_MONTH_STANDARD across a MultiRecord.</skos:note>
