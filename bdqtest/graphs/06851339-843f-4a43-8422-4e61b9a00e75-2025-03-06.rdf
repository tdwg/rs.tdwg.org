  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/06851339-843f-4a43-8422-4e61b9a00e75-2025-03-06">
    <dcterms:description>Is there a value in any of the terms needed to determine that the taxon exists?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/06851339-843f-4a43-8422-4e61b9a00e75"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-06</dcterms:issued>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_TAXON_NOTEMPTY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/105</skos:historyNote>
    <skos:note>This tests for records that have no taxonomic (NAME) information. If there is any value for any of the Information Elements, this may be useful information. See example.</skos:note>
    <skos:prefLabel>Validation dwc:Taxon Not Empty for SingleRecord</skos:prefLabel>
