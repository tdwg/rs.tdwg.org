  {
    "@id": "urn:uuid:fae50773-a832-4e44-87fe-d66a1332c3e7",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_OCCURRENCESTATUS_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:occurrenceStatus=\"1\": Response.status=AMENDED, Response.result=dwc:occurrenceStatus=\"present\", Response.comment=\"Input field contains an interpretable value. \""
      },
      {
        "@value": "dwc:occurrenceStatus=\"X\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"Input field contains uninterpretable value \"X\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:59635d6c-f265-45dd-8814-b80a1dc41540"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"Regex present/absent\" {[\"^(present|absent)$\"]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:ocurrenceStatus is bdqval:Empty; AMENDED the value of dwc:occurrenceStatus if it can be unambiguously interpreted as a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED"
      }
    ]
  }
