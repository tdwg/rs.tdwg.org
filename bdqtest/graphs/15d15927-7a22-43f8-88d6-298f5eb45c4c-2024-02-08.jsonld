  {
    "@id": "urn:uuid:fa4e531e-f45e-4dea-8c4b-27d364117808",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_ESTABLISHMENTMEANS_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:establishmentMeans=\"cultivated\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:establishmentMeans is not an interpretable value in the bdqval:sourceAuthority\""
      },
      {
        "@value": "dwc:establishmentMeans=\"vag.\": Response.status=AMENDED, Response.result=dwc:establishmentMeans=\"vagrant\", Response.comment=\"dwc:establishmentMeans contains an interpretable value in the bdqval:sourceAuthority\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasArgument": [
      {
        "@id": "urn:uuid:17d785ee-6ac9-4ab4-9806-f4a2b0d8bbf1"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": "bdqval:sourceAuthority default = \"Establishment Means Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/em/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/EstablishmentMeans/concepts]}"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:establishmentMeans is bdqval:Empty; AMENDED the value of dwc:establishmentMeans if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED"
      }
    ]
  },
