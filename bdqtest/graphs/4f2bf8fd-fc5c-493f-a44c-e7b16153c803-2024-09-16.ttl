<https://www.iso.org/obp/ui/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "ISO (2019) ISO 8601-1:2019(en) Date and time — Representations for information interchange — Part 1: Basic rules. https://www.iso.org/obp/ui/" .

<https://www.loc.gov/standards/datetime/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Library of Congress (2019) Extended Date/Time Format (EDTF). https://www.loc.gov/standards/datetime/" .

<urn:uuid:80c8f69b-4ad3-40ee-bccd-de016bfae367> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_EVENTDATE_STANDARD" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; COMPLIANT if the value of dwc:eventDate is a valid ISO 8601 date; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:eventDate=\"1963-03-08T14\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:eventDate contains a valid ISO 8601-1:2019 date\"",
        "dwc:eventDate=\"1963-03-08T14:67-0600\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:eventDate does not contain a valid ISO 8601-1:2019 date\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; COMPLIANT if the value of dwc:eventDate is a valid ISO 8601 date; otherwise NOT_COMPLIANT" .

<urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:eventDate" ;
    skos:prefLabel "Information Element ActedUpon dwc:eventDate" ;
    bdqffdq:composedOf dwc:eventDate .

<https://rs.tdwg.org/bdqtest/terms/version/4f2bf8fd-fc5c-493f-a44c-e7b16153c803-2024-09-16> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_EVENTDATE_STANDARD" ;
    dcterms:description "Is the value of dwc:eventDate a valid ISO date?" ;
    dcterms:isVersionOf bdqtest:4f2bf8fd-fc5c-493f-a44c-e7b16153c803 ;
    dcterms:issued "2024-09-16"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/66" ;
    skos:note "This Test should also pick up issues such as 29 Feb in a non-leap year." ;
    skos:prefLabel "Validation dwc:eventDate Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

