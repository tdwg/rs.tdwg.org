  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/f15c38c3-d96d-4e9c-982d-410fb71cf2bc-2024-08-19">
    <dcterms:description>Count the number of VALIDATION_COUNTRY_FOUND in a record set that are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/f15c38c3-d96d-4e9c-982d-410fb71cf2bc"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-19</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.1371/journal.pone.0178731"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_COUNT_COMPLIANT_COUNTRY_FOUND</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/296</skos:historyNote>
    <skos:note>For Quality Control, compare the Response.result of this measure with the total number of records to assess work needed on the record set.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord Counting Compliance of Validation dwc:country Found for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:4d7d45ed-da78-44b0-8e93-e8c0423aa4a9"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-19</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:4badb4f9-f739-486f-aa0f-4fa351ed2e84">
    <dcterms:description>Count the number of VALIDATION_COUNTRY_FOUND in the MultiRecord that have Response.result=COMPLIANT.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: MULTIRECORD_MEASURE_COUNT_COMPLIANT_COUNTRY_FOUND</rdfs:label>
    <skos:example></skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>Count the number of VALIDATION_COUNTRY_FOUND in the MultiRecord that have Response.result=COMPLIANT.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
