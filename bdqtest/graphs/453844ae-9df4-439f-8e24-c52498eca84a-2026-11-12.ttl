<urn:uuid:1a7adc4a-58ee-480c-9765-3834ea433bf0> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_VALIDATIONTESTS_NOTCOMPLIANT" ;
    dcterms:description "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=NOT_COMPLIANT." ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"37\", Response.comment=\"37 VALIDATION Tests had Response.result=NOT_COMPLIANT.\"]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.result=NOT_COMPLIANT." .

