  <rdf:Description rdf:about="urn:uuid:07e4c491-0d13-409d-b966-fbb9721e81cf">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH with Specification for: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH</rdfs:label>
    <skos:historyNote>Source: ALA, GBIF, OBIS</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L268</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris &amp; Lowery 2025b)</skos:note>
    <skos:note>TG2 Validation SPACE CODED Test Conformance CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH with Specification for: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/8f1e6e58-544b-4365-a569-fb781341644e-2023-09-18"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:12f7f82e-ab1c-4690-92b8-ecc9328256c1"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:0348eccf-fc7f-49b3-88b6-1d911e98cbbb">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationPolicy"/>
    <rdfs:label>ValidationPolicy: (30) validations  in UseCase bdquc:Spatial-Temporal_Patterns</rdfs:label>
    <skos:prefLabel>ValidationPolicy: (30) validations  in UseCase bdquc:Spatial-Temporal_Patterns</skos:prefLabel>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/8f1e6e58-544b-4365-a569-fb781341644e-2023-09-18"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/8f1e6e58-544b-4365-a569-fb781341644e-2023-09-18">
    <dcterms:description>Is the value of dwc:minimumDepthInMeters a number less than or equal to the value of dwc:maximumDepthInMeters?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/8f1e6e58-544b-4365-a569-fb781341644e"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.15468/doc-gg7h-s853"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/24</skos:historyNote>
    <skos:note></skos:note>
    <skos:prefLabel>Validation dwc:minimumDepthInMeters less than dwc:maximumDepthInMeters for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/Consistent"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://doi.org/10.15468/doc-gg7h-s853">
    <dcterms:bibliographicCitation>Chapman AD and Wieczorek JR (2020) Georeferencing Best Practices. Copenhagen: GBIF Secretariat. https://doi.org/10.15468/doc-gg7h-s853</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/maximumDepthInMeters"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/minimumDepthInMeters"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:12f7f82e-ab1c-4690-92b8-ecc9328256c1">
    <dcterms:description>INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters is bdqval:Empty, or if either are interpretable as not zero or a positive number; COMPLIANT if the value of dwc:minimumDepthInMeters is less than or equal to the value of dwc:maximumDepthInMeters; otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH</rdfs:label>
    <skos:example>dwc:minimumDepthInMeters="0", dwc:maximumDepthInMeters="0": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dwc:minimumDepthInMeters = dwc:maximumDepthInMeters"</skos:example>
    <skos:example>dwc:minimumDepthInMeters="1", dwc:maximumDepthInMeters="0": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dwc:minimumDepthInMeters &gt; dwc:maximumDepthInMeters"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters is bdqval:Empty, or if either are interpretable as not zero or a positive number; COMPLIANT if the value of dwc:minimumDepthInMeters is less than or equal to the value of dwc:maximumDepthInMeters; otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqdim/terms/Conformance">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/DataQualityDimension"/>
    <rdfs:label>Conformance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/UseCase"/>
    <rdfs:label>bdquc:Spatial-Temporal_Patterns</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqffdq/terms/SingleRecord">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ResourceType"/>
    <rdfs:label>SingleRecord</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/Consistent">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Criterion"/>
    <rdfs:label>Consistent</rdfs:label>
  </rdf:Description>
</rdf:RDF>
