<urn:uuid:0e6f3880-8203-445f-9bff-f44f52120abe> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:stateProvince" ;
    skos:prefLabel "Information Element ActedUpon dwc:stateProvince" ;
    bdqffdq:composedOf dwc:stateProvince .

<urn:uuid:41461142-2c1e-4fc1-bc97-f83a7b2a893d> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"The Getty Thesaurus of Geographic Names (TGN)\"" ;
    bdqffdq:hasArgumentValue "The Getty Thesaurus of Geographic Names (TGN)" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:d261fac1-ce61-4879-bc04-870fa885b578> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_STATEPROVINCE_FOUND" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:stateProvince is bdqval:Empty; COMPLIANT if the value of dwc:stateProvince occurs as an administrative entity that is a child to at least one entity representing an ISO 3166 country-like entity in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}" ;
    skos:example "dwc:stateProvince=\"Florida\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:stateProvince found in bdqval:sourceAuthority\"",
        "dwc:stateProvince=\"Taswegian\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:stateProvince not found in bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:41461142-2c1e-4fc1-bc97-f83a7b2a893d> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:stateProvince is bdqval:Empty; COMPLIANT if the value of dwc:stateProvince occurs as an administrative entity that is a child to at least one entity representing an ISO 3166 country-like entity in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/4daa7986-d9b0-4dd5-ad17-2d7a771ea71a-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_STATEPROVINCE_FOUND" ;
    dcterms:description "Does the value of dwc:stateProvince occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:4daa7986-d9b0-4dd5-ad17-2d7a771ea71a ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2>,
        <https://www.getty.edu/research/tools/vocabularies/tgn/index.html>,
        <https://www.iso.org/iso-3166-country-codes.html> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/199" ;
    skos:note "Multiple values in the dwc:stateProvince field (whether to signify on a border or in a list of possibilities) will fail this Test. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:stateProvince Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:0e6f3880-8203-445f-9bff-f44f52120abe> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

