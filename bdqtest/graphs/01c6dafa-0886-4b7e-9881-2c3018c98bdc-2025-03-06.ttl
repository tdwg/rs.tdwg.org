<urn:uuid:2c5dbdbb-feab-474c-bcca-bf6d1b90ae66> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MONTH_STANDARD" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:month is bdqval:Empty; COMPLIANT if the value of dwc:month is interpretable as an integer between 1 and 12 inclusive; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:month=\"10\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:month is in range\"",
        "dwc:month=\"v\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:month is ambiguous as \"v\" or \"5\"\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:month is bdqval:Empty; COMPLIANT if the value of dwc:month is interpretable as an integer between 1 and 12 inclusive; otherwise NOT_COMPLIANT" .

<urn:uuid:a16e8cb6-dbf5-44a9-becc-8bef83a37456> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:month" ;
    skos:prefLabel "Information Element ActedUpon dwc:month" ;
    bdqffdq:composedOf dwc:month .

