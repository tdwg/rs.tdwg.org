    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:sourceAuthority:"Darwin Core basisOfRecord"</rdfs:label>
    <bdqffdq:hasArgumentValue>Darwin Core basisOfRecord</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/sourceAuthority"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:2c09df64-3803-4834-a6e9-30ba80f8eac8">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:basisOfRecord</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:basisOfRecord</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/basisOfRecord"/>
