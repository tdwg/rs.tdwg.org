<urn:uuid:3a640869-d2ea-4447-8e42-06ddb217066c> a bdqffdq:ValidationPolicy ;
    rdfs:label "ValidationPolicy: (32) validations  in UseCase bdquc:Alien-Species" ;
    skos:prefLabel "ValidationPolicy: (32) validations  in UseCase bdquc:Alien-Species" ;
    bdqffdq:hasUseCase bdquc:Alien-Species ;
    bdqffdq:includedInPolicy <https://rs.tdwg.org/bdqtest/terms/version/5424e933-bee7-4125-839e-d8743ea69f93-2025-03-07> .

<urn:uuid:ffae8e47-2181-4a83-b1c7-d0a893e79b67> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_PATHWAY_STANDARD with Specification for: VALIDATION_PATHWAY_STANDARD" ;
    skos:historyNote "Source: TG2" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L1875",
        "Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)",
        "TG2 Validation OTHER CODED Test VOCABULARY Conformance Parameterized CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_PATHWAY_STANDARD with Specification for: VALIDATION_PATHWAY_STANDARD" ;
    bdqffdq:forValidation <https://rs.tdwg.org/bdqtest/terms/version/5424e933-bee7-4125-839e-d8743ea69f93-2025-03-07> ;
    bdqffdq:hasSpecification <urn:uuid:c7c92ef0-284e-4c5d-8fc9-f1480bfe0b8e> .

<https://doi.org/10.3897/biss.3.38084> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Groom et al. (2019) Improving Darwin Core for research and management of alien species. Biodiversity Information Science and Standards 3: e38084. https://doi.org/10.3897/biss.3.38084" .

<https://dwc.tdwg.org/pw/> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Darwin Core Maintenance Group (2021) Pathway Controlled Vocabulary List of Terms. Biodiversity Information Standards (TDWG). https://dwc.tdwg.org/pw/" .

bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Alien-Species a bdqffdq:UseCase ;
    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:136039c5-6ceb-41ec-90b3-eb1cd37d6eed> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Pathway Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Pathway Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:c7c92ef0-284e-4c5d-8fc9-f1480bfe0b8e> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_PATHWAY_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:pathway is bdqval:Empty; COMPLIANT if the value of dwc:pathway is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT. bdqval:sourceAuthority default = \"Pathway Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/pw/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/Pathway/concepts]}" ;
    skos:example "dwc:pathway=\"escapee\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:pathway not found in the bdqval:sourceAuthority\"",
        "dwc:pathway=\"transportStowaway\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:pathway found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:136039c5-6ceb-41ec-90b3-eb1cd37d6eed> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Pathway Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/pw/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/Pathway/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:pathway is bdqval:Empty; COMPLIANT if the value of dwc:pathway is in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT." .

<urn:uuid:f3141ff8-76fa-4953-9c6c-9300816358cc> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:pathway" ;
    skos:prefLabel "Information Element ActedUpon dwc:pathway" ;
    bdqffdq:composedOf dwc:pathway .

<https://rs.tdwg.org/bdqtest/terms/version/5424e933-bee7-4125-839e-d8743ea69f93-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_PATHWAY_STANDARD" ;
    dcterms:description "Does the value of dwc:pathway occur in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:5424e933-bee7-4125-839e-d8743ea69f93 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.3897/biss.3.38084>,
        <https://dwc.tdwg.org/pw/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/277" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:pathway Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:f3141ff8-76fa-4953-9c6c-9300816358cc> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-02-09"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

