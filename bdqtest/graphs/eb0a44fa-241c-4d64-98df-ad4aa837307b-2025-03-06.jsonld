  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/eb0a44fa-241c-4d64-98df-ad4aa837307b-2025-03-06",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to the value of dwc:eventDate from values in dwc:year, dwc:startDayOfYear and dwc:endDayOfYear."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/eb0a44fa-241c-4d64-98df-ad4aa837307b"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-03-06"
      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://en.wikipedia.org/wiki/ISO_8601"
      },
      {
        "@id": "https://www.iso.org/obp/ui/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_EVENTDATE_FROM_YEARSTARTDAYOFYEARENDDAYOFYEAR"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/132"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "An attempt to populate dwc:eventDate from dwc:verbatimEventDate should be made before this Test is run. While year=1999, startDayOfYear=123 could be validly represented as an ISO date as either 1999-123 or 1999-05-03, the latter of these two forms SHOULD be used, thus, do not simply concatenate dwc:year and dwc:startDayOfYear. This Test is only for cases that fall within the one year (as given in dwc:year) and hence dwc:startDayOfYear will always be less than dwc:endDayOfYear."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment dwc:eventDate from dwc:year dwc:startDayOfYear dwc:endDayOfYear for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasConsultedInformationElement": [
      {
        "@id": "urn:uuid:a7362af8-77a9-45c3-8520-1a12b8b31804"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDataQualityDimension": [
      {
        "@id": "https://rs.tdwg.org/bdqdim/terms/Completeness"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDateLastUpdated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-08-18"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasEnhancement": [
      {
        "@id": "https://rs.tdwg.org/bdqenh/terms/FilledInFrom"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasResourceType": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/SingleRecord"
      }
    ]
  },
  {
    "@id": "https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/UseCase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bdquc:Spatial-Temporal_Patterns"
      }
    ]
  },
  {
    "@id": "https://www.iso.org/obp/ui/",
    "@type": [
      "http://purl.org/dc/terms/BibliographicResource"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "ISO (2019) ISO 8601-1:2019(en) Date and time — Representations for information interchange — Part 1: Basic rules. https://www.iso.org/obp/ui/"
      }
    ]
  },
  {
    "@id": "urn:uuid:647bf697-e432-4b31-9a69-778396e14a82",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:NotEmpty or any of dwc:year, dwc:startDayOfYear, or dwc:endDayOfYear are bdqval:Empty; FILLED_IN the value of dwc:eventDate from values in dwc:year, dwc:startDayOfYear and dwc:endDayOfYear if the values in each are independently interpretable and if the value of dwc:startDayOfYear is less than the value of dwc:endDayOfYear; otherwise NOT_AMENDED"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_EVENTDATE_FROM_YEARSTARTDAYOFYEARENDDAYOFYEAR"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:year=\"1901\", dwc:startDayOfYear=\"15\", dwc:endDayOfYear=\"25\", dwc:eventDate=\"\": Response.status=FILLED_IN, Response.result=dwc:eventDate=\"1901-01-15/1901-01-25\", Response.comment=\"dwc:eventDate was interpreted from dwc:year, dwc:startDayOfYear and dwc:endDayOfYear\""
      },
      {
        "@value": "dwc:year=\"1901\", dwc:startDayOfYear=\"25\", dwc:endDayOfYear=\"15\", dwc:eventDate=\"\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:startDayOfYear > dwc:endDayOfyear\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:NotEmpty or any of dwc:year, dwc:startDayOfYear, or dwc:endDayOfYear are bdqval:Empty; FILLED_IN the value of dwc:eventDate from values in dwc:year, dwc:startDayOfYear and dwc:endDayOfYear if the values in each are independently interpretable and if the value of dwc:startDayOfYear is less than the value of dwc:endDayOfYear; otherwise NOT_AMENDED"
      }
    ]
  },
