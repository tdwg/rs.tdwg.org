  },
  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/453844ae-9df4-439f-8e24-c52498eca84a-2024-08-22",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Measure"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "A count of the number of distinct VALIDATION Tests that have a Response.status=\"NOT_COMPLIANT\" for a given record."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/453844ae-9df4-439f-8e24-c52498eca84a"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-08-22"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "MEASURE_VALIDATIONTESTS_NOTCOMPLIANT"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/31"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "We have three individual measures for pass (MEASURE_VALIDATIONTESTS_COMPLIANT (45fb49eb-4a1b-4b49-876f-15d5034dfc73)), fail (MEASURE_VALIDATIONTESTS_NOTCOMPLIANT (453844ae-9df4-439f-8e24-c52498eca84a)), and PREREQUISITES_NOT_MET (49a94636-a562-4e6b-803c-665c80628a3d). To get the total number of Tests that were attempted, add all three measures. To get the total number of Tests that ran, add NOT_COMPLIANT (fail) and COMPLIANT (pass)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Measure Validation Tests Not Compliant for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasConsultedInformationElement": [
      {
        "@id": "urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDataQualityDimension": [
      {
        "@id": "https://rs.tdwg.org/bdqdim/terms/Reliability"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDateLastUpdated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2024-08-22"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasResourceType": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/SingleRecord"
      }
    ]
  },
