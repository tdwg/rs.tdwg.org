    <rdfs:label>Information Element ActedUpon dcterms:license</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dcterms:license</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://purl.org/dc/terms/license"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqenh/terms/Standardized">
