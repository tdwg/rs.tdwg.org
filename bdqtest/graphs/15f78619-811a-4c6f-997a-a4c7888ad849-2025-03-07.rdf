  <rdf:Description rdf:about="urn:uuid:d8b450af-47e6-4f5c-8154-6d6acbe9efa5">
    <dcterms:description>COMPLIANT if dcterms:license is bdqval:NotEmpty; otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_LICENSE_NOTEMPTY</rdfs:label>
    <skos:example>dcterms:license=" ": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dcterms:license is bdqval:Empty"</skos:example>
    <skos:example>dcterms:license="CC0 1.0": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dcterms:license is bdqval:NotEmpty"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLIANT if dcterms:license is bdqval:NotEmpty; otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
