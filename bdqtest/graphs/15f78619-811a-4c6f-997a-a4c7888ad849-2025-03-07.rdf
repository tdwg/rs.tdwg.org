    <dcterms:references rdf:resource="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/terms/LicenseDocument/"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_LICENSE_NOTEMPTY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/99</skos:historyNote>
    <skos:note>The license at the record level might be derived from the license of the dataset from which the record is retrieved.</skos:note>
    <skos:prefLabel>Validation dcterms:license Not Empty for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:d3daaab7-b042-4dc7-a92f-77f19988f351"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/NotEmpty"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Completeness"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdquc/terms/SDM-Trees">
