>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1-2024-09-17">
    <dcterms:description>Are there any annotations associated with the record?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/fecaa8a3-bbd8-4c5a-a424-13c37c4bb7b1"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-17</dcterms:issued>
    <dcterms:references rdf:resource="urn:uuid:3c0146df-5ce2-4f35-a066-5cf14de8c79a"/>
    <dcterms:references rdf:resource="urn:uuid:71c9c3d1-fb9d-4774-8f31-63bc7a4ef49b"/>
    <dcterms:references rdf:resource="urn:uuid:e9d0f3c8-848c-409e-9af3-70425650a575"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Issue"/>
    <rdfs:label>ISSUE_ANNOTATION_NOTEMPTY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/29</skos:historyNote>
    <skos:note>While there is a W3C standard on 'web annotation', there is no TDWG recommendation on how this standard could be applied to annotating Darwin Core records. While implementation of this Test is currently problematic, TG2 considers annotations attached to any aspect of a Darwin Core record justifies this Test as a placeholder in the hope of future developments.</skos:note>
    <skos:prefLabel>Issue Annotation Not Empty for SingleRecord</skos:prefLabel>
    <bdqffdq:hasConsultedInformationElement rdf:resource="urn:uuid:b7a02234-c4d0-40fd-a437-af8330cc700f"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/NotEmpty"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Reliability"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdquc/terms/Alien-Species">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/UseCase"/>
    <rdfs:label>bdquc:Alien-Species</rdfs:label>
  </rdf:Description>
