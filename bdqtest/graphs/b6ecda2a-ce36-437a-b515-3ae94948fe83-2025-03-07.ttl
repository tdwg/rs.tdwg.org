<urn:uuid:a5111c0c-d198-4ecc-af10-809ae2b3ae01> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLATITUDE_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLatitude is bdqval:Empty or the value is not interpretable as a number; COMPLIANT if the value of dwc:decimalLatitude is between -90 and 90, inclusive; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:decimalLatitude=\"0.0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLatitude is in RANGE\"",
        "dwc:decimalLatitude=\"121.0534\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLatitude is in not in RANGE\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:decimalLatitude is bdqval:Empty or the value is not interpretable as a number; COMPLIANT if the value of dwc:decimalLatitude is between -90 and 90, inclusive; otherwise NOT_COMPLIANT" .

<urn:uuid:e7528e9b-e4d8-42bf-b6e1-169587ca69b8> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:decimalLatitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:decimalLatitude" ;
    bdqffdq:composedOf dwc:decimalLatitude .

