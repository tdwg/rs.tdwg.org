      }
    ]
  },
  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/2e371d57-1eb3-4fe3-8a61-dff43ced50cf-2026-04-24",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to the value of dwc:month as an integer between 1 and 12 inclusive."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/2e371d57-1eb3-4fe3-8a61-dff43ced50cf"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-04-24"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_MONTH_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/128"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Implementations should translate unambiguously interpretable names and abbreviations of months to their integer month values 1-12. Implementations should translate interpretable Roman numerals in the range I-XII in dwc:month as integer month values 1-12, as some natural science domains use roman numeral months to avoid language and day/month vs month/day order concerns. In these cases, the result will be AMENDED numeric equivalents."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment dwc:month Standardized for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:a16e8cb6-dbf5-44a9-becc-8bef83a37456"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDataQualityDimension": [
      {
        "@id": "https://rs.tdwg.org/bdqdim/terms/Conformance"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDateLastUpdated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-04-24"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasEnhancement": [
      {
        "@id": "https://rs.tdwg.org/bdqenh/terms/Standardized"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasResourceType": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/SingleRecord"
      }
    ]
  },
  {
    "@id": "https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/UseCase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bdquc:Spatial-Temporal_Patterns"
      }
    ]
  },
  {
    "@id": "urn:uuid:4a514adf-766f-46a4-bf16-6febcb594f38",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:month is bdqval:Empty; AMENDED the value of dwc:month if it can be unambiguously interpreted as a month represented as an integer between 1 and 12 inclusive; otherwise NOT_AMENDED"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_MONTH_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:month=\"IV\": Response.status=AMENDED, Response.result=dwc:month=\"4\", Response.comment=\"dwc:month interpreted as roman numerals \""
      },
      {
        "@value": "dwc:month=\"Ma\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:month contains an ambiguous value\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:month is bdqval:Empty; AMENDED the value of dwc:month if it can be unambiguously interpreted as a month represented as an integer between 1 and 12 inclusive; otherwise NOT_AMENDED"
      }
    ]
  },
  {
    "@id": "urn:uuid:a16e8cb6-dbf5-44a9-becc-8bef83a37456",
