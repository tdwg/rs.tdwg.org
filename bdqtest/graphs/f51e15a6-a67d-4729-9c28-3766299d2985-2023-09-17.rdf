  <rdf:Description rdf:about="urn:uuid:1fae3f77-7fcb-42c6-ab43-1ff28adf4fa4">
    <dcterms:description>COMPLIANT if dwc:eventDate is bdqval:NotEmpty; otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_EVENTDATE_NOTEMPTY</rdfs:label>
    <skos:example>dwc:eventDate="": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dwc:eventDate is bdqval:Empty"</skos:example>
    <skos:example>dwc:eventDate="1964-11-01T10:00-0600": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dwc:eventdate is bdqval:NotEmpty"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLIANT if dwc:eventDate is bdqval:NotEmpty; otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:12499336-882b-4186-b5a2-4a806af2e35b">
