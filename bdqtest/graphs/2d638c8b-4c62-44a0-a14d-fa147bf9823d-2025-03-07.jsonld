    "https://rs.tdwg.org/bdqffdq/terms/forAmendment": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/version/2d638c8b-4c62-44a0-a14d-fa147bf9823d-2025-03-07"
