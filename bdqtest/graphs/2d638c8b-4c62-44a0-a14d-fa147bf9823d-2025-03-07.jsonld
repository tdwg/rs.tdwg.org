  {
    "@id": "urn:uuid:84195393-4797-465f-bfc1-b764df67c5c2",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumElevationInMeters or dwc:maximumElevationInMeters are bdqval:NotEmpty or dwc:verbatimElevation is bdqval:Empty; FILLED_IN the values of dwc:minimumElevationInMeters and dwc:maximumElevationInMeters if they can be unambiguously interpreted from dwc:verbatimElevation; otherwise NOT_AMENDED"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_MINELEVATIONMAXELEVATION_FROM_VERBATIM"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:verbatimElevation=\"100 feet\", dwc:minimumElevationInMeters=\"\", dwc:maximumElevationInMeters=\"\": Response.status=FILLED_IN, Response.result=dwc:minimumElevationInMeters=\"30.48\", dwc:maximumElevationInMeters=\"30.48\", Response.comment=\"dwc:verbatimElevation contains an interpretable value\""
      },
      {
        "@value": "dwc:verbatimElevation=\"x\", dwc:minimumElevationInMeters=\"\", dwc:maximumElevationInMeters=\"\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:verbatimElevation contains an uninterpretable value\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumElevationInMeters or dwc:maximumElevationInMeters are bdqval:NotEmpty or dwc:verbatimElevation is bdqval:Empty; FILLED_IN the values of dwc:minimumElevationInMeters and dwc:maximumElevationInMeters if they can be unambiguously interpreted from dwc:verbatimElevation; otherwise NOT_AMENDED"
      }
    ]
  },
