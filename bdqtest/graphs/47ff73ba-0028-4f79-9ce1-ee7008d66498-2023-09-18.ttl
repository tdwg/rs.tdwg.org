<urn:uuid:d9bfd4f7-e158-43ee-8ac4-1bc51bf33307> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_DAY_STANDARD with Specification for: VALIDATION_DAY_STANDARD" ;
    skos:historyNote "Source: TDWG2018 DQIG Meeting; TG2-Gainesville" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/event_date_qc/blob/v3.0.5/src/main/java/org/filteredpush/qc/date/DwCEventDQ.java#L639",
        "Example Implementations: Kurator/FilteredPush event_date_qc Library (Morris & Lowery 2025)",
