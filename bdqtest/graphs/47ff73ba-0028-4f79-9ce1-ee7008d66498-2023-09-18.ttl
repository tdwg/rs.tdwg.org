bdqcrit:Standard a bdqffdq:Criterion ;
    rdfs:label "Standard" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Spatial-Temporal_Patterns a bdqffdq:UseCase ;
    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

<urn:uuid:c0fce1a1-8879-4175-8a71-ce037655c358> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DAY_STANDARD" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; COMPLIANT if the value of the field dwc:day is an integer between 1 and 31 inclusive; otherwise NOT_COMPLIANT." ;
    skos:example "dwc:day=\"15\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:day is in range\"",
        "dwc:day=\"32\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:day is not in range\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; COMPLIANT if the value of the field dwc:day is an integer between 1 and 31 inclusive; otherwise NOT_COMPLIANT." .

<urn:uuid:d7853c0b-2e3a-4bbf-89c6-89123ca626bf> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:day" ;
    skos:prefLabel "Information Element ActedUpon dwc:day" ;
    bdqffdq:composedOf dwc:day .

<https://rs.tdwg.org/bdqtest/terms/version/47ff73ba-0028-4f79-9ce1-ee7008d66498-2023-09-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_DAY_STANDARD" ;
    dcterms:description "Is the value of dwc:day an integer between 1 and 31 inclusive?" ;
    dcterms:isVersionOf bdqtest:47ff73ba-0028-4f79-9ce1-ee7008d66498 ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/147" ;
    skos:note "This is part of a group of similar Tests (VALIDATION_DAY_INRANGE (8d787cb5-73e2-4c39-9cd1-67c7361dc02e), VALIDATION_STARTDAYOFYEAR_INRANGE (85803c7e-2a5a-42e1-b8d3-299a44cafc46), VALIDATION_ENDDAYOFYEAR_INRANGE (9a39d88c-7eee-46df-b32a-c109f9f81fb8))." ;
    skos:prefLabel "Validation dwc:day Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:d7853c0b-2e3a-4bbf-89c6-89123ca626bf> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
