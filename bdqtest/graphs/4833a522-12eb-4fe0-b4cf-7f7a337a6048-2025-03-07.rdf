  <rdf:Description rdf:about="urn:uuid:f84d0f30-9c93-43a4-8f75-8c853fc18fb5">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_TYPESTATUS_STANDARD with Specification for: VALIDATION_TYPESTATUS_STANDARD</rdfs:label>
    <skos:historyNote>Source: ALA, GBIF</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L2246</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)</skos:note>
    <skos:note>TG2 Validation OTHER CODED Test VOCABULARY Conformance Parameterized CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_TYPESTATUS_STANDARD with Specification for: VALIDATION_TYPESTATUS_STANDARD</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/4833a522-12eb-4fe0-b4cf-7f7a337a6048-2025-03-07"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:e4dbf38d-bdd7-4cf7-8c60-5b3bfc6af4ff"/>
  </rdf:Description>
