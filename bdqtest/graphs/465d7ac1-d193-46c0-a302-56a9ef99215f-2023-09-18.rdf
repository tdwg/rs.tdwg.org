  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/465d7ac1-d193-46c0-a302-56a9ef99215f-2023-09-18">
    <dcterms:description>Measure if all VALIDATION_KINGDOM_FOUND in a record set are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/465d7ac1-d193-46c0-a302-56a9ef99215f"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.1371/journal.pone.0178731"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_QA_KINGDOM_FOUND</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/295</skos:historyNote>
    <skos:note>For Quality Assurance, filter record set until this measure is COMPLETE.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord for QualityAssurance of Validation dwc:kingdom Found for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:52c61f29-f440-4a97-888c-89bf4f1f143c"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-09-18</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:3f846a5d-629b-45f4-94a0-2c32abe437e2">
    <dcterms:description>COMPLETE if every VALIDATION_KINGDOM_FOUND in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: MULTIRECORD_MEASURE_QA_KINGDOM_FOUND</rdfs:label>
    <skos:example></skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLETE if every VALIDATION_KINGDOM_FOUND in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
