<urn:uuid:1b66a16a-5e76-4eca-a400-d097ac136ac1> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Darwin Core basisOfRecord\"" ;
    bdqffdq:hasArgumentValue "Darwin Core basisOfRecord" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:2c09df64-3803-4834-a6e9-30ba80f8eac8> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:basisOfRecord" ;
