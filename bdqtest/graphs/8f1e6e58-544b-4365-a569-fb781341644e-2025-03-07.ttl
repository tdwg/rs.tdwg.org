<urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters" ;
    skos:prefLabel "Information Element ActedUpon dwc:minimumDepthInMeters, dwc:maximumDepthInMeters" ;
    bdqffdq:composedOf dwc:maximumDepthInMeters,
        dwc:minimumDepthInMeters .

<urn:uuid:12f7f82e-ab1c-4690-92b8-ecc9328256c1> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters is bdqval:Empty, or if either are interpretable as not zero or a positive number; COMPLIANT if the value of dwc:minimumDepthInMeters is less than or equal to the value of dwc:maximumDepthInMeters; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:minimumDepthInMeters=\"0\", dwc:maximumDepthInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:minimumDepthInMeters = dwc:maximumDepthInMeters\"",
        "dwc:minimumDepthInMeters=\"1\", dwc:maximumDepthInMeters=\"0\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:minimumDepthInMeters > dwc:maximumDepthInMeters\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumDepthInMeters or dwc:maximumDepthInMeters is bdqval:Empty, or if either are interpretable as not zero or a positive number; COMPLIANT if the value of dwc:minimumDepthInMeters is less than or equal to the value of dwc:maximumDepthInMeters; otherwise NOT_COMPLIANT" .

