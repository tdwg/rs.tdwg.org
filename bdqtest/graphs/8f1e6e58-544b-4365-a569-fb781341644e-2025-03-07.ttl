    rdfs:label "VALIDATION_MINDEPTH_LESSTHAN_MAXDEPTH" ;
    dcterms:description "Is the value of dwc:minimumDepthInMeters a number less than or equal to the value of dwc:maximumDepthInMeters?" ;
    dcterms:isVersionOf bdqtest:8f1e6e58-544b-4365-a569-fb781341644e ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/24" ;
    skos:note "" ;
    skos:prefLabel "Validation dwc:minimumDepthInMeters less than dwc:maximumDepthInMeters for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:06adabf0-e6d4-4f99-819f-7dd38c796617> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

