    rdfs:label "bdquc:Taxon-Management" .

<urn:uuid:a06d69d9-50ae-4d95-977c-73e926be4883> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:scientificName, dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet" ;
    skos:prefLabel "Information Element ActedUpon dwc:scientificName, dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet" ;
    bdqffdq:composedOf dwc:genericName,
        dwc:infraspecificEpithet,
        dwc:scientificName,
        dwc:specificEpithet .

<urn:uuid:d92c5e23-bf6a-483b-86c3-9374e12d01c7> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_POLYNOMIAL_CONSISTENT" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty, or all of dwc:genericName, dwc:specificEpithet and dwc:infraspecificEpithet are bdqval:Empty; COMPLIANT if the polynomial, as represented in dwc:scientificName, is consistent with bdqval:NotEmpty values of dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet; otherwise NOT_COMPLIANT." ;
    skos:example "dwc:scientificName=\"Hakea decurrens ssp. physocarpa\", dwc:genericName=\"\", dwc:specificEpithet=\"decurrens\", dwc:infraspecificEpithet=\"physocarpa\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"Values of all non-empty atomic terms are found in the polynomial\"",
        "dwc:scientificName=\"Hakea decurrens\", dwc:genericName=\"Hakea\", dwc:specificEpithet=\"decurrens\", dwc:infraspecificEpithet=\"physocarpa\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:scientificName is inconsistent with atomic parts (dwc:genus, dwc:specificEpithet and dwc:infraspecificEpithet)\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:scientificName is bdqval:Empty, or all of dwc:genericName, dwc:specificEpithet and dwc:infraspecificEpithet are bdqval:Empty; COMPLIANT if the polynomial, as represented in dwc:scientificName, is consistent with bdqval:NotEmpty values of dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet; otherwise NOT_COMPLIANT." .

<https://rs.tdwg.org/bdqtest/terms/version/17f03f1f-f74d-40c0-8071-2927cfc9487b-2025-03-06> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_POLYNOMIAL_CONSISTENT" ;
    dcterms:description "Is the polynomial represented in dwc:scientificName consistent with the equivalent values in dwc:genericName, dwc:specificEpithet, dwc:infraspecificEpithet?" ;
    dcterms:isVersionOf bdqtest:17f03f1f-f74d-40c0-8071-2927cfc9487b ;
    dcterms:issued "2025-03-06"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/101" ;
    skos:note "If dwc:specificEpithet is populated then this Test expects that the value dwc:specificEpithet is the name of the second or species epithet of the scientificName. If dwc:genericName is populated, this Test expects that the value of dwc:genus is the first word of the value of dwc:scientificName. If dwc:specificEpithet is populated then this Test expects that the value dwc:specificEpithet is the name of the first or species epithet of the scientificName. If dwc:infraspecificEpithet is populated, then this Test expects that the value of dwc:infraspecificEpithet is the name of the lowest or terminal infraspecific epithet of the scientificName, excluding any rank designation." ;
    skos:prefLabel "Validation Polynomial Consistent for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:a06d69d9-50ae-4d95-977c-73e926be4883> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Consistency ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

