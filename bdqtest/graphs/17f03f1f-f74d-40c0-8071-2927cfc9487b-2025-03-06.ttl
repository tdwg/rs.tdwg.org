<urn:uuid:94510668-a59f-41d3-84bb-30cd9715cb62> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_POLYNOMIAL_CONSISTENT with Specification for: VALIDATION_POLYNOMIAL_CONSISTENT" ;
    skos:historyNote "Source: Paula Zermoglio" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L1570",
        "Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris & Dou 2025)",
        "TG2 Validation NAME CODED Test Consistency CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_POLYNOMIAL_CONSISTENT with Specification for: VALIDATION_POLYNOMIAL_CONSISTENT" ;
    bdqffdq:forValidation <https://rs.tdwg.org/bdqtest/terms/version/17f03f1f-f74d-40c0-8071-2927cfc9487b-2025-03-06> ;
    bdqffdq:hasSpecification <urn:uuid:d92c5e23-bf6a-483b-86c3-9374e12d01c7> .

