<urn:uuid:e6f0a9ce-3e72-40fb-9fad-63cf5962f93e> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_KINGDOM_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:kingdom is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:kingdom=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:kingdom is bdqval:Empty\"",
        "dwc:kingdom=\"Fungi\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:kingdom is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:kingdom is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

