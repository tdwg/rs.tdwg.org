bdqval:defaultOccurrenceStatus a bdqffdq:Parameter .

<urn:uuid:2c32cfc9-66d2-4512-9ebb-b3253c7b5dd5> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted dwc:individualCount, dwc:organismQuantity" ;
    skos:prefLabel "Information Element Consulted dwc:individualCount, dwc:organismQuantity" ;
    bdqffdq:composedOf dwc:individualCount,
        dwc:organismQuantity .

<urn:uuid:9c150f88-1fc4-47b7-b826-f6357c104946> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_OCCURRENCESTATUS_ASSUMEDDEFAULT" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:NotEmpty; FILLED_IN the value of dwc:occurrenceStatus using the bdqval:defaultOccurrenceStatus Parameter value if dwc:occurrenceStatus,dwc:individualCount and dwc:organismQuantity are bdqval:Empty; otherwise NOT_AMENDED bdqval:defaultOccurrenceStatus default = \"present\"" ;
    skos:example "dwc:occurrenceStatus=\"\", dwc:individualCount=\"\", dwc:organismQuantity=\"\": Response.status=FILLED_IN, Response.result=dwc:occurrenceStatus=\"present\", Response.comment=\"dwc:occurrenceStatus is bdqval:Empty; assumed \"present\"\"",
        "dwc:occurrenceStatus=\"X\", dwc:individualCount=\"10\", dwc:organismQuantity=\"\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:occurrenceStatus is bdqval:NotEmpty\"" ;
    bdqffdq:hasArgument <urn:uuid:a558165b-7014-4029-839f-33badcb0842f> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:defaultOccurrenceStatus default = \"present\"" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:occurrenceStatus is bdqval:NotEmpty; FILLED_IN the value of dwc:occurrenceStatus using the bdqval:defaultOccurrenceStatus Parameter value if dwc:occurrenceStatus,dwc:individualCount and dwc:organismQuantity are bdqval:Empty; otherwise NOT_AMENDED" .

<urn:uuid:a558165b-7014-4029-839f-33badcb0842f> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:defaultOccurrenceStatus:\"present\"" ;
    bdqffdq:hasArgumentValue "present" ;
    bdqffdq:hasParameter bdqval:defaultOccurrenceStatus .

<urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:occurrenceStatus" ;
    skos:prefLabel "Information Element ActedUpon dwc:occurrenceStatus" ;
    bdqffdq:composedOf dwc:occurrenceStatus .

<https://rs.tdwg.org/bdqtest/terms/version/96667a0a-ae59-446a-bbb0-b7f2b0ca6cf5-2024-11-13> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_OCCURRENCESTATUS_ASSUMEDDEFAULT" ;
    dcterms:description "Proposes an amendment of the value of dwc:occurrenceStatus to the default parameter value if dwc:occurrenceStatus, dwc:individualCount and dwc:organismQuantity are empty." ;
    dcterms:isVersionOf bdqtest:96667a0a-ae59-446a-bbb0-b7f2b0ca6cf5 ;
    dcterms:issued "2024-11-13"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/75" ;
    skos:note "There is currently a capitalization mismatch between https://dwc.tdwg.org/terms/#dwc:occurrenceStatus recommended values and the GBIF vocabulary at (https://api.gbif.org/v1/vocabularies/OccurrenceStatus/concepts)." ;
    skos:prefLabel "Amendment dwc:occurrenceStatus Assumed Default for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e251108c-ae49-46fa-b5db-d955fd0f4fa4> ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:2c32cfc9-66d2-4512-9ebb-b3253c7b5dd5> ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2024-11-13"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:AssumedDefault ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

