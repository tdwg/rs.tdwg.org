  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/fedf27b2-e01d-459f-98fc-7f0f39e3d4be-2024-09-19">
    <dcterms:description>Measure if all VALIDATION_COUNTRYCODE_STANDARD in a record set are COMPLIANT or INTERNAL_PREREQUISITES_NOT_MET (indicating some empty value).</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/fedf27b2-e01d-459f-98fc-7f0f39e3d4be"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-19</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.1371/journal.pone.0178731"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_QA_COUNTRYCODE_STANDARD</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/297</skos:historyNote>
    <skos:note>For Quality Assurance, filter record set until this measure is COMPLETE.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord for QualityAssurance of Validation dwc:countryCode Standard for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:fb80d5bf-7777-4d88-b09f-116a38ab7bfa"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-19</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
