<urn:uuid:033157e4-b8c3-466b-ba9a-38bc9b3ad86d> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:higherGeographyID, dwc:higherGeography, dwc:continent, dwc:country, dwc:countryCode, dwc:stateProvince, dwc:county, dwc:municipality, dwc:waterBody, dwc:island, dwc:islandGroup, dwc:locality, dwc:locationID, dwc:verbatimLocality, dwc:decimalLatitude, dwc:decimalLongitude, dwc:verbatimCoordinates, dwc:verbatimLatitude, dwc:verbatimLongitude, dwc:footprintWKT" ;
    skos:prefLabel "Information Element ActedUpon dwc:higherGeographyID, dwc:higherGeography, dwc:continent, dwc:country, dwc:countryCode, dwc:stateProvince, dwc:county, dwc:municipality, dwc:waterBody, dwc:island, dwc:islandGroup, dwc:locality, dwc:locationID, dwc:verbatimLocality, dwc:decimalLatitude, dwc:decimalLongitude, dwc:verbatimCoordinates, dwc:verbatimLatitude, dwc:verbatimLongitude, dwc:footprintWKT" ;
    bdqffdq:composedOf dwc:continent,
        dwc:country,
        dwc:countryCode,
        dwc:county,
        dwc:decimalLatitude,
        dwc:decimalLongitude,
        dwc:footprintWKT,
        dwc:higherGeography,
        dwc:higherGeographyID,
        dwc:island,
        dwc:islandGroup,
        dwc:locality,
        dwc:locationID,
        dwc:municipality,
        dwc:stateProvince,
        dwc:verbatimCoordinates,
        dwc:verbatimLatitude,
        dwc:verbatimLocality,
        dwc:verbatimLongitude,
        dwc:waterBody .

<urn:uuid:30ed5e2d-ef30-4988-8dbb-12c119e94ac3> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_LOCATION_NOTEMPTY" ;
    dcterms:description "COMPLIANT if at least one term needed to determine the location of the entity exists and is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:locationID=\"\", dwc:higherGeographyID=\"\", dwc:higherGeography=\"\", dwc:continent=\"\", dwc:waterBody=\"\", dwc:islandGroup=\"\", dwc:island=\"\", dwc:country=\"\", dwc:countryCode=\"\", dwc:stateProvince=\"\", dwc:county=\"\", dwc:municipality=\"\", dwc:locality=\"\", dwc:verbatimLocality=\"\", dwc:decimalLatitude=\"\", dwc:decimalLongitude=\"\", dwc:coordinateUncertaintyInMeters=\"\", dwc:geodeticDatum=\"\", dwc:verbatimCoordinates=\"\", dwc:verbatimLatitude=\"\", dwc:verbatimLongitude=\"\", dwc:footprintWKT=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"All location fields are bdqval:Empty\"",
        "dwc:locationID=\"https://opencontext.org/subjects/e54377f7-4452-4315-b676-40679b10c4d9\", dwc:higherGeographyID=\"\", dwc:higherGeography=\"\",dwc:continent=\"\", dwc:waterBody=\"\", dwc:islandGroup=\"\", dwc:island=\"\", dwc:country=\"\", dwc:countryCode=\"\", dwc:stateProvince=\"\", dwc:county=\"\", dwc:municipality=\"\", dwc:locality=\"\", dwc:verbatimLocality=\"\", dwc:decimalLatitude=\"\", dwc:decimalLongitude=\"\", dwc:coordinateUncertaintyInMeters=\"\", dwc:geodeticDatum=\"\", dwc:verbatimCoordinates=\"\", dwc:verbatimLatitude=\"\", dwc:verbatimLongitude=\"\", dwc:footprintWKT=\"\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:LocationID is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if at least one term needed to determine the location of the entity exists and is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/58486cb6-1114-4a8a-ba1e-bd89cfe887e9-2025-03-07> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_LOCATION_NOTEMPTY" ;
    dcterms:description "Is there a value in any of the Darwin Core spatial terms that could specify a location?" ;
    dcterms:isVersionOf bdqtest:58486cb6-1114-4a8a-ba1e-bd89cfe887e9 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/40" ;
    skos:note "Only fails if all of the relevant fields of the Darwin Core Location class are EMPTY or do not exist. Relevant Darwin Core fields include dwc:locationID, dwc:higherGeographyID, dwc:higherGeography, dwc:continent, dwc:waterBody, dwc:islandGroup, dwc:island, dwc:country, dwc:countryCode, dwc:stateProvince, dwc:county, dwc:municipality, dwc:locality, dwc:verbatimLocality, dwc:decimalLatitude, dwc:decimalLongitude, dwc:verbatimCoordinates, dwc:verbatimLatitude, dwc:verbatimLongitude, dwc:footprintWKT. Elevation and/or depth alone are deemed insufficient to meaningfully locate a position on the earth." ;
    skos:prefLabel "Validation dcterms:Location Not Empty for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:033157e4-b8c3-466b-ba9a-38bc9b3ad86d> ;
    bdqffdq:hasCriterion bdqcrit:NotEmpty ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

