    <rdfs:label>Specification for: MULTIRECORD_MEASURE_QA_YEAR_NOTEMPTY</rdfs:label>
    <skos:example></skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLETE if every VALIDATION_YEAR_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</bdqffdq:hasExpectedResponse>
  </rdf:Description>
