  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/a8fef8a8-e7c7-4a2d-adaf-7da99c896c93-2025-03-06">
    <dcterms:description>Measure if all VALIDATION_YEAR_NOTEMPTY in a record set are COMPLIANT.</dcterms:description>
