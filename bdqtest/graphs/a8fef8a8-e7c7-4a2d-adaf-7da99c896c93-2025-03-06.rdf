    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:8294c0a6-b46b-48a5-8221-993d35e09017">
    <dcterms:description>COMPLETE if every VALIDATION_YEAR_NOTEMPTY in the MultiRecord has Response.result=COMPLIANT; otherwise NOT_COMPLETE.</dcterms:description>
