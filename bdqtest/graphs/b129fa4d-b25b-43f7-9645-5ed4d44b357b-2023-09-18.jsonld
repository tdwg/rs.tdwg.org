  {
    "@id": "https://rs.tdwg.org/bdqtest/terms/version/b129fa4d-b25b-43f7-9645-5ed4d44b357b-2023-09-18",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Amendment"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "Proposes an amendment to the value of dwc:day as an integer between 1 and 31 inclusive."
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
      {
        "@id": "https://rs.tdwg.org/bdqtest/terms/b129fa4d-b25b-43f7-9645-5ed4d44b357b"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-09-18"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "AMENDMENT_DAY_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/127"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "If dwc:day contains text that may be interpreted as Roman numerals, the result will be NOT_AMENDED as this is not standard. Values such as \"3rd\" or \"12th\" can be interpreted as the integers \"3\" and \"12\". Text such as \"5th Friday\" is ambiguous."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Amendment dwc:day Standardized for SingleRecord"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasActedUponInformationElement": [
      {
        "@id": "urn:uuid:d7853c0b-2e3a-4bbf-89c6-89123ca626bf"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDataQualityDimension": [
      {
        "@id": "https://rs.tdwg.org/bdqdim/terms/Conformance"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasDateLastUpdated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2023-09-18"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasEnhancement": [
      {
        "@id": "https://rs.tdwg.org/bdqenh/terms/Standardized"
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasResourceType": [
      {
        "@id": "https://rs.tdwg.org/bdqffdq/terms/SingleRecord"
      }
    ]
  },
  {
    "@id": "https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/UseCase"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bdquc:Spatial-Temporal_Patterns"
      }
    ]
  },
  {
    "@id": "urn:uuid:3eae7451-19c6-403c-ba36-29f8204d15ff",
    "@type": [
      "https://rs.tdwg.org/bdqffdq/terms/Specification"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; AMENDED the value of dwc:day if the value is unambiguously interpreted as an integer between 1 and 31 inclusive; otherwise NOT_AMENDED"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: AMENDMENT_DAY_STANDARDIZED"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:day=\"23rd\": Response.status=AMENDED, Response.result=dwc:day=\"23\", Response.comment=\"dwc:day is interpretable as \"23\"\""
      },
      {
        "@value": "dwc:day=\"X\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:day is ambiguous, either a \"X\", \"No data\" or \"10\"\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "INTERNAL_PREREQUISITES_NOT_MET if dwc:day is bdqval:Empty; AMENDED the value of dwc:day if the value is unambiguously interpreted as an integer between 1 and 31 inclusive; otherwise NOT_AMENDED"
      }
    ]
  },
