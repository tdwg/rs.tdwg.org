  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/241a279c-76d5-499b-ab49-a47ad7f8df50-2024-08-18">
    <dcterms:description>Measure if all VALIDATION_BASISOFRECORD_STANDARD in a record set are COMPLIANT.</dcterms:description>
