<urn:uuid:a3c8b277-15fb-4ae8-afb1-e64fb6eb5241> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_GEODETICDATUM_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:geodeticDatum is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:geodeticDatum=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:geodeticDatum is bdqval:Empty.\"",
        "dwc:geodeticDatum=\"UTM\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:geodeticDatum is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:geodeticDatum is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

