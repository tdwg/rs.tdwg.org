    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "COMPLIANT if dwc:country is bdqval:NotEmpty or dwc:countryCode has a value of \"XZ\" and either dwc:country is bdqval:Empty or has a value of \"High seas\"; otherwise NOT_COMPLIANT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_COUNTRY_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "dwc:country=\"Eswatini\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:country is bdqval:NotEmpty\""
      },
      {
        "@value": "dwc:country=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:country is bdqval:Empty\""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasAuthoritiesDefaults": [
      {
        "@value": ""
      }
    ],
    "https://rs.tdwg.org/bdqffdq/terms/hasExpectedResponse": [
      {
        "@value": "COMPLIANT if dwc:country is bdqval:NotEmpty or dwc:countryCode has a value of \"XZ\" and either dwc:country is bdqval:Empty or has a value of \"High seas\"; otherwise NOT_COMPLIANT"
      }
    ]
