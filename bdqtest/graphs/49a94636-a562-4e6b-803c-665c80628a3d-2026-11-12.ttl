<urn:uuid:aefe88ed-6d3a-4824-8c4a-a75714cb0351> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_VALIDATIONTESTS_PREREQUISITESNOTMET" ;
    dcterms:description "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.status=INTERNAL_PREREQUISITES_NOT_MET or Response.status=EXTERNAL_PREREQUISITES_NOT_MET." ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"27\", Response.comment=\"27 VALIDATION Tests had Response.status=INTERNAL_PREREQUISITES_NOT_MET or EXTERNAL_PREREQUISITES_NOT_MET.\"]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "RUN_HAS_RESULT with the result being the number of distinct VALIDATION Tests run on the record that have Response.status=INTERNAL_PREREQUISITES_NOT_MET or Response.status=EXTERNAL_PREREQUISITES_NOT_MET." .

<urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon bdqval:AllValidationTestsRunOnSingleRecord" ;
    skos:prefLabel "Information Element ActedUpon bdqval:AllValidationTestsRunOnSingleRecord" ;
    bdqffdq:composedOf bdqval:AllValidationTestsRunOnSingleRecord .

<https://rs.tdwg.org/bdqtest/terms/version/49a94636-a562-4e6b-803c-665c80628a3d-2026-11-12> a bdqffdq:Measure ;
    rdfs:label "MEASURE_VALIDATIONTESTS_PREREQUISITESNOTMET" ;
    dcterms:description "A count of the distinct VALIDATION Tests run on a record that have Response.status=INTERNAL_PREREQUISITES_NOT_MET or EXTERNAL_PREREQUISITES_NOT_MET." ;
    dcterms:isVersionOf bdqtest:49a94636-a562-4e6b-803c-665c80628a3d ;
    dcterms:issued "2026-11-12"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/134" ;
    skos:note "We have three individual measures for pass (MEASURE_VALIDATIONTESTS_COMPLIANT (45fb49eb-4a1b-4b49-876f-15d5034dfc73)), fail (MEASURE_VALIDATIONTESTS_NOTCOMPLIANT (453844ae-9df4-439f-8e24-c52498eca84a)), and PREREQUISITES_NOT_MET (49a94636-a562-4e6b-803c-665c80628a3d). To get the total number of Tests that were attempted, add all three measures. To get the total number of Tests that ran, add NOT_COMPLIANT (fail) and COMPLIANT (pass). If no VALIDATION Tests were run on the record, the result is 0." ;
    skos:prefLabel "Measure Validation Tests Prerequisites Not Met for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd> ;
    bdqffdq:hasDataQualityDimension bdqdim:Completeness ;
    bdqffdq:hasDateLastUpdated "2026-11-12"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

