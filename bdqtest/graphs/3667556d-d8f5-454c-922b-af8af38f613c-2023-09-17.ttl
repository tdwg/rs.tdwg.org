<https://doi.org/10.15468/39omei> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "GBIF Secretariat (2023) GBIF Backbone Taxonomy. Checklist dataset. https://doi.org/10.15468/39omei" .

bdqcrit:Found a bdqffdq:Criterion ;
    rdfs:label "Found" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Taxon-Management a bdqffdq:UseCase ;
    rdfs:label "bdquc:Taxon-Management" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:146784a4-b53c-4245-a813-c41896761279> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF Backbone Taxonomy\"" ;
    bdqffdq:hasArgumentValue "GBIF Backbone Taxonomy" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:16f999d9-1cf5-4208-b2ca-1a93d6700085> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_FAMILY_FOUND" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:family is bdqval:Empty; COMPLIANT if the value of dwc:family is found as a value at the rank of Family in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"GBIF Backbone Taxonomy\" {[https://doi.org/10.15468/39omei]} {API endpoint [https://api.gbif.org/v1/species?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&name=]}" ;
    skos:example "dwc:family=\"Agaricacae\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"bdqval:family does not have an equivalent at the rank of Family in the Parameterized Source Authority\"",
        "dwc:family=\"Agaricaceae\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"bdqval:family has an equivalent at the rank of Family in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:146784a4-b53c-4245-a813-c41896761279> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF Backbone Taxonomy\" {[https://doi.org/10.15468/39omei]} {API endpoint [https://api.gbif.org/v1/species?datasetKey=d7dddbf4-2cf0-4f39-9b2a-bb099caae36c&name=]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:family is bdqval:Empty; COMPLIANT if the value of dwc:family is found as a value at the rank of Family in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<urn:uuid:c3987992-230d-4c2e-816c-5b72d98218eb> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:family" ;
    skos:prefLabel "Information Element ActedUpon dwc:family" ;
    bdqffdq:composedOf dwc:family .

<https://rs.tdwg.org/bdqtest/terms/version/3667556d-d8f5-454c-922b-af8af38f613c-2023-09-17> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_FAMILY_FOUND" ;
    dcterms:description "Does the value of dwc:family occur at the rank of Family in the bdqval:sourceAuthority?" ;
    dcterms:isVersionOf bdqtest:3667556d-d8f5-454c-922b-af8af38f613c ;
    dcterms:issued "2023-09-17"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/39omei> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/28" ;
    skos:note "The purpose of this Test is to check whether the value is a name that is a result of a nomenclatural act at this rank. This excludes unpublished names, misspellings and vernacular names. It is expected that the Test will designate the source authority against which to check. The same Test might return distinct results when using distinct source authorities. **Review Note: GBIF has indicated that we should switch to the Catalog of Life for the default source authority for this test. That change is planned prior to ratification.**" ;
    skos:prefLabel "Validation dwc:family Found for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:c3987992-230d-4c2e-816c-5b72d98218eb> ;
    bdqffdq:hasCriterion bdqcrit:Found ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-17"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

