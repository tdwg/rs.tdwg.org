    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/footprintWKT"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/higherGeography"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/higherGeographyID"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/island"/>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/islandGroup"/>
