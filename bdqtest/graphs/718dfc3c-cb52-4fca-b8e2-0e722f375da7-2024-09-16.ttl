<urn:uuid:6e0e22a1-c233-4c13-baa7-0ab48a4340e4> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_EVENTDATE_STANDARDIZED" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; AMENDED if the value of dwc:eventDate is not a properly formatted ISO 8601 date but is unambiguous, and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED" ;
    skos:example "dwc:eventDate=\"10-28\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:eventDate contains an ambiguous value\"",
        "dwc:eventDate=\"2021-28-10\": Response.status=AMENDED, Response.result=dwc:eventDate=\"2021-10-28\", Response.comment=\"dwc:eventDate contains an interpretable value. Assuming year-day-month input format\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:eventDate is bdqval:Empty; AMENDED if the value of dwc:eventDate is not a properly formatted ISO 8601 date but is unambiguous, and altered to be a valid ISO 8601 date; otherwise NOT_AMENDED" .

<urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:eventDate" ;
    skos:prefLabel "Information Element ActedUpon dwc:eventDate" ;
    bdqffdq:composedOf dwc:eventDate .

<https://rs.tdwg.org/bdqtest/terms/version/718dfc3c-cb52-4fca-b8e2-0e722f375da7-2024-09-16> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_EVENTDATE_STANDARDIZED" ;
    dcterms:description "Proposes an amendment of the value of dwc:eventDate to a valid ISO date." ;
    dcterms:isVersionOf bdqtest:718dfc3c-cb52-4fca-b8e2-0e722f375da7 ;
    dcterms:issued "2024-09-16"^^xsd:date ;
    dcterms:references <https://en.wikipedia.org/wiki/ISO_8601>,
        <https://www.iso.org/obp/ui/>,
        <https://www.loc.gov/standards/datetime/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/61" ;
    skos:note "The intent of the amended range is to capture the original uncertainty where possible. As in the example, we amend \"1999-11\" instead of \"1999-11-01/1999-11-31\". An AMBIGUOUS response is possible." ;
    skos:prefLabel "Amendment dwc:eventDate Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:e8c9ef54-af43-4c20-98a8-a7865cc169ac> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-09-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

