<urn:uuid:381b0edb-0fb4-4a8e-a77b-badcfa286961> a bdqffdq:AmendmentMethod ;
    rdfs:label "AmendmentMethod: AMENDMENT_EVENTDATE_STANDARDIZED with Specification Specification for: AMENDMENT_EVENTDATE_STANDARDIZED" ;
