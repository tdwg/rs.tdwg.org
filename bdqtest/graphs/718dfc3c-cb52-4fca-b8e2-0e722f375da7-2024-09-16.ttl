        "Example Implementations: Kurator/FilteredPush event_date_qc Library (Morris & Lowery 2025)",
        "TG2 Amendment TIME CODED Test Conformance ISO/DCMI STANDARD CORE" ;
    skos:prefLabel "AmendmentMethod: AMENDMENT_EVENTDATE_STANDARDIZED with Specification Specification for: AMENDMENT_EVENTDATE_STANDARDIZED" ;
    bdqffdq:forAmendment <https://rs.tdwg.org/bdqtest/terms/version/718dfc3c-cb52-4fca-b8e2-0e722f375da7-2024-09-16> ;
    bdqffdq:hasSpecification <urn:uuid:6e0e22a1-c233-4c13-baa7-0ab48a4340e4> .

