    dcterms:bibliographicCitation "Dublin Core (2012) DCMI Type Vocabulary. https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/" .

<urn:uuid:2aee4d8d-4064-41ca-b67f-d5f591b41526> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dc:type" ;
    skos:prefLabel "Information Element ActedUpon dc:type" ;
    bdqffdq:composedOf dc:type .

<urn:uuid:b85129f0-28c2-4ede-aff2-5ce3791c6e86> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DCTYPE_STANDARD" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dc:type is bdqval:Empty; COMPLIANT if the value of dc:type is a term name in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT DCMI Type Vocabulary\" {[http://purl.org/dc/terms/DCMIType]} {\"DCMI Type Vocabulary List of Terms\" [https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/2010-10-11/]}" ;
    skos:example "dc:type=\"Event\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dc:type matches a term in DCMI Vocabulary\"",
        "dc:type=\"StillerImage\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dc:type does not match terms in DCMI Vocabulary\"" ;
    bdqffdq:hasAuthoritiesDefaults "DCMI Type Vocabulary\" {[http://purl.org/dc/terms/DCMIType]} {\"DCMI Type Vocabulary List of Terms\" [https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/2010-10-11/]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dc:type is bdqval:Empty; COMPLIANT if the value of dc:type is a term name in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT" .

<https://rs.tdwg.org/bdqtest/terms/version/cdaabb0d-a863-49d0-bc0f-738d771acba5-2023-09-18> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_DCTYPE_STANDARD" ;
    dcterms:description "Does the value of dc:type occur as a value in the DCMI type vocabulary?" ;
    dcterms:isVersionOf bdqtest:cdaabb0d-a863-49d0-bc0f-738d771acba5 ;
    dcterms:issued "2023-09-18"^^xsd:date ;
    dcterms:references <https://www.dublincore.org/specifications/dublin-core/dcmi-type-vocabulary/> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/91" ;
    skos:note "This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters. EXTERNAL_PREREQUISITES_NOT_MET is not a necessary path in the specification, the type literals may be hard coded in a Test implementation without an external call." ;
    skos:prefLabel "Validation dc:type Standard for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:2aee4d8d-4064-41ca-b67f-d5f591b41526> ;
    bdqffdq:hasCriterion bdqcrit:Standard ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2023-09-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

