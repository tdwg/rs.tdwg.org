  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/de661615-b338-4557-af5b-d44a89de40fa-2025-03-06">
    <dcterms:description>Count the number of VALIDATION_TAXONRANK_NOTEMPTY in a record set that are COMPLIANT.</dcterms:description>
