bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:46caea46-0c94-4efb-9e5f-1b170f2ad54e> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_COORDINATES_TRANSPOSED" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if any of dwc:decimalLatitude or dwc:decimalLongitude or dwc:countryCode are bdqval:Empty; AMENDED dwc:decimalLatitude and dwc:decimalLongitude if the coordinates were transposed or one or more of the signs of the coordinates were reversed to align the location with dwc:countryCode according to the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}" ;
    skos:example "dwc:decimalLatitude=\"25.46\", dwc:decimalLongitude=\"135.87\", dwc:countryCode=\"AU\": Response.status=AMENDED, Response.result=dwc:decimalLatitude=\"-25.46\", dwc:decimalLongitude=\"135.87\", Response.comment=\"dwc:decimalLatitude sign reversed to fit dwc:countryCode=AU\"",
        "dwc:decimalLatitude=\"25.46\", dwc:decimalLongitude=\"135.87\", dwc:countryCode=\"AX\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:countryCode is uninterpretable\"" ;
    bdqffdq:hasArgument <urn:uuid:95e1332e-eeca-4b41-8698-88ffc33cef3f> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if any of dwc:decimalLatitude or dwc:decimalLongitude or dwc:countryCode are bdqval:Empty; AMENDED dwc:decimalLatitude and dwc:decimalLongitude if the coordinates were transposed or one or more of the signs of the coordinates were reversed to align the location with dwc:countryCode according to the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<urn:uuid:95e1332e-eeca-4b41-8698-88ffc33cef3f> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"10m-admin-1 boundaries UNION with Exclusive Economic Zones\"" ;
    bdqffdq:hasArgumentValue "10m-admin-1 boundaries UNION with Exclusive Economic Zones" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<urn:uuid:9d387033-c581-4fb5-9af2-73ec89c99e77> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:decimalLatitude, dwc:decimalLongitude" ;
    skos:prefLabel "Information Element ActedUpon dwc:decimalLatitude, dwc:decimalLongitude" ;
    bdqffdq:composedOf dwc:decimalLatitude,
        dwc:decimalLongitude .

<urn:uuid:d24a7b73-972a-4fdd-a790-91acb5fcf725> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted dwc:countryCode" ;
    skos:prefLabel "Information Element Consulted dwc:countryCode" ;
    bdqffdq:composedOf dwc:countryCode .

<https://rs.tdwg.org/bdqtest/terms/version/f2b4a50a-6b2f-4930-b9df-da87b6a21082-2025-03-07> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_COORDINATES_TRANSPOSED" ;
    dcterms:description "Proposes an amendment transposing or changing the signs of dwc:decimalLatitude and/or dwc:decimalLongitude to align the location with the dwc:countryCode." ;
    dcterms:isVersionOf bdqtest:f2b4a50a-6b2f-4930-b9df-da87b6a21082 ;
    dcterms:issued "2025-03-07"^^xsd:date ;
    dcterms:references <https://doi.org/10.15468/doc-gg7h-s853> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/54" ;
    skos:note "The dwc:geodeticDatum is not necessary for this Test. The maximum positional shift between any geographic coordinate reference system and WGS84 is less than 6 km, so any hemisphere Test that relies on a country code for consistency would not be affected by the potential shift. The prior VALIDATION for this Test is VALIDATION_COORDINATE_COUNTRYCODE_CONSISTENT (adb27d29-9f0d-4d52-b760-a77ba57a69c9)." ;
    skos:prefLabel "Amendment Coordinates Transposed for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:9d387033-c581-4fb5-9af2-73ec89c99e77> ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:d24a7b73-972a-4fdd-a790-91acb5fcf725> ;
    bdqffdq:hasDataQualityDimension bdqdim:Consistency ;
    bdqffdq:hasDateLastUpdated "2024-11-11"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Transposed ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

