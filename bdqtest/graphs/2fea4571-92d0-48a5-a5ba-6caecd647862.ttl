<https://rs.tdwg.org/bdqtest/specification/e032ea6a-012d-436d-a442-da167a466b02> a bdqffdq:Specification ;
    rdfs:label "Specification for: MULTIRECORD_MEASURE_QA_OCCURRENCESTATUS_STANDARD" ;
