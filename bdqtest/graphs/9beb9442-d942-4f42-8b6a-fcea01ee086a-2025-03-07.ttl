<urn:uuid:c893ee17-ee8b-43ec-bf17-97ac814ea502> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_DECIMALLONGITUDE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:decimalLongitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:decimalLongitude=\" \": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:decimalLongitude is bdqval:Empty\"",
        "dwc:decimalLongitude=\"0\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:decimalLongitude is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:decimalLongitude is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

