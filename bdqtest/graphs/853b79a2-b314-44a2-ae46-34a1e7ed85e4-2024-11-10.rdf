  <rdf:Description rdf:about="urn:uuid:930eb72e-fe83-48ae-9698-ca46713721a3">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_COUNTRYCODE_NOTEMPTY with Specification for: VALIDATION_COUNTRYCODE_NOTEMPTY</rdfs:label>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2308</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris &amp; Lowery 2025b)</skos:note>
    <skos:note>TG2 Validation SPACE CODED Test VOCABULARY Completeness CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_COUNTRYCODE_NOTEMPTY with Specification for: VALIDATION_COUNTRYCODE_NOTEMPTY</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/853b79a2-b314-44a2-ae46-34a1e7ed85e4-2024-11-10"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:d153d4bd-b39d-43b0-b00a-395ff3e2ca62"/>
  </rdf:Description>
