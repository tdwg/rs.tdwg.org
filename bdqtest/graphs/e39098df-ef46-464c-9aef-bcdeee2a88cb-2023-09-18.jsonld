      {
        "@value": "Information Element ActedUpon dwc:taxonRank"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Information Element ActedUpon dwc:taxonRank"
      }
    ],
