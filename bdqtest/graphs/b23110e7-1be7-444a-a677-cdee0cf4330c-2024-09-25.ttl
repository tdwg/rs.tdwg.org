<urn:uuid:0348eccf-fc7f-49b3-88b6-1d911e98cbbb> a bdqffdq:ValidationPolicy ;
    rdfs:label "ValidationPolicy: (47) validations  in UseCase bdquc:Spatial-Temporal_Patterns" ;
    skos:prefLabel "ValidationPolicy: (47) validations  in UseCase bdquc:Spatial-Temporal_Patterns" ;
    bdqffdq:hasUseCase bdquc:Spatial-Temporal_Patterns ;
    bdqffdq:includedInPolicy <https://rs.tdwg.org/bdqtest/terms/version/b23110e7-1be7-444a-a677-cdee0cf4330c-2024-09-25> .

<urn:uuid:3925c15a-2795-4cef-8a30-6e6e5e480eae> a bdqffdq:ValidationMethod ;
    rdfs:label "ValidationMethod: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT with Specification for: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT" ;
    skos:historyNote "Source: GBIF" ;
    skos:note "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L1675",
        "Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris & Lowery 2025b)",
        "TG2 Validation SPACE CODED Test VOCABULARY Consistency ISO/DCMI STANDARD CORE" ;
    skos:prefLabel "ValidationMethod: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT with Specification for: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT" ;
    bdqffdq:forValidation <https://rs.tdwg.org/bdqtest/terms/version/b23110e7-1be7-444a-a677-cdee0cf4330c-2024-09-25> ;
    bdqffdq:hasSpecification <urn:uuid:6f1093a0-0da5-4691-a95e-184d6d55eeb0> .

<https://datahub.io/core/country-list> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "DataHub (2018) List of all countries with their two digit codes (ISO 3166-1). https://datahub.io/core/country-list" .

<https://doi.org/10.15468/doc-gg7h-s853> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "Chapman AD and Wieczorek JR (2020) Georeferencing Best Practices. Copenhagen: GBIF Secretariat. https://doi.org/10.15468/doc-gg7h-s853" .

bdqcrit:Consistent a bdqffdq:Criterion ;
    rdfs:label "Consistent" .

bdqdim:Consistency a bdqffdq:DataQualityDimension ;
    rdfs:label "Consistency" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Spatial-Temporal_Patterns a bdqffdq:UseCase ;
    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

<https://www.iso.org/iso-3166-country-codes.html> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "ISO (n.dat.) ISO 3166 Country Codes. https://www.iso.org/iso-3166-country-codes.html" .

<urn:uuid:6f1093a0-0da5-4691-a95e-184d6d55eeb0> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either of the terms dwc:country or dwc:countryCode are bdqval:Empty; COMPLIANT if the values of dwc:country and dwc:countryCode match national-level country name and matching country code respectively in the bdqval:sourceAuthority bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}" ;
    skos:example "dwc:country=\"Australia\", dwc:countryCode=\"AU\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:country matches dwc:countryCode\"",
        "dwc:country=\"United States Minor Outlying Islands\", dwc:countryCode=\"US\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:country does not match dwc:countryCode\"" ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either of the terms dwc:country or dwc:countryCode are bdqval:Empty; COMPLIANT if the values of dwc:country and dwc:countryCode match national-level country name and matching country code respectively in the bdqval:sourceAuthority" .

<urn:uuid:9cada38d-ed7c-485d-8b9b-ea57e4124253> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:country, dwc:countryCode" ;
    skos:prefLabel "Information Element ActedUpon dwc:country, dwc:countryCode" ;
    bdqffdq:composedOf dwc:country,
        dwc:countryCode .

<https://rs.tdwg.org/bdqtest/terms/version/b23110e7-1be7-444a-a677-cdee0cf4330c-2024-09-25> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT" ;
    dcterms:description "Does the ISO country code, determined from the value of dwc:country, equal the value of dwc:countryCode?" ;
    dcterms:isVersionOf bdqtest:b23110e7-1be7-444a-a677-cdee0cf4330c ;
    dcterms:issued "2024-09-25"^^xsd:date ;
    dcterms:references <https://datahub.io/core/country-list>,
        <https://doi.org/10.15468/doc-gg7h-s853>,
        <https://www.iso.org/iso-3166-country-codes.html> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/62" ;
    skos:note "The country code determination service should be able to match the name of a country in the original or any language in the source authority. When dwc:countryCode=\"XZ\" to designate \"high seas\", dwc:country should be empty. This Test must return NOT_COMPLIANT if there is leading or trailing whitespace or there are leading or trailing non-printing characters." ;
    skos:prefLabel "Validation dwc:country dwc:countryCode Consistent for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:9cada38d-ed7c-485d-8b9b-ea57e4124253> ;
    bdqffdq:hasCriterion bdqcrit:Consistent ;
    bdqffdq:hasDataQualityDimension bdqdim:Consistency ;
    bdqffdq:hasDateLastUpdated "2024-09-25"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

