<urn:uuid:b611e1b1-cbf5-405c-b24d-24e9a649cbf0> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_VALIDATIONTESTS_COMPLIANT" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if no Tests of type VALIDATION were attempted to be run; Report the number of Tests of output type VALIDATION run against the record that were COMPLIANT (passed)" ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"7\", Response.comment=\"7 VALIDATION Tests had Response.status=\"COMPLIANT\" ]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if no Tests of type VALIDATION were attempted to be run; Report the number of Tests of output type VALIDATION run against the record that were COMPLIANT (passed)" .

<urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd> a bdqffdq:Consulted ;
    rdfs:label "Information Element Consulted bdqval:AllValidationTestsRunOnSingleRecord" ;
    skos:prefLabel "Information Element Consulted bdqval:AllValidationTestsRunOnSingleRecord" ;
    bdqffdq:composedOf bdqval:AllValidationTestsRunOnSingleRecord .

<https://rs.tdwg.org/bdqtest/terms/version/45fb49eb-4a1b-4b49-876f-15d5034dfc73-2024-09-25> a bdqffdq:Measure ;
    rdfs:label "MEASURE_VALIDATIONTESTS_COMPLIANT" ;
    dcterms:description "Measures the number of distinct VALIDATION Tests that have a Response.status=\"COMPLIANT\" for a given record." ;
    dcterms:isVersionOf bdqtest:45fb49eb-4a1b-4b49-876f-15d5034dfc73 ;
    dcterms:issued "2024-09-25"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/135" ;
    skos:note "We have three individual measures for pass (MEASURE_VALIDATIONTESTS_COMPLIANT (45fb49eb-4a1b-4b49-876f-15d5034dfc73)), fail (MEASURE_VALIDATIONTESTS_NOTCOMPLIANT (453844ae-9df4-439f-8e24-c52498eca84a)), and PREREQUISITES_NOT_MET (49a94636-a562-4e6b-803c-665c80628a3d). To get the total number of Tests that were attempted, add all three measures. To get the total number of Tests that ran, add NOT_COMPLIANT (fail) and COMPLIANT (pass)." ;
    skos:prefLabel "Measure Validation Tests Compliant for SingleRecord" ;
    bdqffdq:hasConsultedInformationElement <urn:uuid:cccfdbf6-f3b5-4c1e-a7fa-e059a9c416cd> ;
    bdqffdq:hasDataQualityDimension bdqdim:Reliability ;
    bdqffdq:hasDateLastUpdated "2024-08-18"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

