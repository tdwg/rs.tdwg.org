<urn:uuid:7e365897-cfc0-413e-a613-99c6050edc4b> a bdqffdq:Specification ;
    rdfs:label "Specification for: MEASURE_AMENDMENTS_PROPOSED" ;
    dcterms:description "RUN_HAS_RESULT with the result being the number of distinct AMENDMENT Tests run on the record that have Response.status=AMENDED or Response.status=FILLED_IN." ;
    skos:example "[Response.status=RUN_HAS_RESULT, Response.result=\"17\", Response.comment=\"17 AMENDMENT Tests had Response.status=AMENDED or FILLED_IN.\"]" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "RUN_HAS_RESULT with the result being the number of distinct AMENDMENT Tests run on the record that have Response.status=AMENDED or Response.status=FILLED_IN." .

