<https://rs.tdwg.org/bdqtest/terms/version/03049fe5-a575-404f-b564-ae63f5a1cf8b-2026-11-12> a bdqffdq:Measure ;
    rdfs:label "MEASURE_AMENDMENTS_PROPOSED" ;
    dcterms:description "A count of the distinct AMENDMENT Tests run on a record that have Response.status=AMENDED or FILLED_IN." ;
    dcterms:isVersionOf bdqtest:03049fe5-a575-404f-b564-ae63f5a1cf8b ;
    dcterms:issued "2026-11-12"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/65" ;
    skos:note "If no AMENDMENT Tests were run on the record, the result is 0." ;
    skos:prefLabel "Measure Amendments Proposed for SingleRecord" ;
