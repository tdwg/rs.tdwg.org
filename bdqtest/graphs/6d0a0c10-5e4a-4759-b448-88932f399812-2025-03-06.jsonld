      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "If the proposed eventDate is prior to 1918-02-14, the Response.comment will include a note that the \"verbatimDate was assumed to be in the Gregorian calendar\". When running the Test, the original precision, e.g. year=1980, month=1 should be retained, e.g. dwc:eventDate should become 1980-01, not 1980-01-01/1980-01-31."
      }
    ],
