<urn:uuid:1fae3f77-7fcb-42c6-ab43-1ff28adf4fa4> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_EVENTDATE_NOTEMPTY" ;
    dcterms:description "COMPLIANT if dwc:eventDate is bdqval:NotEmpty; otherwise NOT_COMPLIANT" ;
    skos:example "dwc:eventDate=\"\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:eventDate is bdqval:Empty\"",
        "dwc:eventDate=\"1964-11-01T10:00-0600\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:eventdate is bdqval:NotEmpty\"" ;
    bdqffdq:hasAuthoritiesDefaults "" ;
    bdqffdq:hasExpectedResponse "COMPLIANT if dwc:eventDate is bdqval:NotEmpty; otherwise NOT_COMPLIANT" .

