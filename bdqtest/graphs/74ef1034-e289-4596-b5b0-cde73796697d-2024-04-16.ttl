bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:ba1fa532-9612-4944-bfd1-8bd39ab47758> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_DEGREEOFESTABLISHMENT_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    skos:example "dwc:degreeOfEstablishment=\"capt.\": Response.status=AMENDED, Response.result=dwc:degreeOfEstablishment=\"captive\", Response.comment=\"dwc:degreeOfEstablishment contains an interpretable value in the bdqval:sourceAuthority\"",
        "dwc:degreeOfEstablishment=\"tree\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:degreeOfEstablishment does not contain an interpretable value in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:ff9e9459-d1a5-43a6-ada9-8be41772b711> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"Degree of Establishment Controlled Vocabulary List of Terms\" {[https://dwc.tdwg.org/doe/]} {GBIF vocabulary API [https://api.gbif.org/v1/vocabularies/DegreeOfEstablishment/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if dwc:degreeOfEstablishment is bdqval:Empty; AMENDED the value of dwc:degreeOfEstablishment if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED" .

<urn:uuid:c5abcb06-a1d0-4ed5-9513-c04c194293e6> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:degreeOfEstablishment" ;
    skos:prefLabel "Information Element ActedUpon dwc:degreeOfEstablishment" ;
    bdqffdq:composedOf dwc:degreeOfEstablishment .

<urn:uuid:ff9e9459-d1a5-43a6-ada9-8be41772b711> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"Degree of Establishment Controlled Vocabulary List of Terms\"" ;
    bdqffdq:hasArgumentValue "Degree of Establishment Controlled Vocabulary List of Terms" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<https://rs.tdwg.org/bdqtest/terms/version/74ef1034-e289-4596-b5b0-cde73796697d-2024-04-16> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_DEGREEOFESTABLISHMENT_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:degreeOfEstablishment using the bdqval:sourceAuthority." ;
    dcterms:isVersionOf bdqtest:74ef1034-e289-4596-b5b0-cde73796697d ;
    dcterms:issued "2024-04-16"^^xsd:date ;
    dcterms:references <http://dwc.tdwg.org/doe/>,
        <https://doi.org/10.3897/biss.3.38084> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/276" ;
    skos:note "For reference, synonyms for values of dwc:degreeOfEstablishment can be found at https://registry.gbif.org/vocabulary/DegreeOfEstablishment/concepts." ;
    skos:prefLabel "Amendment dwc:degreeOfEstablishment Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:c5abcb06-a1d0-4ed5-9513-c04c194293e6> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-04-16"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

