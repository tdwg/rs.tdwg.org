  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/9c66c116-6644-45b4-b4c7-db7a4ee7c500-2023-09-18">
    <dcterms:description>Count the number of VALIDATION_MINDEPTH_INRANGE in a record set that are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/9c66c116-6644-45b4-b4c7-db7a4ee7c500"/>
