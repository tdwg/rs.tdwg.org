   xmlns:bdqffdq="https://rs.tdwg.org/bdqffdq/terms/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/33c45ae1-e2db-462a-a59e-7169bb01c5d6-2024-03-25">
    <dcterms:description>Proposes an amendment to the value of dwc:sex using the bdqval:sourceAuthority.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/33c45ae1-e2db-462a-a59e-7169bb01c5d6"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-25</dcterms:issued>
    <dcterms:references rdf:resource="https://rs.gbif.org/vocabulary/gbif/sex.xml"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Amendment"/>
    <rdfs:label>AMENDMENT_SEX_STANDARDIZED</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/284</skos:historyNote>
    <skos:note>For reference, a list of synonyms for dwc:sex values can be found at https://registry.gbif.org/vocabulary/Sex/concepts.</skos:note>
    <skos:prefLabel>Amendment dwc:sex Standardized for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:81029ffa-2df8-4e9e-a7dd-fc67faad9205"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-25</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasEnhancement rdf:resource="https://rs.tdwg.org/bdqenh/terms/Standardized"/>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdquc/terms/Alien-Species">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/UseCase"/>
    <rdfs:label>bdquc:Alien-Species</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:97fb9cdf-68c2-4b0b-8b1d-351435d30722">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentMethod"/>
    <rdfs:label>AmendmentMethod: AMENDMENT_SEX_STANDARDIZED with Specification Specification for: AMENDMENT_SEX_STANDARDIZED</rdfs:label>
    <skos:historyNote>Source: TG2</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/rec_occur_qc/blob/v1.0.1/src/main/java/org/filteredpush/qc/metadata/DwCMetadataDQ.java#L2148</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush rec_occur_qc Library (Morris 2025)</skos:note>
    <skos:note>TG2 Amendment OTHER CODED Test VOCABULARY Conformance CORE</skos:note>
    <skos:prefLabel>AmendmentMethod: AMENDMENT_SEX_STANDARDIZED with Specification Specification for: AMENDMENT_SEX_STANDARDIZED</skos:prefLabel>
    <bdqffdq:forAmendment rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/33c45ae1-e2db-462a-a59e-7169bb01c5d6-2024-03-25"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:08a4abb0-8977-4805-a4a1-c1a96b532322"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:bf24b955-7497-4d9e-b42e-2706e5bf0d48">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/AmendmentPolicy"/>
    <rdfs:label>AmendmentPolicy: (2) amendments  in UseCase bdquc:Alien-Species</rdfs:label>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Alien-Species"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/33c45ae1-e2db-462a-a59e-7169bb01c5d6-2024-03-25"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:e35dd18a-9c69-4aef-9b70-3d36d7eb6bd4">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Argument"/>
    <rdfs:label>Default value for bdqval:sourceAuthority:"GBIF Sex Vocabulary"</rdfs:label>
    <bdqffdq:hasArgumentValue>GBIF Sex Vocabulary</bdqffdq:hasArgumentValue>
    <bdqffdq:hasParameter rdf:resource="https://rs.tdwg.org/bdqval/terms/sourceAuthority"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:08a4abb0-8977-4805-a4a1-c1a96b532322">
    <dcterms:description>EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; AMENDED the value of dwc:sex if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = "GBIF Sex Vocabulary" [https://api.gbif.org/v1/vocabularies/Sex]} {"dwc:sex vocabulary API" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: AMENDMENT_SEX_STANDARDIZED</rdfs:label>
    <skos:example>dwc:sex="f": Response.status=AMENDED, Response.result=dwc:sex="Female", Response.comment="dwc:sex found in the bdqval:sourceAuthority"</skos:example>
    <skos:example>dwc:sex="x": Response.status=NOT_AMENDED, Response.result="", Response.comment="dwc:sex not found in the bdqval:sourceAuthority"</skos:example>
    <bdqffdq:hasArgument rdf:resource="urn:uuid:e35dd18a-9c69-4aef-9b70-3d36d7eb6bd4"/>
    <bdqffdq:hasAuthoritiesDefaults>bdqval:sourceAuthority default = "GBIF Sex Vocabulary" [https://api.gbif.org/v1/vocabularies/Sex]} {"dwc:sex vocabulary API" [https://api.gbif.org/v1/vocabularies/Sex/concepts]}</bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:sex is bdqval:Empty; AMENDED the value of dwc:sex if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:81029ffa-2df8-4e9e-a7dd-fc67faad9205">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:sex</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:sex</skos:prefLabel>
    <bdqffdq:composedOf rdf:resource="http://rs.tdwg.org/dwc/terms/sex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqdim/terms/Conformance">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/DataQualityDimension"/>
    <rdfs:label>Conformance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.gbif.org/vocabulary/gbif/sex.xml">
    <dcterms:bibliographicCitation>GBIF (2015) Darwin Core Vocabulary: Sex GBIF Vocabulary. https://rs.gbif.org/vocabulary/gbif/sex.xml</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqenh/terms/Standardized">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Enhancement"/>
    <rdfs:label>Standardized</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqval/terms/sourceAuthority">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Parameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqffdq/terms/SingleRecord">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ResourceType"/>
    <rdfs:label>SingleRecord</rdfs:label>
  </rdf:Description>
</rdf:RDF>
