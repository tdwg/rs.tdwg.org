  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/8dfed701-01a9-415d-a9f8-539280b75975-2024-02-08">
    <dcterms:description>Measure if all VALIDATION_ESTABLISHMENTMEANS_STANDARD in a record set are COMPLIANT or INTERNAL_PREREQUISITES_NOT_MET (indicating some empty value).</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/8dfed701-01a9-415d-a9f8-539280b75975"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-08</dcterms:issued>
    <dcterms:references rdf:resource="https://doi.org/10.1371/journal.pone.0178731"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Measure"/>
    <rdfs:label>MULTIRECORD_MEASURE_QA_ESTABLISHMENTMEANS_STANDARD</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/297</skos:historyNote>
    <skos:note>For Quality Assurance, filter record set until this measure is COMPLETE.</skos:note>
    <skos:prefLabel>Measurement over MultiRecord for QualityAssurance of Validation dwc:establishmentMeans Standard for MultiRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:4d7d3e60-8242-48be-ab51-cfd40fe3b8e9"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-02-08</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/MultiRecord"/>
  </rdf:Description>
