  <rdf:Description rdf:about="urn:uuid:e1286c46-2a95-480d-89e4-f02681372eb7">
    <dcterms:description>COMPLIANT if dc:type is bdqval:NotEmpty; otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_DCTYPE_NOTEMPTY</rdfs:label>
    <skos:example>dc:type=" ": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dc:type is bdqval:Empty"</skos:example>
    <skos:example>dc:type="?": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dc:type is bdqval:NotEmpty"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>COMPLIANT if dc:type is bdqval:NotEmpty; otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
