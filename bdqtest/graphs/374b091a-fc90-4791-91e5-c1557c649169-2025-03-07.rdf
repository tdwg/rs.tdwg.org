    <rdfs:label>VALIDATION_DCTYPE_NOTEMPTY</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/103</skos:historyNote>
    <skos:note></skos:note>
    <skos:prefLabel>Validation dc:type Not Empty for SingleRecord</skos:prefLabel>
