<http://rs.gbif.org/vocabulary/gbif/type_status> a dcterms:BibliographicResource ;
    dcterms:bibliographicCitation "GBIF (2021) Darwin Core Vocabulary: Nomenclatural Type Status Vocabulary. http://rs.gbif.org/vocabulary/gbif/type_status" .

bdqdim:Conformance a bdqffdq:DataQualityDimension ;
    rdfs:label "Conformance" .

bdqenh:Standardized a bdqffdq:Enhancement ;
    rdfs:label "Standardized" .

bdqffdq:SingleRecord a bdqffdq:ResourceType ;
    rdfs:label "SingleRecord" .

bdquc:Alien-Species a bdqffdq:UseCase ;
    rdfs:label "bdquc:Alien-Species" .

bdqval:sourceAuthority a bdqffdq:Parameter .

<urn:uuid:401e2562-cb26-43a7-8690-b06eabd5982a> a bdqffdq:Specification ;
    rdfs:label "Specification for: AMENDMENT_TYPESTATUS_STANDARDIZED" ;
    dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:typeStatus is bdqval:Empty; AMENDED the value of the first word in each &#124; delimited portion of dwc:typeStatus if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED. bdqval:sourceAuthority default = \"GBIF TypeStatus Vocabulary\" {[https://api.gbif.org/v1/vocabularies/TypeStatus]} {dwc:typeStatus vocabulary API [https://api.gbif.org/v1/vocabularies/TypeStatus/concepts]}" ;
    skos:example "dwc:typeStatus=\"Holo.\": Response.status=AMENDED, Response.result=dwc:typeStatus=\"Holotype\", Response.comment=\"dwc:typeStatus found in the bdqval:sourceAuthority\"",
        "dwc:typeStatus=\"x\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:typeStatus not found in the bdqval:sourceAuthority\"" ;
    bdqffdq:hasArgument <urn:uuid:a10eb348-7fc5-4b96-88e3-619300cb0079> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"GBIF TypeStatus Vocabulary\" {[https://api.gbif.org/v1/vocabularies/TypeStatus]} {dwc:typeStatus vocabulary API [https://api.gbif.org/v1/vocabularies/TypeStatus/concepts]}" ;
    bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL PREREQUISITES_NOT_MET if dwc:typeStatus is bdqval:Empty; AMENDED the value of the first word in each &#124; delimited portion of dwc:typeStatus if it can be unambiguously matched to a term in the bdqval:sourceAuthority; otherwise NOT_AMENDED." .

<urn:uuid:63b75539-9290-4ce4-86e3-938bc924e3cd> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:typeStatus" ;
    skos:prefLabel "Information Element ActedUpon dwc:typeStatus" ;
    bdqffdq:composedOf dwc:typeStatus .

<urn:uuid:a10eb348-7fc5-4b96-88e3-619300cb0079> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:sourceAuthority:\"GBIF TypeStatus Vocabulary\"" ;
    bdqffdq:hasArgumentValue "GBIF TypeStatus Vocabulary" ;
    bdqffdq:hasParameter bdqval:sourceAuthority .

<https://rs.tdwg.org/bdqtest/terms/version/b3471c65-b53e-453b-8282-abfa27bf1805-2024-11-11> a bdqffdq:Amendment ;
    rdfs:label "AMENDMENT_TYPESTATUS_STANDARDIZED" ;
    dcterms:description "Proposes an amendment to the value of dwc:typeStatus using the bdqval:sourceAuthority." ;
    dcterms:isVersionOf bdqtest:b3471c65-b53e-453b-8282-abfa27bf1805 ;
    dcterms:issued "2024-11-11"^^xsd:date ;
    dcterms:references <http://rs.gbif.org/vocabulary/gbif/type_status> ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/286" ;
    skos:note "Valuable for data quality needs related to voucher specimens in natural science collections. Almost all occurrence data will have no value in dwc:typeStatus. For reference, a vocabulary of synonyms can be found for dwc:typeStatus at [https://registry.gbif.org/vocabulary/TypeStatus/concepts]." ;
    skos:prefLabel "Amendment dwc:typeStatus Standardized for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:63b75539-9290-4ce4-86e3-938bc924e3cd> ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-11-11"^^xsd:date ;
    bdqffdq:hasEnhancement bdqenh:Standardized ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

