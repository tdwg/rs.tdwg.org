  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/3c8bc478-f6b2-4533-b7ce-45bae5d186c2-2025-03-07">
    <dcterms:description>Measure if all VALIDATION_DECIMALLATITUDE_INRANGE in a record set are COMPLIANT.</dcterms:description>
