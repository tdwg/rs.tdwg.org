  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/6a3baf78-5ec3-4a84-8c6b-6876b3a4e3b5-2023-09-18">
    <dcterms:description>Count the number of VALIDATION_MAXELEVATION_INRANGE in a record set that are COMPLIANT.</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/6a3baf78-5ec3-4a84-8c6b-6876b3a4e3b5"/>
