    "http://purl.org/dc/terms/description": [
      {
        "@value": "COMPLIANT if dwc:occurrenceStatus is bdqval:NotEmpty; otherwise NOT_COMPLIANT"
      }
    ],
    "http://purl.org/dc/terms/hasVersion": [
