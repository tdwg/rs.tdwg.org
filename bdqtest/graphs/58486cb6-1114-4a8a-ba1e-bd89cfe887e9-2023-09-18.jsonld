    "http://purl.org/dc/terms/description": [
      {
        "@value": "COMPLIANT if at least one term needed to determine the location of the entity exists and is bdqval:NotEmpty; otherwise NOT_COMPLIANT"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Specification for: VALIDATION_LOCATION_NOTEMPTY"
      }
    ],
