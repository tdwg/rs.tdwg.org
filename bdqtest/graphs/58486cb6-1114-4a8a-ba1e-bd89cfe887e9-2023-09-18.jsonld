        "@value": "dwc:locationID=\"https://opencontext.org/subjects/e54377f7-4452-4315-b676-40679b10c4d9\", dwc:higherGeographyID=\"\", dwc:higherGeography=\"\",dwc:continent=\"\", dwc:waterBody=\"\", dwc:islandGroup=\"\", dwc:island=\"\", dwc:country=\"\", dwc:countryCode=\"\", dwc:stateProvince=\"\", dwc:county=\"\", dwc:municipality=\"\", dwc:locality=\"\", dwc:verbatimLocality=\"\", dwc:decimalLatitude=\"\", dwc:decimalLongitude=\"\", dwc:coordinateUncertaintyInMeters=\"\", dwc:geodeticDatum=\"\", dwc:verbatimCoordinates=\"\", dwc:verbatimLatitude=\"\", dwc:verbatimLongitude=\"\", dwc:footprintWKT=\"\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:LocationID is bdqval:NotEmpty\""
      }
