  <rdf:Description rdf:about="urn:uuid:dbb803cb-8b37-4db3-a562-b4f6036f9d17">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_TAXONRANK_NOTEMPTY with Specification for: VALIDATION_TAXONRANK_NOTEMPTY</rdfs:label>
    <skos:historyNote>Source: TDWG2018</skos:historyNote>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/sci_name_qc/blob/v1.1.2/src/main/java/org/filteredpush/qc/sciname/DwCSciNameDQ.java#L2127</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush sci_name_qc Library (Morris &amp; Dou 2025)</skos:note>
    <skos:note>TG2 Validation NAME CODED Test Completeness CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_TAXONRANK_NOTEMPTY with Specification for: VALIDATION_TAXONRANK_NOTEMPTY</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/14da5b87-8304-4b2b-911d-117e3c29e890-2023-09-18"/>
