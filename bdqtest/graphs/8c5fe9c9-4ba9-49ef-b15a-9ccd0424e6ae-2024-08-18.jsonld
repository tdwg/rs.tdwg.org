      },
      {
        "@id": "https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2"
      },
      {
        "@id": "https://github.com/nvkelso/natural-earth-vector/releases/tag/v5.1.2"
      },
      {
        "@id": "https://technicalgeography.org/pdf/sp_i_2010/12_introducing_natural_earth_data__naturaleart.pdf"
      },
