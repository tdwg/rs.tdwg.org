    rdfs:label "bdquc:Spatial-Temporal_Patterns" .

bdqval:earliestValidDate a bdqffdq:Parameter .

bdqval:latestValidDate a bdqffdq:Parameter .

<urn:uuid:9167035f-14a8-4a0f-81eb-86a5a93bf6d9> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:earliestValidDate:\"1582\"" ;
    bdqffdq:hasArgumentValue "1582" ;
    bdqffdq:hasParameter bdqval:earliestValidDate .

<urn:uuid:aee43366-0352-448a-a5ea-85ddc8605da1> a bdqffdq:Specification ;
    rdfs:label "Specification for: VALIDATION_YEAR_INRANGE" ;
    dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:year is bdqval:Empty or cannot be interpreted as an integer; COMPLIANT if the value of dwc:year is within the range bdqval:earliestValidDate to bdqval:latestValidDate inclusive; otherwise NOT_COMPLIANT bdqval:earliestValidDate default = \"1582\",bdqval:latestValidDate default = \"{current year}\"" ;
    skos:example "dwc:year=\"1952\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:year is in RANGE\"",
        "dwc:year=\"9999\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:year is not in RANGE. The value in year has not yet come to pass.\"" ;
    bdqffdq:hasArgument <urn:uuid:9167035f-14a8-4a0f-81eb-86a5a93bf6d9>,
        <urn:uuid:fa6e83af-40c3-4330-aca0-937fc22b3a27> ;
    bdqffdq:hasAuthoritiesDefaults "bdqval:earliestValidDate default = \"1582\",bdqval:latestValidDate default = \"{current year}\"" ;
    bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:year is bdqval:Empty or cannot be interpreted as an integer; COMPLIANT if the value of dwc:year is within the range bdqval:earliestValidDate to bdqval:latestValidDate inclusive; otherwise NOT_COMPLIANT" .

<urn:uuid:fa6e83af-40c3-4330-aca0-937fc22b3a27> a bdqffdq:Argument ;
    rdfs:label "Default value for bdqval:latestValidDate:\"{current year}\"" ;
    bdqffdq:hasArgumentValue "{current year}" ;
    bdqffdq:hasParameter bdqval:latestValidDate .

<urn:uuid:fb8a2da5-dbda-43e7-9116-3fcaede12985> a bdqffdq:ActedUpon ;
    rdfs:label "Information Element ActedUpon dwc:year" ;
    skos:prefLabel "Information Element ActedUpon dwc:year" ;
    bdqffdq:composedOf dwc:year .

<https://rs.tdwg.org/bdqtest/terms/version/ad0c8855-de69-4843-a80c-a5387d20fbc8-2024-08-23> a bdqffdq:Validation ;
    rdfs:label "VALIDATION_YEAR_INRANGE" ;
    dcterms:description "Is the value of dwc:year within the Parameter range?" ;
    dcterms:isVersionOf bdqtest:ad0c8855-de69-4843-a80c-a5387d20fbc8 ;
    dcterms:issued "2024-08-23"^^xsd:date ;
    skos:historyNote "https://github.com/tdwg/bdq/issues/84" ;
    skos:note "The results of this Test are time-dependent. Next year is not valid now. Next year it will be. This Test provides the option to designate lower and upper limits to the year. The upper limit, if not provided, should default to the year when the Test is run. This Test provides for a default earliest date (year), of 1582 by convention. That value was chosen because ISO 8601-1 asserts that \"the use of proleptic Gregorian calendar dates prior are not allowed in ISO 8601-1 without prior agreement of the parties exchanging data\", and Darwin Core provides no such prior agreement." ;
    skos:prefLabel "Validation dwc:year In Range for SingleRecord" ;
    bdqffdq:hasActedUponInformationElement <urn:uuid:fb8a2da5-dbda-43e7-9116-3fcaede12985> ;
    bdqffdq:hasCriterion bdqcrit:InRange ;
    bdqffdq:hasDataQualityDimension bdqdim:Conformance ;
    bdqffdq:hasDateLastUpdated "2024-08-23"^^xsd:date ;
    bdqffdq:hasResourceType bdqffdq:SingleRecord .

