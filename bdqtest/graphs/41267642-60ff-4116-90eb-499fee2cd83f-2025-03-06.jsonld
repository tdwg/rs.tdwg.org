        "@value": "dwc:day=\"\", dwc:month=\"\", dwc:year=\"\", dwc:eventDate=\"1962-11-01T10:00-0600\", dwc:verbatimEventDate=\"\", dwc:startDayOfYear=\"\", dwc:endDayOfYear=\"\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:eventDate is bdqval:NotEmpty\""
