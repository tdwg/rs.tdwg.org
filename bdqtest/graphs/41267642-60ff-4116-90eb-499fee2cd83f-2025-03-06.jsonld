    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "VALIDATION_EVENTTEMPORAL_NOTEMPTY"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@value": "https://github.com/tdwg/bdq/issues/88"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@value": "Only fails if all of the relevant fields of the Darwin Core Event class are bdqval:Empty or do not exist. Relevant Darwin Core fields include dwc:eventDate, dwc:verbatimEventDate, dwc:year, dwc:month, dwc:day, dwc:startDayOfYear, dwc:endDayOfYear. The terms dwc:eventID (if populated may or may not point to temporal information accessible to the user of the data) and dwc:eventTime (which is rare) are not included."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Validation dwc:Event Temporal Not Empty for SingleRecord"
      }
