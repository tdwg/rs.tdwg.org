    "http://purl.org/dc/terms/description": [
      {
        "@value": "Is there a value in any of the terms dwc:eventDate, dwc:year, dwc:month, dwc:day, dwc:startDayOfYear, dwc:endDayOfYear, dwc:verbatimEventDate?"
      }
    ],
    "http://purl.org/dc/terms/isVersionOf": [
