  <rdf:Description rdf:about="https://rs.tdwg.org/bdqffdq/terms/SingleRecord">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ResourceType"/>
    <rdfs:label>SingleRecord</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:e4f1fc86-c84d-4e92-9cf2-5250f243b371">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ActedUpon"/>
    <rdfs:label>Information Element ActedUpon dwc:dateIdentified</rdfs:label>
    <skos:prefLabel>Information Element ActedUpon dwc:dateIdentified</skos:prefLabel>
