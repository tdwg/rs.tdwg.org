<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bdqffdq="https://rs.tdwg.org/bdqffdq/terms/"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqtest/terms/version/66269bdd-9271-4e76-b25c-7ab81eebe1d8-2024-09-16">
    <dcterms:description>Is the value of dwc:dateIdentified a valid ISO date?</dcterms:description>
    <dcterms:isVersionOf rdf:resource="https://rs.tdwg.org/bdqtest/terms/66269bdd-9271-4e76-b25c-7ab81eebe1d8"/>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-16</dcterms:issued>
    <dcterms:references rdf:resource="https://en.wikipedia.org/wiki/ISO_8601"/>
    <dcterms:references rdf:resource="https://www.iso.org/obp/ui/"/>
    <dcterms:references rdf:resource="https://www.loc.gov/standards/datetime/"/>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Validation"/>
    <rdfs:label>VALIDATION_DATEIDENTIFIED_STANDARD</rdfs:label>
    <skos:historyNote>https://github.com/tdwg/bdq/issues/69</skos:historyNote>
    <skos:note></skos:note>
    <skos:prefLabel>Validation dwc:dateIdentified Standard for SingleRecord</skos:prefLabel>
    <bdqffdq:hasActedUponInformationElement rdf:resource="urn:uuid:e4f1fc86-c84d-4e92-9cf2-5250f243b371"/>
    <bdqffdq:hasCriterion rdf:resource="https://rs.tdwg.org/bdqcrit/terms/Standard"/>
    <bdqffdq:hasDataQualityDimension rdf:resource="https://rs.tdwg.org/bdqdim/terms/Conformance"/>
    <bdqffdq:hasDateLastUpdated rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-09-16</bdqffdq:hasDateLastUpdated>
    <bdqffdq:hasResourceType rdf:resource="https://rs.tdwg.org/bdqffdq/terms/SingleRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqcrit/terms/Standard">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Criterion"/>
    <rdfs:label>Standard</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:89f8b2ea-fc35-4941-929a-0e32cfbeb1a6">
    <dcterms:description>INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; COMPLIANT if the value of dwc:dateIdentified contains a valid ISO 8601 date; otherwise NOT_COMPLIANT</dcterms:description>
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/Specification"/>
    <rdfs:label>Specification for: VALIDATION_DATEIDENTIFIED_STANDARD</rdfs:label>
    <skos:example>dwc:dateIdentified="1963-03-08T14:07": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment="dwc:dateIdentified is a valid ISO 8601-1:2019 date"</skos:example>
    <skos:example>dwc:dateIdentified="1963-03-08X14:07-0600": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment="dwc:dateIdentified is not a valid ISO 8601-1:2019 date"</skos:example>
    <bdqffdq:hasAuthoritiesDefaults></bdqffdq:hasAuthoritiesDefaults>
    <bdqffdq:hasExpectedResponse>INTERNAL_PREREQUISITES_NOT_MET if dwc:dateIdentified is bdqval:Empty; COMPLIANT if the value of dwc:dateIdentified contains a valid ISO 8601 date; otherwise NOT_COMPLIANT</bdqffdq:hasExpectedResponse>
  </rdf:Description>
  <rdf:Description rdf:about="https://rs.tdwg.org/bdqdim/terms/Conformance">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/DataQualityDimension"/>
    <rdfs:label>Conformance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.iso.org/obp/ui/">
    <dcterms:bibliographicCitation>ISO (2019) ISO 8601-1:2019(en) Date and time — Representations for information interchange — Part 1: Basic rules. https://www.iso.org/obp/ui/</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:4c6a5522-ae8c-42d3-a396-8fc3aee49ef9">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationMethod"/>
    <rdfs:label>ValidationMethod: VALIDATION_DATEIDENTIFIED_STANDARD with Specification for: VALIDATION_DATEIDENTIFIED_STANDARD</rdfs:label>
    <skos:note>Example Implementations Source Code: https://github.com/FilteredPush/event_date_qc/blob/v3.0.5/src/main/java/org/filteredpush/qc/date/DwCOtherDateDQ.java#L61</skos:note>
    <skos:note>Example Implementations: Kurator/FilteredPush event_date_qc Library (Morris &amp; Lowery 2025)</skos:note>
    <skos:note>TG2 Validation TIME CODED Test Conformance ISO/DCMI STANDARD CORE</skos:note>
    <skos:prefLabel>ValidationMethod: VALIDATION_DATEIDENTIFIED_STANDARD with Specification for: VALIDATION_DATEIDENTIFIED_STANDARD</skos:prefLabel>
    <bdqffdq:forValidation rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/66269bdd-9271-4e76-b25c-7ab81eebe1d8-2024-09-16"/>
    <bdqffdq:hasSpecification rdf:resource="urn:uuid:89f8b2ea-fc35-4941-929a-0e32cfbeb1a6"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:uuid:0348eccf-fc7f-49b3-88b6-1d911e98cbbb">
    <rdf:type rdf:resource="https://rs.tdwg.org/bdqffdq/terms/ValidationPolicy"/>
    <rdfs:label>ValidationPolicy: (43) validations  in UseCase bdquc:Spatial-Temporal_Patterns</rdfs:label>
    <skos:prefLabel>ValidationPolicy: (43) validations  in UseCase bdquc:Spatial-Temporal_Patterns</skos:prefLabel>
    <bdqffdq:hasUseCase rdf:resource="https://rs.tdwg.org/bdquc/terms/Spatial-Temporal_Patterns"/>
    <bdqffdq:includedInPolicy rdf:resource="https://rs.tdwg.org/bdqtest/terms/version/66269bdd-9271-4e76-b25c-7ab81eebe1d8-2024-09-16"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://en.wikipedia.org/wiki/ISO_8601">
    <dcterms:bibliographicCitation>Wikipedia (2020) ISO 8601. https://en.wikipedia.org/wiki/ISO_8601</dcterms:bibliographicCitation>
    <rdf:type rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.loc.gov/standards/datetime/">
