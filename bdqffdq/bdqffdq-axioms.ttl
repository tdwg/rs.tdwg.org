@prefix bdqffdq: <https://rs.tdwg.org/bdqffdq/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://rs.tdwg.org/bdqffdq/extension/> a owl:Ontology ;
    rdfs:label "Fitness For Use Framework Ontology Vocabulary Extension"@en ;
    owl:versionIRI <https://rs.tdwg.org/bdqffdq/version/extension/2026-11-09> .

bdqffdq:AmendmentMethod rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Amendment ;
            owl:onProperty bdqffdq:forAmendment ] .

bdqffdq:DataQualityMethod rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Specification ;
            owl:onProperty bdqffdq:hasSpecification ] .

bdqffdq:DataQualityNeed rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:DataQualityDimension ;
            owl:onProperty bdqffdq:hasDataQualityDimension ] .

bdqffdq:Implementation rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Mechanism ;
            owl:onProperty bdqffdq:implementedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Specification ;
            owl:onProperty bdqffdq:usesSpecification ] .

bdqffdq:IssueMethod rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Issue ;
            owl:onProperty bdqffdq:forIssue ] .

bdqffdq:MeasurementMethod rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Measure ;
            owl:onProperty bdqffdq:forMeasure ] .

bdqffdq:Policy rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:UseCase ;
            owl:onProperty bdqffdq:hasUseCase ] .

bdqffdq:ValidationMethod rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Validation ;
            owl:onProperty bdqffdq:forValidation ] .

bdqffdq:ImprovementTarget rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Validation ;
            owl:onProperty bdqffdq:targetedValidation ],
        [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Issue ;
            owl:onProperty bdqffdq:targetedIssue ],
        [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Measure ;
            owl:onProperty bdqffdq:targetedMeasure ] .

bdqffdq:Amendment rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:ImprovementTarget ;
            owl:onProperty bdqffdq:improvedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Enhancement ;
            owl:onProperty bdqffdq:hasEnhancement ] .

bdqffdq:Issue rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Criterion ;
            owl:onProperty bdqffdq:hasCriterion ] .

bdqffdq:Validation rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom bdqffdq:Criterion ;
            owl:onProperty bdqffdq:hasCriterion ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( bdqffdq:COMPLETE bdqffdq:COMPLIANT bdqffdq:IS_ISSUE bdqffdq:NOT_COMPLETE bdqffdq:NOT_COMPLIANT bdqffdq:NOT_ISSUE bdqffdq:POTENTIAL_ISSUE ) .

[] a owl:AllDisjointClasses ;
    owl:members ( bdqffdq:Amendment bdqffdq:Issue bdqffdq:Measure bdqffdq:Validation ) .

[] a owl:AllDisjointClasses ;
    owl:members ( bdqffdq:AbstractInformationElement bdqffdq:ActedUpon bdqffdq:Consulted ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( bdqffdq:AMENDED bdqffdq:EXTERNAL_PREREQUISITES_NOT_MET bdqffdq:FILLED_IN bdqffdq:INTERNAL_PREREQUISITES_NOT_MET bdqffdq:NOT_AMENDED bdqffdq:RUN_HAS_RESULT ) .

