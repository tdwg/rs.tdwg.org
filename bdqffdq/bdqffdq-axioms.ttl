@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://rs.tdwg.org/bdqffdq/extension/> a owl:Ontology ;
    rdfs:label "Fitness For Use Framework Ontology Vocabulary Extension"@en ;
    owl:versionIRI <https://rs.tdwg.org/bdqffdq/version/extension/2026-11-09> .

<https://rs.tdwg.org/bdqffdq/terms/AmendmentMethod> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Amendment> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/forAmendment> ] .

<https://rs.tdwg.org/bdqffdq/terms/DataQualityMethod> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Specification> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasSpecification> ] .

<https://rs.tdwg.org/bdqffdq/terms/DataQualityNeed> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/DataQualityDimension> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasDataQualityDimension> ] .

<https://rs.tdwg.org/bdqffdq/terms/Implementation> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Mechanism> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/implementedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Specification> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/usesSpecification> ] .

<https://rs.tdwg.org/bdqffdq/terms/IssueMethod> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Issue> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/forIssue> ] .

<https://rs.tdwg.org/bdqffdq/terms/MeasurementMethod> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Measure> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/forMeasure> ] .

<https://rs.tdwg.org/bdqffdq/terms/Policy> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/UseCase> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasUseCase> ] .

<https://rs.tdwg.org/bdqffdq/terms/ValidationMethod> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Validation> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/forValidation> ] .

<https://rs.tdwg.org/bdqffdq/terms/ImprovementTarget> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Validation> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/targetedValidation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Issue> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/targetedIssue> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Measure> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/targetedMeasure> ] .

<https://rs.tdwg.org/bdqffdq/terms/Amendment> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/ImprovementTarget> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/improvedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Enhancement> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasEnhancement> ] .

<https://rs.tdwg.org/bdqffdq/terms/Issue> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Criterion> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasCriterion> ] .

<https://rs.tdwg.org/bdqffdq/terms/Validation> rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://rs.tdwg.org/bdqffdq/terms/Criterion> ;
            owl:onProperty <https://rs.tdwg.org/bdqffdq/terms/hasCriterion> ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( <https://rs.tdwg.org/bdqffdq/terms/COMPLETE> <https://rs.tdwg.org/bdqffdq/terms/COMPLIANT> <https://rs.tdwg.org/bdqffdq/terms/IS_ISSUE> <https://rs.tdwg.org/bdqffdq/terms/NOT_COMPLETE> <https://rs.tdwg.org/bdqffdq/terms/NOT_COMPLIANT> <https://rs.tdwg.org/bdqffdq/terms/NOT_ISSUE> <https://rs.tdwg.org/bdqffdq/terms/POTENTIAL_ISSUE> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://rs.tdwg.org/bdqffdq/terms/Amendment> <https://rs.tdwg.org/bdqffdq/terms/Issue> <https://rs.tdwg.org/bdqffdq/terms/Measure> <https://rs.tdwg.org/bdqffdq/terms/Validation> ) .

[] a owl:AllDisjointClasses ;
    owl:members ( <https://rs.tdwg.org/bdqffdq/terms/AbstractInformationElement> <https://rs.tdwg.org/bdqffdq/terms/ActedUpon> <https://rs.tdwg.org/bdqffdq/terms/Consulted> ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( <https://rs.tdwg.org/bdqffdq/terms/AMENDED> <https://rs.tdwg.org/bdqffdq/terms/EXTERNAL_PREREQUISITES_NOT_MET> <https://rs.tdwg.org/bdqffdq/terms/FILLED_IN> <https://rs.tdwg.org/bdqffdq/terms/INTERNAL_PREREQUISITES_NOT_MET> <https://rs.tdwg.org/bdqffdq/terms/NOT_AMENDED> <https://rs.tdwg.org/bdqffdq/terms/RUN_HAS_RESULT> ) .

